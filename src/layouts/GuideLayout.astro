---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/ui/AdSlot.astro';
import AuthorCard from '../components/ui/AuthorCard.astro';
import { getAuthor } from '../data/authors';

interface FAQ {
  q: string;
  a: string;
}

interface Breadcrumb {
  label: string;
  href?: string;
}

interface HowToStep { name: string; text: string; }

interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string;
  canonicalUrl?: string;
  faqs?: FAQ[];
  breadcrumbs?: Breadcrumb[];
  calculatorHref: string;
  calculatorLabel: string;
  related: { href: string; label: string }[];
  howToSteps?: HowToStep[];
  howToTotalTime?: string;
  authorSlug?: string;
  publishDate?: string;
}

const {
  title, description, h1, intro, canonicalUrl,
  faqs = [], breadcrumbs = [], calculatorHref, calculatorLabel, related,
  howToSteps, howToTotalTime, authorSlug, publishDate,
} = Astro.props;

const author = getAuthor(authorSlug ?? 'editorial');

const site = 'https://www.homematerialcalc.com';
const canonical = canonicalUrl ?? site + Astro.url.pathname;

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumbItems = [
  { '@type': 'ListItem', name: 'Home', item: site + '/' },
  ...breadcrumbs.map((b, i) => {
    const itemUrl = b.href ? site + b.href : (i === breadcrumbs.length - 1 ? canonical : null);
    return itemUrl ? { '@type': 'ListItem', name: b.label, item: itemUrl } : null;
  }).filter(Boolean),
].map((entry, idx) => ({ ...entry, position: idx + 1 }));

const breadcrumbSchema = breadcrumbItems.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
} : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  url: canonical,
  ...(publishDate ? { datePublished: publishDate, dateModified: publishDate } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'HomeMaterialCalc',
    url: site,
    logo: { '@type': 'ImageObject', url: `${site}/og-default.png` },
  },
  author: {
    '@type': 'Person',
    name: author.name,
    jobTitle: author.title,
    description: author.bio,
    email: author.email,
    url: `${site}/author/${author.slug}/`,
    knowsAbout: author.expertise,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};

const howToSchema = howToSteps && howToSteps.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: h1,
  description,
  url: canonical,
  ...(howToTotalTime ? { totalTime: howToTotalTime } : {}),
  step: howToSteps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
  })),
} : null;
---

<BaseLayout {title} {description} {canonicalUrl} ogType="article" articlePublishedTime={publishDate} articleModifiedTime={publishDate}>
  <!-- Schema.org injected via Fragment; BaseLayout renders <slot /> in <head> area separately -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {howToSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <!-- Breadcrumbs -->
    {breadcrumbs.length > 0 && (
      <nav class="text-sm text-gray-500 mb-4 flex flex-wrap gap-1">
        <a href="/" class="hover:text-brand-600">Home</a>
        {breadcrumbs.map((b, i) => (
          <>
            <span>›</span>
            {b.href
              ? <a href={b.href} class="hover:text-brand-600">{b.label}</a>
              : <span class="text-gray-700">{b.label}</span>
            }
          </>
        ))}
      </nav>
    )}

    <div class="grid lg:grid-cols-[1fr_320px] gap-10">
      <!-- Main content -->
      <article>
        <div class="flex items-start justify-between gap-4 mb-3">
          <h1 class="text-3xl font-bold text-gray-900">{h1}</h1>
          <button
            onclick="window.print()"
            class="no-print flex-shrink-0 flex items-center gap-1.5 text-sm text-gray-500 border border-gray-200 rounded-lg px-3 py-1.5 hover:border-gray-400 hover:text-gray-700 transition-colors mt-1"
            title="Print or save as PDF"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print / PDF
          </button>
        </div>
        <p class="text-lg text-gray-600 mb-4">{intro}</p>

        <AuthorCard {author} {publishDate} />

        <!-- Calculator CTA -->
        <a href={calculatorHref}
          class="flex items-center gap-3 bg-brand-50 border border-brand-200 rounded-xl p-4 mb-8 hover:bg-brand-100 transition-colors group">
          <span class="text-2xl">🧮</span>
          <div>
            <p class="font-semibold text-brand-700 group-hover:text-brand-800">{calculatorLabel}</p>
            <p class="text-sm text-gray-600">Enter your exact dimensions for a personalized estimate →</p>
          </div>
        </a>

        <AdSlot slot="header-banner" />

        <!-- Table of Contents (built client-side from H2s in .prose) -->
        <nav id="toc" class="hidden bg-gray-50 border border-gray-200 rounded-xl p-4 mb-8 no-print" aria-label="Table of contents">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">In this guide</p>
          <ol id="toc-list" class="space-y-1"></ol>
        </nav>

        <!-- Page body -->
        <div id="guide-body" class="prose prose-gray max-w-none">
          <slot />
        </div>

        <AdSlot slot="in-content" className="my-8" />

        <!-- FAQ section -->
        {faqs.length > 0 && (
          <div class="mt-8">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {faqs.map(f => (
                <div class="border border-gray-200 rounded-lg p-4">
                  <h3 class="font-semibold text-gray-900 mb-1">{f.q}</h3>
                  <p class="text-sm text-gray-700">{f.a}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <AdSlot slot="footer-banner" className="mt-8" />

        <!-- Lead gen: get a local quote -->
        <div class="mt-8 bg-brand-50 border border-brand-200 rounded-xl p-5 no-print">
          <h3 class="font-semibold text-brand-800 mb-1">Get a free local quote</h3>
          <p class="text-sm text-brand-700 mb-4">Know your material quantities? Get a free quote from a local contractor for your project.</p>
          <form id="quote-form" class="space-y-3">
            <input type="hidden" name="page" value={Astro.url.pathname} />
            <input type="text" name="name" placeholder="Your name" required
              class="w-full border border-brand-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-400" />
            <input type="email" name="email" placeholder="Email address" required
              class="w-full border border-brand-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-400" />
            <input type="text" name="zip" placeholder="ZIP code" required
              class="w-full border border-brand-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-400" />
            <textarea name="project" placeholder="Describe your project (optional)" rows="2"
              class="w-full border border-brand-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-400"></textarea>
            <button type="submit" id="quote-btn"
              class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm py-2.5 rounded-lg transition-colors">
              Request Free Quote →
            </button>
          </form>
          <p id="quote-success" class="hidden text-sm text-green-700 font-medium mt-2">✅ Sent! We'll be in touch soon.</p>
          <p class="text-xs text-brand-600 mt-2">No spam · We connect you with 1–3 local pros</p>
          <script>
            document.getElementById('quote-form')?.addEventListener('submit', async (e) => {
              e.preventDefault();
              const form = e.target as HTMLFormElement;
              const btn = document.getElementById('quote-btn') as HTMLButtonElement;
              btn.disabled = true; btn.textContent = 'Sending…';
              const fd = new FormData(form);
              const data = { type: 'quote', name: fd.get('name'), email: fd.get('email'), zip: fd.get('zip'), project: fd.get('project'), page: fd.get('page') };
              await fetch('/api/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
              form.classList.add('hidden');
              document.getElementById('quote-success')?.classList.remove('hidden');
            });
          </script>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="calculator-card sticky top-24">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (
              <li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Cubic yard infographic -->
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3 text-sm">What is 1 cubic yard?</h3>
          <div class="flex justify-center my-2">
            <svg width="120" height="100" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="1 cubic yard = 3ft × 3ft × 3ft cube">
              <!-- Isometric cube -->
              <polygon points="60,10 110,35 110,80 60,55" fill="#dbeafe" stroke="#3b82f6" stroke-width="1.5"/>
              <polygon points="10,35 60,10 60,55 10,80" fill="#bfdbfe" stroke="#3b82f6" stroke-width="1.5"/>
              <polygon points="10,80 60,55 110,80 60,105" fill="#93c5fd" stroke="#3b82f6" stroke-width="1.5"/>
              <text x="60" y="38" text-anchor="middle" font-size="9" fill="#1d4ed8" font-weight="bold">3 ft</text>
              <text x="28" y="58" text-anchor="middle" font-size="9" fill="#1d4ed8">3 ft</text>
              <text x="88" y="58" text-anchor="middle" font-size="9" fill="#1d4ed8">3 ft</text>
            </svg>
          </div>
          <div class="text-xs text-gray-600 space-y-1 mt-1">
            <p>= <strong>27 cubic feet</strong></p>
            <p>= <strong>13.5 bags</strong> of 2 cu ft mulch</p>
            <p>= <strong>1.4 tons</strong> of crushed stone</p>
            <p>= <strong>54 bags</strong> of 50 lb sand</p>
          </div>
          <a href="/guide/what-is-a-cubic-yard" class="text-xs text-brand-600 hover:underline mt-2 block">Full guide: What is a cubic yard? →</a>
        </div>

        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
(function () {
  const body = document.getElementById('guide-body');
  const toc = document.getElementById('toc');
  const list = document.getElementById('toc-list');
  if (!body || !toc || !list) return;

  const h2s = Array.from(body.querySelectorAll('h2'));
  if (h2s.length < 3) return; // skip TOC for short pages

  h2s.forEach((el, i) => {
    if (!el.id) {
      el.id = el.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') ?? `section-${i}`;
    }
    const li = document.createElement('li');
    li.className = 'flex gap-2 text-sm';
    li.innerHTML = `<span class="text-gray-400 font-mono text-xs mt-0.5 flex-shrink-0">${String(i + 1).padStart(2, '0')}</span><a href="#${el.id}" class="text-brand-600 hover:underline leading-snug">${el.textContent}</a>`;
    list.appendChild(li);
  });

  toc.classList.remove('hidden');
})();
</script>
