---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const { title, description, canonicalUrl, ogImage } = Astro.props;
const siteUrl = 'https://www.homematerialcalc.com';
const canonical = canonicalUrl ?? siteUrl + Astro.url.pathname;
const ogImageUrl = ogImage ?? `${siteUrl}/og-default.svg`;
const isHome = Astro.url.pathname === '/';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'HomeMaterialCalc',
  url: siteUrl,
  logo: `${siteUrl}/og-default.png`,
  description: 'Free material calculators and guides for US homeowners and DIYers.',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', url: `${siteUrl}/contact` },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="HomeMaterialCalc" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Search Console verification — replace XXXX with your token -->
    <!-- <meta name="google-site-verification" content="REPLACE_WITH_SEARCH_CONSOLE_TOKEN" /> -->

    <!-- Organization schema (homepage only) -->
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <slot name="head" />

    <!-- Google tag (gtag.js) — consent-aware -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-77PP8J7B4H"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Default consent state — analytics/ads blocked until user accepts
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      gtag('js', new Date());
      gtag('config', 'G-77PP8J7B4H');
    </script>

    <!-- ============================================================
         ADSENSE: AdSense onayından sonra kodu buraya yapıştır.
         Örnek:
         <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
         ============================================================ -->
    <!-- ADSENSE_SCRIPT_PLACEHOLDER -->

    <!-- ============================================================
         GOOGLE CONSENT MANAGEMENT (AdSense onayından sonra)
         Funding Choices / Google CMP script buraya gelir.
         ============================================================ -->
    <!-- CONSENT_MANAGEMENT_PLACEHOLDER -->

  </head>
  <body class="min-h-screen flex flex-col">

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-gray-900 text-white border-t border-gray-700 px-4 py-4">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <p class="text-sm text-gray-300 flex-1">
          We use cookies to analyse site traffic and (after approval) show relevant ads.
          See our <a href="/cookie-policy" class="underline hover:text-white">Cookie Policy</a>.
        </p>
        <div class="flex gap-2 flex-shrink-0">
          <button id="cookie-reject" class="px-4 py-2 text-sm rounded-lg border border-gray-600 text-gray-300 hover:border-gray-400 transition-colors">
            Reject non-essential
          </button>
          <button id="cookie-accept" class="px-4 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700 transition-colors font-medium">
            Accept all
          </button>
        </div>
      </div>
    </div>
    <script>
      (function() {
        const STORAGE_KEY = 'hmc_consent';
        const banner = document.getElementById('cookie-banner');
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) { banner && banner.classList.remove('hidden'); }
        function setConsent(granted) {
          localStorage.setItem(STORAGE_KEY, granted ? 'all' : 'essential');
          banner && banner.classList.add('hidden');
          if (typeof gtag === 'function') {
            gtag('consent', 'update', {
              analytics_storage: granted ? 'granted' : 'denied',
              ad_storage: granted ? 'granted' : 'denied',
              ad_user_data: granted ? 'granted' : 'denied',
              ad_personalization: granted ? 'granted' : 'denied',
            });
          }
        }
        if (saved === 'all') {
          if (typeof gtag === 'function') {
            gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' });
          }
        }
        document.getElementById('cookie-accept')?.addEventListener('click', () => setConsent(true));
        document.getElementById('cookie-reject')?.addEventListener('click', () => setConsent(false));
      })();
    </script>

    <!-- Header -->
    <header class="border-b border-gray-200 bg-white sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-brand-700 text-lg">
          HomeMaterialCalc
        </a>
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-gray-600">
          <!-- Calculators dropdown -->
          <div class="relative group">
            <button class="flex items-center gap-1 px-3 py-2 rounded-lg hover:text-brand-700 hover:bg-gray-50 transition-colors">
              Calculators
              <svg class="w-3.5 h-3.5 opacity-60 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="absolute top-full left-0 mt-1 w-52 bg-white border border-gray-200 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
              <div class="p-2 grid grid-cols-2 gap-0.5">
                {[
                  { href: '/calculator/mulch',     label: 'Mulch' },
                  { href: '/calculator/gravel',    label: 'Gravel' },
                  { href: '/calculator/topsoil',   label: 'Topsoil' },
                  { href: '/calculator/sand',      label: 'Sand' },
                  { href: '/calculator/sod',       label: 'Sod' },
                  { href: '/calculator/concrete',  label: 'Concrete' },
                  { href: '/calculator/paint',     label: 'Paint' },
                  { href: '/calculator/flooring',  label: 'Flooring' },
                  { href: '/calculator/tile',      label: 'Tile' },
                  { href: '/calculator/drywall',   label: 'Drywall' },
                  { href: '/calculator/lumber',    label: 'Lumber' },
                  { href: '/calculator/paver',     label: 'Pavers' },
                ].map(item => (
                  <a href={item.href} class="px-3 py-2 text-sm text-gray-700 rounded-lg hover:bg-brand-50 hover:text-brand-700 transition-colors">
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Guides dropdown -->
          <div class="relative group">
            <button class="flex items-center gap-1 px-3 py-2 rounded-lg hover:text-brand-700 hover:bg-gray-50 transition-colors">
              Guides
              <svg class="w-3.5 h-3.5 opacity-60 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="absolute top-full left-0 mt-1 w-64 bg-white border border-gray-200 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
              <div class="p-2">
                <p class="px-3 py-1 text-xs font-semibold text-gray-400 uppercase tracking-wide">How Much Do I Need?</p>
                {[
                  { href: '/guide/how-much-mulch-do-i-need',    label: 'How Much Mulch?' },
                  { href: '/guide/how-much-gravel-do-i-need',   label: 'How Much Gravel?' },
                  { href: '/guide/how-much-concrete-do-i-need', label: 'How Much Concrete?' },
                  { href: '/guide/how-much-paint-do-i-need',    label: 'How Much Paint?' },
                  { href: '/guide/how-much-lumber-do-i-need',   label: 'How Much Lumber?' },
                ].map(item => (
                  <a href={item.href} class="block px-3 py-2 text-sm text-gray-700 rounded-lg hover:bg-brand-50 hover:text-brand-700 transition-colors">
                    {item.label}
                  </a>
                ))}
                <div class="border-t border-gray-100 my-1.5"></div>
                <p class="px-3 py-1 text-xs font-semibold text-gray-400 uppercase tracking-wide">Reference</p>
                {[
                  { href: '/guide/cubic-yards-to-tons',          label: 'Cubic Yards to Tons' },
                  { href: '/guide/square-feet-to-square-yards',  label: 'Sq Ft to Sq Yards' },
                  { href: '/guide/types-of-mulch',               label: 'Types of Mulch' },
                  { href: '/guide/gravel-vs-crushed-stone',      label: 'Gravel vs Crushed Stone' },
                ].map(item => (
                  <a href={item.href} class="block px-3 py-2 text-sm text-gray-700 rounded-lg hover:bg-brand-50 hover:text-brand-700 transition-colors">
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="/about" class="px-3 py-2 rounded-lg hover:text-brand-700 hover:bg-gray-50 transition-colors">About</a>
        </nav>

        <!-- Mobile menu button placeholder -->
        <button class="md:hidden p-2 rounded-lg text-gray-600" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-50 border-t border-gray-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-12">

        <!-- Newsletter strip -->
        <div class="bg-brand-50 border border-brand-200 rounded-xl px-5 py-4 mb-10 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="flex-1">
            <p class="font-semibold text-brand-800 text-sm">Get new calculators & project tips</p>
            <p class="text-xs text-brand-600 mt-0.5">No spam. Unsubscribe anytime.</p>
          </div>
          <form
            action="https://buttondown.com/api/emails/embed-subscribe/homematerialcalc"
            method="post"
            target="_blank"
            class="flex gap-2 flex-shrink-0"
          >
            <input
              type="email"
              name="email"
              required
              placeholder="your@email.com"
              class="px-3 py-1.5 text-sm border border-brand-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white w-48"
              aria-label="Email address"
            />
            <button type="submit" class="px-4 py-1.5 text-sm font-semibold bg-brand-600 text-white rounded-lg hover:bg-brand-700 transition-colors">
              Subscribe →
            </button>
          </form>
        </div>

        <!-- Category hubs -->
        <div class="flex flex-wrap gap-3 mb-8">
          <a href="/landscaping-calculators" class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:border-brand-400 hover:text-brand-700 transition-colors">🌿 Landscaping Calculators</a>
          <a href="/concrete-calculators"    class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:border-brand-400 hover:text-brand-700 transition-colors">🏗️ Concrete Calculators</a>
          <a href="/interior-calculators"    class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:border-brand-400 hover:text-brand-700 transition-colors">🏠 Interior Calculators</a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">

          <!-- Calculators -->
          <div>
            <p class="font-semibold text-gray-900 mb-3">Calculators</p>
            <ul class="space-y-2 text-gray-600">
              <li><a href="/calculator/mulch"    class="hover:text-brand-700">Mulch</a></li>
              <li><a href="/calculator/gravel"   class="hover:text-brand-700">Gravel</a></li>
              <li><a href="/calculator/topsoil"  class="hover:text-brand-700">Topsoil</a></li>
              <li><a href="/calculator/sand"     class="hover:text-brand-700">Sand</a></li>
              <li><a href="/calculator/sod"      class="hover:text-brand-700">Sod</a></li>
              <li><a href="/calculator/concrete" class="hover:text-brand-700">Concrete</a></li>
              <li><a href="/calculator/paint"    class="hover:text-brand-700">Paint</a></li>
              <li><a href="/calculator/flooring" class="hover:text-brand-700">Flooring</a></li>
              <li><a href="/calculator/tile"     class="hover:text-brand-700">Tile</a></li>
              <li><a href="/calculator/drywall"  class="hover:text-brand-700">Drywall</a></li>
              <li><a href="/calculator/lumber"   class="hover:text-brand-700">Lumber</a></li>
              <li><a href="/calculator/paver"    class="hover:text-brand-700">Pavers</a></li>
            </ul>
          </div>

          <!-- Guides -->
          <div>
            <p class="font-semibold text-gray-900 mb-3">Guides</p>
            <ul class="space-y-2 text-gray-600">
              <li><a href="/guide/how-much-mulch-do-i-need"      class="hover:text-brand-700">How Much Mulch</a></li>
              <li><a href="/guide/how-much-gravel-do-i-need"     class="hover:text-brand-700">How Much Gravel</a></li>
              <li><a href="/guide/how-much-topsoil-do-i-need"    class="hover:text-brand-700">How Much Topsoil</a></li>
