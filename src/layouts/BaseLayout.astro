          <button id="cookie-reject" class="px-4 py-2 text-sm rounded-lg border border-gray-600 text-gray-300 hover:border-gray-400 transition-colors">
            Reject non-essential
          </button>
          <button id="cookie-accept" class="px-4 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700 transition-colors font-medium">
            Accept all
          </button>
        </div>
      </div>
    </div>
    <script>
      (function() {
        const STORAGE_KEY = 'hmc_consent';
        const banner = document.getElementById('cookie-banner');
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) { banner && banner.classList.remove('hidden'); }
        function setConsent(granted) {
          localStorage.setItem(STORAGE_KEY, granted ? 'all' : 'essential');
          banner && banner.classList.add('hidden');
        }
        document.getElementById('cookie-accept')?.addEventListener('click', () => setConsent(true));
        document.getElementById('cookie-reject')?.addEventListener('click', () => setConsent(false));
