            <p class="font-semibold text-gray-900 mt-5 mb-3">Trust &amp; Transparency</p>
            <ul class="space-y-2 text-gray-600">
              <li><a href="/data-sources"            class="hover:text-brand-700">Data Sources</a></li>
              <li><a href="/how-it-works"             class="hover:text-brand-700">How It Works</a></li>
              <li><a href="/calculation-assumptions"  class="hover:text-brand-700">Calculation Assumptions</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-gray-200 text-xs text-gray-500 text-center">
          © {new Date().getFullYear()} HomeMaterialCalc.com — Material estimates for US homeowners & DIYers.
          Results are estimates; confirm quantities with your local supplier.
        </div>
      </div>
    </footer>
  </body>
</html>
