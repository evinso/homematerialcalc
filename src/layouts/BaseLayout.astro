  </head>
  <body class="min-h-screen flex flex-col">

    <!-- Cookie Consent Banner -->
    <div id="cookie-banner" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-gray-900 text-white border-t border-gray-700 px-4 py-4">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
