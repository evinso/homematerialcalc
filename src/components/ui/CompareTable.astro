---
interface Props {
  a: string;
  b: string;
  rows: [string, string, string][];
  verdict: string;
  aHref: string;
  bHref: string;
  guideHref: string;
}
const { a, b, rows, verdict, aHref, bHref, guideHref } = Astro.props;
---

<div class="calculator-card">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr>
          <th class="text-left py-2 px-3 text-gray-500 font-medium w-1/3"></th>
          <th class="py-2 px-3 text-brand-700 font-bold text-center bg-brand-50 rounded-tl-lg">{a}</th>
          <th class="py-2 px-3 text-gray-700 font-bold text-center bg-gray-50 rounded-tr-lg">{b}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(([label, valA, valB], i) => (
          <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}>
            <td class="py-2 px-3 text-gray-500 font-medium">{label}</td>
            <td class="py-2 px-3 text-center text-gray-800">{valA}</td>
            <td class="py-2 px-3 text-center text-gray-800">{valB}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-4 p-4 bg-amber-50 border border-amber-200 rounded-lg">
    <p class="text-sm font-semibold text-amber-800 mb-1">Bottom line</p>
    <p class="text-sm text-amber-700">{verdict}</p>
  </div>

  <div class="mt-4 flex flex-wrap gap-3">
    <a href={aHref} class="text-sm text-brand-600 hover:underline font-medium">{a} Calculator →</a>
    <a href={bHref} class="text-sm text-brand-600 hover:underline font-medium">{b} Calculator →</a>
    <a href={guideHref} class="text-sm text-gray-500 hover:underline">Full comparison guide →</a>
  </div>
</div>
