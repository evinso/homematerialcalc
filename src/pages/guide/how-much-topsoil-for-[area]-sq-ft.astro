---
import GuideLayout from '../../layouts/GuideLayout.astro';

export function getStaticPaths() {
  const areas = [50, 100, 200, 300, 500, 1000, 2000];

  function calc(sqft: number, depthIn: number, waste = 0.10) {
    const cuFt = sqft * depthIn / 12;
    const cuYd = cuFt / 27;
    const cuYdWaste = cuYd * (1 + waste);
    return {
      cuFt: Math.round(cuFt * 10) / 10,
      cuYd: Math.round(cuYd * 100) / 100,
      cuYdWaste: Math.round(cuYdWaste * 100) / 100,
      bags40lb: Math.ceil((cuFt * (1 + waste)) / 0.75),
      bagsCuFt: Math.ceil(cuFt * (1 + waste)),
      tons: Math.round(cuYdWaste * 1.1 * 10) / 10,
    };
  }

  return areas.map(sqft => {
    const depths = [2, 4, 6, 8, 12];
    const rows = depths.map(d => ({ depth: d, ...calc(sqft, d) }));
    const main = calc(sqft, 6);
    const nearby = [Math.round(sqft * 0.5), sqft, Math.round(sqft * 2), Math.round(sqft * 4)]
      .filter((a, i, arr) => a > 0 && arr.indexOf(a) === i)
      .map(a => ({ area: a, d4: calc(a, 4), d6: calc(a, 6), d8: calc(a, 8) }));
    return {
      params: { area: String(sqft) },
      props: { sqft, rows, main, nearby, isBulkBetter: main.cuYdWaste >= 2 },
    };
  });
}

const { sqft, rows, main, nearby, isBulkBetter } = Astro.props as any;

const faqs = [
  {
    q: `How much topsoil do I need for ${sqft} square feet?`,
    a: `For ${sqft} sq ft at 6 inches deep (standard for new lawn or garden beds), you need ${main.cuYdWaste} cubic yards or ${main.bags40lb} bags of 40 lb topsoil, with 10% waste included.`,
  },
  {
    q: `How many cubic yards of topsoil for ${sqft} square feet?`,
    a: `At 4 inches: ${rows[1].cuYdWaste} cu yd. At 6 inches: ${main.cuYdWaste} cu yd. At 8 inches: ${rows[3].cuYdWaste} cu yd. All include 10% waste.`,
  },
  {
    q: `How many bags of topsoil for ${sqft} square feet?`,
    a: `At 6 inches: ${main.bags40lb} bags of 40 lb topsoil (approx. 0.75 cu ft each) or ${main.bagsCuFt} bags of 1 cu ft topsoil. For areas over 2 cubic yards, bulk delivery is usually cheaper.`,
  },
  {
    q: `How deep should I add topsoil for grass or a garden?`,
    a: `For overseeding an existing lawn: 2 inches. For a new lawn: 4–6 inches. For vegetable gardens: 8–12 inches. For raised beds, fill the full depth with a topsoil/compost mix.`,
  },
];

const related = [
  { href: '/calculator/topsoil', label: 'Topsoil Calculator' },
  { href: '/guide/how-much-topsoil-do-i-need', label: 'How Much Topsoil Do I Need?' },
  { href: '/guide/how-much-topsoil-for-raised-bed', label: 'Topsoil for a Raised Bed' },
  { href: '/guide/topsoil-vs-garden-soil', label: 'Topsoil vs Garden Soil' },
];

const title = `How Much Topsoil for ${sqft} Square Feet? (Bags & Cubic Yards)`;
const description = `For ${sqft} sq ft at 6 inches deep, you need ${main.cuYdWaste} cubic yards or ${main.bags40lb} bags of 40 lb topsoil. Full depth table with 10% waste included.`;
---

<GuideLayout
  {title}
  {description}
  h1={`How Much Topsoil for ${sqft} Square Feet?`}
  intro={`For ${sqft} square feet at 6 inches deep — standard for a new lawn or garden bed — you need ${main.cuYdWaste} cubic yards of topsoil. That's ${main.bags40lb} bags (40 lb) or ${main.bagsCuFt} bags (1 cu ft), with 10% waste included.`}
  calculatorHref="/calculator/topsoil"
  calculatorLabel="Topsoil Calculator — enter any area and depth for exact bags or cubic yards"
  faqs={faqs}
  related={related}
  breadcrumbs={[{ label: 'Guides' }, { label: `Topsoil for ${sqft} Sq Ft` }]}
>

<h2>Answer at a glance — {sqft} sq ft</h2>

<table>
  <thead>
    <tr><th>Depth</th><th>Cu yards</th><th>40 lb bags</th><th>1 cu ft bags</th><th>Tons</th></tr>
  </thead>
  <tbody>
    {rows.map((r: any) => (
      <tr>
        <td>{r.depth}"</td>
        <td>{r.cuYdWaste} cu yd</td>
        <td><strong>{r.bags40lb}</strong></td>
        <td>{r.bagsCuFt}</td>
        <td>{r.tons}</td>
      </tr>
    ))}
  </tbody>
</table>
<p><em>All counts include 10% waste, rounded up.</em></p>

<h2>How we calculated it</h2>
<ol>
  <li>Volume = {sqft} × 6 ÷ 12 = <strong>{main.cuFt} cu ft</strong></li>
  <li>Cubic yards = {main.cuFt} ÷ 27 = <strong>{main.cuYd} cu yd</strong></li>
  <li>With 10% waste = <strong>{main.cuYdWaste} cu yd</strong></li>
  <li>40 lb bags (approx. 0.75 cu ft each) = <strong>{main.bags40lb} bags</strong></li>
</ol>

<h2>Compare nearby areas</h2>

<table>
  <thead>
    <tr><th>Area</th><th>At 4" (top-dress)</th><th>At 6" (new lawn)</th><th>At 8" (garden)</th></tr>
  </thead>
  <tbody>
    {nearby.map((n: any) => (
      <tr>
        <td>{n.area} sq ft</td>
        <td>{n.d4.cuYdWaste} cu yd / {n.d4.bags40lb} bags</td>
        <td><strong>{n.d6.cuYdWaste} cu yd / {n.d6.bags40lb} bags</strong></td>
        <td>{n.d8.cuYdWaste} cu yd / {n.d8.bags40lb} bags</td>
      </tr>
    ))}
  </tbody>
</table>

<h2>Depth guide by use</h2>
<table>
  <thead>
    <tr><th>Application</th><th>Recommended depth</th></tr>
  </thead>
  <tbody>
    <tr><td>Overseeding / top-dressing</td><td>2 inches</td></tr>
    <tr><td>Patching bare lawn spots</td><td>2–4 inches</td></tr>
    <tr><td>New lawn from seed</td><td>4–6 inches</td></tr>
    <tr><td>New lawn from sod</td><td>4–6 inches</td></tr>
    <tr><td>Vegetable garden</td><td>8–12 inches</td></tr>
    <tr><td>Raised bed (fill)</td><td>12–18 inches</td></tr>
  </tbody>
</table>

<h2>Bags vs. bulk topsoil</h2>
<p>
  {isBulkBetter
    ? `At ${main.cuYdWaste} cubic yards, bulk topsoil is usually cheaper than bags. Get quotes from local landscaping suppliers — bulk topsoil typically runs $20–$50 per cubic yard vs. $5–$8 per 40 lb bag.`
    : `For ${sqft} sq ft you need ${main.cuYdWaste} cubic yards — buying ${main.bags40lb} bags is the easy choice. Most suppliers require a 2-yard minimum for bulk delivery.`
  }
</p>

<p>Use the <a href="/calculator/topsoil">Topsoil Calculator</a> to enter your exact dimensions and get an instant bag count or cubic yard total.</p>

</GuideLayout>
