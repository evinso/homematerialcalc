---
import GuideLayout from '../../layouts/GuideLayout.astro';

export function getStaticPaths() {
  const rooms = [
    { size: '8x8',   l: 8,  w: 8  },
    { size: '10x10', l: 10, w: 10 },
    { size: '10x12', l: 10, w: 12 },
    { size: '10x14', l: 10, w: 14 },
    { size: '12x12', l: 12, w: 12 },
    { size: '12x14', l: 12, w: 14 },
    { size: '12x15', l: 12, w: 15 },
    { size: '12x20', l: 12, w: 20 },
    { size: '14x14', l: 14, w: 14 },
    { size: '15x15', l: 15, w: 15 },
    { size: '20x20', l: 20, w: 20 },
  ];
  return rooms.map(r => ({ params: { size: r.size }, props: { l: r.l, w: r.w } }));
}

const { l, w } = Astro.props as { l: number; w: number };
const sqft = l * w;
const COVERAGE = 350;

const wallArea = 2 * (l + w) * 8;
const netWall = Math.max(0, wallArea - 50);
const ceilingArea = sqft;

const gal = (area: number, coats: number) =>
  Math.ceil(area * coats / COVERAGE * 10) / 10;

const gal1coat = gal(netWall, 1);
const gal2coat = gal(netWall, 2);
const galCeil1 = gal(ceilingArea, 1);
const extraPerFt = Math.ceil(2 * (l + w) / COVERAGE * 10) / 10;

const rows = [
  { label: '1 coat, walls only',      g: gal(netWall, 1) },
  { label: '2 coats, walls only',      g: gal(netWall, 2) },
  { label: '1 coat, walls + ceiling',  g: Math.ceil((gal(netWall,1) + gal(ceilingArea,1)) * 10) / 10 },
  { label: '2 coats, walls + ceiling', g: Math.ceil((gal(netWall,2) + gal(ceilingArea,2)) * 10) / 10 },
];

const faqs = [
  {
    q: `How many gallons of paint for a ${l}x${w} room?`,
    a: `A ${l}×${w} ft room has ${wallArea} sq ft of wall area. Subtract 1 door and 2 windows (50 sq ft) = ${netWall} sq ft. That's ${gal1coat} gallons for 1 coat or ${gal2coat} gallons for 2 coats.`,
  },
  {
    q: `Do I need to paint the ceiling in a ${l}x${w} room?`,
    a: `The ceiling in a ${l}×${w} room is ${ceilingArea} sq ft — ${galCeil1} gallons per coat of ceiling paint. Ceiling paint is typically white and sold separately from wall paint.`,
  },
  {
    q: `How long will it take to paint a ${l}x${w} room?`,
    a: `Most DIYers can paint a ${l}×${w} room in 4–8 hours for 2 coats including prep, drying time, and cleanup. Professionals cost $200–$500 for a room this size.`,
  },
  {
    q: `What paint sheen for a ${l}x${w} room?`,
    a: `Bedrooms: eggshell or satin. Living rooms: eggshell. Bathrooms and kitchens: satin or semi-gloss. Trim and doors: semi-gloss or gloss.`,
  },
];

const related = [
  { href: '/calculator/paint', label: 'Paint Calculator' },
  { href: '/guide/how-much-paint-do-i-need', label: 'How Much Paint Do I Need?' },
  { href: '/guide/how-many-gallons-of-paint-for-a-bedroom', label: 'Paint for a Bedroom' },
  { href: '/guide/paint-coverage-per-gallon', label: 'Paint Coverage per Gallon' },
  { href: '/guide/how-many-coats-of-paint', label: 'How Many Coats of Paint?' },
];

const title = `How Much Paint for a ${l}×${w} Room? (Gallons Needed)`;
const description = `A ${l}×${w} ft room needs ${gal1coat} gallons for 1 coat or ${gal2coat} gallons for 2 coats of wall paint (${netWall} sq ft net wall area). Ceiling separate.`;
---

<GuideLayout
  {title}
  {description}
  h1={`How Much Paint for a ${l}×${w} Room?`}
  intro={`A ${l}×${w} foot room has ${wallArea} sq ft of wall area. Subtract 1 door and 2 windows and you get ${netWall} sq ft to paint — that's ${gal1coat} gallons for 1 coat or ${gal2coat} gallons for 2 coats of wall paint.`}
  calculatorHref="/calculator/paint"
  calculatorLabel="Paint Calculator — enter exact room dimensions, doors, and windows for a precise gallon count"
  faqs={faqs}
  related={related}
  breadcrumbs={[{ label: 'Guides' }, { label: `Paint for ${l}×${w} Room` }]}
>

<p><em>Assumptions: 8 ft ceiling · 1 door (20 sq ft) · 2 windows (15 sq ft each) · 350 sq ft per gallon</em></p>

<h2>Answer at a glance — {l}×{w} ft room</h2>

<table>
  <thead>
    <tr><th>What you're painting</th><th>Gallons needed</th></tr>
  </thead>
  <tbody>
    {rows.map(r => (
      <tr>
        <td>{r.label}</td>
        <td><strong>{r.g} gal</strong></td>
      </tr>
    ))}
  </tbody>
</table>

<h2>How we calculated it</h2>
<ol>
  <li>Wall area = 2 × ({l} + {w}) × 8 ft = <strong>{wallArea} sq ft</strong></li>
  <li>Deductions = 1 door (20 sq ft) + 2 windows (30 sq ft) = <strong>50 sq ft</strong></li>
  <li>Net wall area = {wallArea} − 50 = <strong>{netWall} sq ft</strong></li>
  <li>Gallons per coat = {netWall} ÷ 350 = <strong>{gal1coat} gal</strong></li>
  <li>Two coats = <strong>{gal2coat} gal</strong></li>
</ol>
<p>Ceiling: {l} × {w} = <strong>{ceilingArea} sq ft</strong> → {galCeil1} gal per coat</p>

<h2>Adjust for your room</h2>
<ul>
  <li><strong>More or larger windows</strong> — each 15 sq ft window saves ~0.04 gallons per coat</li>
  <li><strong>9 ft ceilings</strong> — adds {2 * (l + w)} sq ft more wall area ({extraPerFt} gal per coat extra)</li>
  <li><strong>No door</strong> — add back 20 sq ft per missing door</li>
  <li><strong>Dark color over light</strong> — may need a 3rd coat; buy extra accordingly</li>
</ul>

<p>The <a href="/calculator/paint">Paint Calculator</a> lets you enter your exact window count, ceiling height, and number of coats.</p>

<h2>Paint buying tips</h2>
<ul>
  <li>Buy all cans in one trip — batch numbers affect color consistency</li>
  <li>Keep a quart of the same color for future touch-ups</li>
  <li>Use a separate primer coat if painting over dark colors or new drywall</li>
</ul>

</GuideLayout>
