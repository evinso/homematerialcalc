---
import GuideLayout from '../../layouts/GuideLayout.astro';

export function getStaticPaths() {
  const areas = [100, 200, 300, 500, 1000];
  return areas.map(area => ({ params: { area: String(area) } }));
}

const { area } = Astro.params;
const sqft = Number(area);

function calcGravel(sqft: number, depthIn: number, waste = 0.10) {
  const cuFt = sqft * depthIn / 12;
  const cuYd = cuFt / 27;
  const cuYdWaste = cuYd * (1 + waste);
  return {
    cuFt: Math.round(cuFt * 10) / 10,
    cuYd: Math.round(cuYd * 100) / 100,
    cuYdWaste: Math.round(cuYdWaste * 100) / 100,
    tons: Math.round(cuYdWaste * 1.4 * 10) / 10,
  };
}

const depths = [2, 3, 4, 6];
const rows = depths.map(d => ({ depth: d, ...calcGravel(sqft, d) }));
const main = calcGravel(sqft, 4);

const nearby = [sqft * 0.5, sqft * 0.75, sqft, sqft * 1.5, sqft * 2]
  .map(a => Math.round(a))
  .filter((a, i, arr) => a > 0 && arr.indexOf(a) === i);

const faqs = [
  {
    q: `How much gravel do I need for ${sqft} square feet?`,
    a: `For ${sqft} sq ft at 4 inches deep (standard for paths and borders), you need ${main.cuYdWaste} cubic yards or ${main.tons} tons of gravel (includes 10% waste).`,
  },
  {
    q: `How many tons of gravel for ${sqft} square feet?`,
    a: `At 4 inches: ${main.tons} tons. At 3 inches: ${calcGravel(sqft, 3).tons} tons. At 6 inches (driveway): ${calcGravel(sqft, 6).tons} tons. One cubic yard of gravel weighs about 1.4 tons.`,
  },
  {
    q: `How many cubic yards of gravel for ${sqft} square feet?`,
    a: `At 4 inches: ${main.cuYdWaste} cu yd (with 10% waste). At 2 inches: ${calcGravel(sqft, 2).cuYdWaste} cu yd. At 6 inches: ${calcGravel(sqft, 6).cuYdWaste} cu yd.`,
  },
  {
    q: `What type of gravel is best for ${sqft} sq ft?`,
    a: `For paths and borders, pea gravel (3/8") or decomposed granite works well. For driveways, use #57 crushed stone (3/4") for the base. For drainage, use #57 or #67 stone.`,
  },
];

const related = [
  { href: '/calculator/gravel', label: 'Gravel Calculator' },
  { href: '/guide/how-much-gravel-do-i-need', label: 'How Much Gravel Do I Need?' },
  { href: '/guide/how-much-gravel-for-a-driveway', label: 'Gravel for a Driveway' },
  { href: '/guide/pea-gravel-vs-river-rock', label: 'Pea Gravel vs River Rock' },
];

const title = `How Much Gravel for ${sqft} Square Feet? (Tons & Cubic Yards)`;
const description = `For ${sqft} sq ft at 4 inches deep, you need ${main.tons} tons or ${main.cuYdWaste} cubic yards of gravel. Full table for all depths with 10% waste included.`;
---

<GuideLayout
  {title}
  {description}
  h1={`How Much Gravel for ${sqft} Square Feet?`}
  intro={`For ${sqft} square feet at 4 inches deep — standard for paths, borders, and patios — you need ${main.cuYdWaste} cubic yards or ${main.tons} tons of gravel (with 10% waste).`}
  calculatorHref="/calculator/gravel"
  calculatorLabel="Gravel Calculator — enter dimensions and depth for exact tons and cubic yards"
  faqs={faqs}
  related={related}
  breadcrumbs={[{ label: 'Guides' }, { label: `Gravel for ${sqft} Sq Ft` }]}
>

<h2>Answer at a glance — {sqft} sq ft</h2>

<table>
  <thead>
    <tr><th>Depth</th><th>Cu ft</th><th>Cu yards</th><th>Tons (with 10% waste)</th></tr>
  </thead>
  <tbody>
    {rows.map(r => (
      <tr>
        <td>{r.depth} inches</td>
        <td>{r.cuFt}</td>
        <td>{r.cuYd}</td>
        <td><strong>{r.tons} tons</strong></td>
      </tr>
    ))}
  </tbody>
</table>

<h2>How we calculated it</h2>

<p>For {sqft} sq ft at 4 inches:</p>
<ol>
  <li>Volume = {sqft} × 4 ÷ 12 = <strong>{calcGravel(sqft, 4).cuFt} cu ft</strong></li>
  <li>Cubic yards = {calcGravel(sqft, 4).cuFt} ÷ 27 = <strong>{calcGravel(sqft, 4).cuYd} cu yd</strong></li>
  <li>With 10% waste = <strong>{main.cuYdWaste} cu yd</strong></li>
  <li>Tons = {main.cuYdWaste} × 1.4 = <strong>{main.tons} tons</strong></li>
</ol>
<p>Gravel density varies by type: pea gravel ≈ 1.35 tons/cu yd, crushed stone ≈ 1.5 tons/cu yd. The 1.4 figure is a reliable average.</p>

<h2>Compare nearby sizes</h2>

<table>
  <thead>
    <tr><th>Area</th><th>At 3" (paths)</th><th>At 4" (standard)</th><th>At 6" (driveway)</th></tr>
  </thead>
  <tbody>
    {nearby.map(a => {
      const g3 = calcGravel(a, 3);
      const g4 = calcGravel(a, 4);
      const g6 = calcGravel(a, 6);
      return (
        <tr>
          <td>{a} sq ft</td>
          <td>{g3.tons} tons</td>
          <td><strong>{g4.tons} tons</strong></td>
          <td>{g6.tons} tons</td>
        </tr>
      );
    })}
  </tbody>
</table>

<h2>Depth guide by use</h2>
<ul>
  <li><strong>2–3 inches</strong> — decorative coverage, flower beds, tree rings</li>
  <li><strong>4 inches</strong> — paths, patios, play areas (most common)</li>
  <li><strong>6 inches</strong> — driveways (base layer), high-traffic areas</li>
  <li><strong>8–12 inches</strong> — driveway full build (base + surface combined)</li>
</ul>

<h2>Ordering tips</h2>
<p>
  Gravel is sold by the ton or by the cubic yard depending on supplier. Always confirm which unit your quote uses before ordering.
  For {sqft} sq ft at 4 inches you need roughly {main.cuYdWaste} cu yd — if ordering by the ton, ask for {main.tons} tons.
</p>

<p>Use the <a href="/calculator/gravel">Gravel Calculator</a> to enter your exact dimensions and get a precise tonnage with price estimate.</p>

</GuideLayout>
