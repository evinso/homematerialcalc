    guideHref: '/guide/how-much-topsoil-do-i-need/',
    relatedCalcs: [
      { href: '/calculator/topsoil/', label: 'Topsoil Calculator' },
      { href: '/calculator/topsoil-cost/', label: 'Topsoil Cost Calculator' },
      { href: '/calculator/mulch-cost/', label: 'Mulch Cost Calculator' },
    ],
    faqs: (state) => [
      { q: `How much does topsoil cost in ${state}?`, a: `In ${state}, bagged topsoil runs $3–$8 per 40 lb bag. Bulk topsoil delivered costs $25–$60 per cubic yard. Screened or premium topsoil can reach $65/cu yd from specialty suppliers.` },
      { q: `How much topsoil do I need for a new lawn in ${state}?`, a: `For a new lawn in ${state}, apply 4–6 inches of topsoil. A 1,000 sq ft area at 6 inches needs about 18.5 cubic yards — roughly $550–$1,100 in bulk plus delivery.` },
      { q: `Where do I buy bulk topsoil in ${state}?`, a: `Landscape supply yards, garden centers, and some quarries sell bulk topsoil in ${state}. Call 2–3 suppliers for quotes. Prices vary by soil quality (unscreened, screened, or blended with compost).` },
      { q: `What's the difference between topsoil and garden soil in ${state}?`, a: `Topsoil is natural in-ground soil, good for fill and new lawns. Garden or raised bed soil is enriched with compost for planting. Both are available from ${state} landscape suppliers; garden soil costs slightly more.` },
    ],
    intro: (state) => `Topsoil prices in ${state} depend on quality (screened vs. unscreened), quantity, and delivery distance from local suppliers. This guide covers current price ranges, how much to order for common projects, and what to ask suppliers.`,
    breakdown: (state) => [
      { label: '40 lb bag (store)', low: '$3', high: '$8' },
      { label: 'Bulk topsoil (per cu yd)', low: '$25', high: '$50' },
      { label: 'Screened/premium topsoil', low: '$40', high: '$65/cu yd' },
      { label: 'Compost blend', low: '$45', high: '$70/cu yd' },
      { label: 'Delivery fee', low: '$50', high: '$150' },
    ],
  },
  sand: {
    label: 'Sand', unit: 'ton / bag',
    bagPrice: [4, 8], bulkPrice: [25, 55], bulkUnit: 'ton',
    calcHref: '/calculator/sand/', costCalcHref: '/calculator/sand-cost/',
    guideHref: '/guide/how-much-sand-do-i-need/',
    relatedCalcs: [
      { href: '/calculator/sand/', label: 'Sand Calculator' },
      { href: '/calculator/sand-cost/', label: 'Sand Cost Calculator' },
      { href: '/calculator/gravel-cost/', label: 'Gravel Cost Calculator' },
    ],
    faqs: (state) => [
      { q: `How much does sand cost in ${state}?`, a: `In ${state}, bagged sand runs $4–$8 per 50 lb bag. Bulk sand delivered costs $25–$55 per ton depending on sand type. Fill sand is cheapest; masonry and play sand cost more.` },
      { q: `How much sand do I need for a paver base in ${state}?`, a: `A 200 sq ft patio needs about 0.6 cubic yards (roughly 0.8 tons) of bedding sand at 1 inch deep. In ${state}, that's $25–$50 in bulk plus delivery, or about 16 bags at a home improvement store.` },
      { q: `What type of sand should I use in ${state}?`, a: `For paver bedding in ${state}, use coarse concrete sand or washed torpedo sand. For children's sandboxes, use screened play sand. For mixing concrete, use sharp sand or all-purpose sand. Avoid fine beach sand for structural uses.` },
      { q: `Where can I buy bulk sand in ${state}?`, a: `Landscape supply yards, masonry supply companies, and some quarries sell bulk sand in ${state}. For large paver projects, buying bulk is much cheaper than bags — $25–$55/ton vs. $200+/ton in bags.` },
    ],
    intro: (state) => `Sand prices in ${state} vary by type (fill, masonry, concrete, play) and quantity ordered. This guide covers current price ranges for bagged and bulk sand in ${state}, what type to use for each project, and how to calculate your exact needs.`,
    breakdown: (state) => [
      { label: '50 lb bag (store)', low: '$4', high: '$8' },
      { label: 'Fill/construction sand (per ton)', low: '$20', high: '$35' },
      { label: 'Masonry/concrete sand (per ton)', low: '$25', high: '$45' },
      { label: 'Play sand 50 lb bag', low: '$6', high: '$12' },
      { label: 'Delivery fee', low: '$50', high: '$150' },
    ],
  },
};

