const CITY_SLUGS = new Set(CITIES.map(c => c.slug));

export function getStaticPaths() {
  const states = [
    { slug: 'texas',          name: 'Texas',          abbr: 'TX' },
    { slug: 'florida',        name: 'Florida',        abbr: 'FL' },
    { slug: 'california',     name: 'California',     abbr: 'CA' },
    { slug: 'new-york',       name: 'New York',       abbr: 'NY' },
    { slug: 'georgia',        name: 'Georgia',        abbr: 'GA' },
    { slug: 'north-carolina', name: 'North Carolina', abbr: 'NC' },
    { slug: 'ohio',           name: 'Ohio',           abbr: 'OH' },
    { slug: 'michigan',       name: 'Michigan',       abbr: 'MI' },
    { slug: 'pennsylvania',   name: 'Pennsylvania',   abbr: 'PA' },
    { slug: 'illinois',       name: 'Illinois',       abbr: 'IL' },
    { slug: 'arizona',        name: 'Arizona',        abbr: 'AZ' },
    { slug: 'washington',     name: 'Washington',     abbr: 'WA' },
    { slug: 'tennessee',      name: 'Tennessee',      abbr: 'TN' },
    { slug: 'indiana',        name: 'Indiana',        abbr: 'IN' },
    { slug: 'missouri',       name: 'Missouri',       abbr: 'MO' },
    { slug: 'colorado',       name: 'Colorado',       abbr: 'CO' },
    { slug: 'virginia',       name: 'Virginia',       abbr: 'VA' },
    { slug: 'maryland',       name: 'Maryland',       abbr: 'MD' },
    { slug: 'oregon',         name: 'Oregon',         abbr: 'OR' },
    { slug: 'wisconsin',      name: 'Wisconsin',      abbr: 'WI' },
  ];
  const materialSlugs = ['mulch', 'gravel', 'topsoil', 'sand'];
  const paths = [];
  // State pages (existing)
  for (const state of states) {
    for (const mat of materialSlugs) {
      paths.push({ params: { material: mat, state: state.slug }, props: { locationName: state.name, locationAbbr: state.abbr, isCity: false, cityStateName: state.name } });
    }
  }
  // City pages (new)
  for (const city of CITIES) {
    for (const mat of materialSlugs) {
      paths.push({ params: { material: mat, state: city.slug }, props: { locationName: `${city.name}, ${city.stateAbbr}`, locationAbbr: city.stateAbbr, isCity: true, cityStateName: city.stateName, cityName: city.name } });
    }
  }
  return paths;
}

const { material, state: stateSlug } = Astro.params;
const { locationName, locationAbbr, isCity, cityStateName, cityName } = Astro.props as {
  locationName: string; locationAbbr: string; isCity: boolean; cityStateName: string; cityName?: string;
};

// For backward compat: stateName used in mat.faqs / mat.intro / mat.breakdown
const stateName = isCity ? `${cityName}, ${locationAbbr}` : locationName;
const stateAbbr = locationAbbr;

const mat = MATERIALS[material as keyof typeof MATERIALS];

const faqs = mat.faqs(stateName);
const breakdown = mat.breakdown(stateName);
const title = isCity
  ? `${mat.label} Cost in ${locationName} — 2026 Price Guide`
  : `${mat.label} Cost in ${locationName} — 2026 Price Guide`;
const description = `Current ${mat.label.toLowerCase()} prices in ${locationName}: bagged and bulk rates, best local suppliers, and how much to order for your project. Updated 2026.`;
---

<GuideLayout
  {title}
  {description}
  h1={`${mat.label} Cost in ${locationName} — 2026 Prices`}
  intro={mat.intro(stateName)}
  calculatorHref={mat.calcHref}
  calculatorLabel={`${mat.label} Calculator — enter your dimensions for an exact quantity`}
  faqs={faqs}
  related={mat.relatedCalcs}
  breadcrumbs={isCity
    ? [{ label: 'Guides' }, { label: `${mat.label} Cost in ${cityStateName}`, href: `/guide/${material}-cost-in-${stateSlug.replace(/-[a-z]{2}$/, '')}` }, { label: locationName }]
    : [{ label: 'Guides' }, { label: `${mat.label} Cost in ${locationName}` }]
  }
>

<h2>2026 {mat.label} Price Ranges in {stateName}</h2>

<table>
  <thead>
    <tr><th>Product</th><th>Typical price</th></tr>
  </thead>
  <tbody>
    {breakdown.map(row => (
      <tr>
        <td>{row.label}</td>
        <td><strong>{row.low}–{row.high}</strong></td>
      </tr>
    ))}
  </tbody>
</table>

<p><em>Prices are typical ranges for {stateName}. Actual prices vary by county, supplier, and current market conditions. Always get 2–3 quotes for bulk orders.</em></p>

<h2>Bags vs. Bulk in {stateName}</h2>

<p>
  For small projects (under 1–2 {mat.bulkUnit === 'ton' ? 'tons' : 'cubic yards'}), bags from Home Depot or Lowe's are convenient. For larger projects, bulk delivery from a local {stateName} landscape supply company is significantly cheaper — often 50–70% less per unit than buying bags.
</p>

<p>
  Call 2–3 local suppliers in {stateName} for quotes. Ask about minimum order sizes (usually 2–5 {mat.bulkUnit === 'ton' ? 'tons' : 'yards'}) and delivery areas. Many suppliers charge extra for deliveries over 30–50 miles.
</p>

<h2>How Much {mat.label} Do You Need?</h2>

<p>
  Use the <a href={mat.calcHref}>{mat.label} Calculator</a> to enter your dimensions and get an exact quantity in {mat.unit}. Then use the <a href={mat.costCalcHref}>{mat.label} Cost Calculator</a> to enter your {stateName} local price and get a total cost estimate including delivery.
</p>

<h2>Finding {mat.label} Suppliers in {stateName}</h2>

<ul>
  <li><strong>Local landscape supply yards</strong> — Best bulk prices, wide selection. Search "[your city] landscape supply" for local options.</li>
  <li><strong>Home Depot / Lowe's</strong> — Convenient for bagged {mat.label.toLowerCase()}, consistent pricing, no minimums.</li>
  <li><strong>Quarries and gravel pits</strong> — Lowest prices if you can haul yourself (pickup truck or trailer).</li>
  <li><strong>Online marketplaces</strong> — Facebook Marketplace and Craigslist sometimes have free or cheap {mat.label.toLowerCase()} from excess landscaping projects.</li>
</ul>

</GuideLayout>
