const MATERIALS: Record<string, {
  label: string; unit: string;
  bagPrice: [number, number]; bulkPrice: [number, number]; bulkUnit: string;
  calcHref: string; costCalcHref: string; guideHref: string;
  relatedCalcs: { href: string; label: string }[];
  faqs: (state: string) => { q: string; a: string }[];
  intro: (state: string) => string;
  breakdown: (state: string) => { label: string; low: string; high: string }[];
}> = {
  mulch: {
    label: 'Mulch', unit: 'cubic yard / bag',
    bagPrice: [4, 9], bulkPrice: [25, 65], bulkUnit: 'cubic yard',
    calcHref: '/calculator/mulch/', costCalcHref: '/calculator/mulch-cost/',
    guideHref: '/guide/how-much-mulch-do-i-need/',
    relatedCalcs: [
      { href: '/calculator/mulch/', label: 'Mulch Calculator' },
      { href: '/calculator/mulch-cost/', label: 'Mulch Cost Calculator' },
      { href: '/calculator/topsoil-cost/', label: 'Topsoil Cost Calculator' },
    ],
    faqs: (state) => [
      { q: `How much does mulch cost in ${state}?`, a: `In ${state}, bagged mulch typically runs $4–$9 per 2 cu ft bag. Bulk mulch delivered runs $25–$65 per cubic yard. Prices vary by county, supplier, and type (hardwood, cedar, dyed).` },
      { q: `Is bulk mulch cheaper than bags in ${state}?`, a: `Yes — for any project over 1.5 cubic yards (~20 bags), bulk delivery is almost always cheaper. At $7/bag that's $95/cu yd vs. $35–$50/cu yd in bulk from a local ${state} supplier.` },
      { q: `What's the cheapest type of mulch in ${state}?`, a: `Shredded hardwood and wood chip mulch are typically the least expensive at $25–$40/cu yd bulk in ${state}. Cedar and dyed mulch cost $35–$65/cu yd. Pine bark is mid-range.` },
      { q: `When is the best time to buy mulch in ${state}?`, a: `Late fall and early winter often have the lowest mulch prices in ${state} as demand drops. Spring (March–May) sees peak pricing. Buying in bulk before spring rush can save 15–25%.` },
    ],
    intro: (state) => `Mulch prices in ${state} depend on material type, purchase volume (bags vs. bulk), and your distance from local suppliers. This guide covers current price ranges, where to buy, and how to calculate exactly how much you need.`,
    breakdown: (state) => [
      { label: '2 cu ft bag (store)', low: '$4', high: '$9' },
      { label: 'Bulk hardwood (per cu yd)', low: '$25', high: '$45' },
      { label: 'Bulk cedar (per cu yd)', low: '$35', high: '$65' },
      { label: 'Bulk dyed (per cu yd)', low: '$30', high: '$55' },
      { label: 'Delivery fee', low: '$50', high: '$150' },
    ],
  },
  gravel: {
    label: 'Gravel', unit: 'ton / cubic yard',
    bagPrice: [4, 8], bulkPrice: [30, 80], bulkUnit: 'ton',
    calcHref: '/calculator/gravel/', costCalcHref: '/calculator/gravel-cost/',
    guideHref: '/guide/how-much-gravel-do-i-need/',
    relatedCalcs: [
      { href: '/calculator/gravel/', label: 'Gravel Calculator' },
      { href: '/calculator/gravel-cost/', label: 'Gravel Cost Calculator' },
      { href: '/calculator/sand-cost/', label: 'Sand Cost Calculator' },
    ],
    faqs: (state) => [
      { q: `How much does gravel cost in ${state}?`, a: `In ${state}, bulk gravel (pea gravel, crushed stone) runs $30–$80 per ton delivered depending on stone type and distance. Bagged gravel is $4–$8 per 50 lb bag at home improvement stores.` },
      { q: `How much does a gravel driveway cost in ${state}?`, a: `A standard 12×50 ft driveway at 6 inches deep needs about 13 tons. In ${state}, that's roughly $400–$1,000 in materials plus $150–$300 delivery — before any grading work.` },
      { q: `What type of gravel is best for driveways in ${state}?`, a: `For most ${state} driveways, #57 crushed stone for the base and pea gravel or limestone screenings for the surface is standard. In freeze-thaw climates, angular crushed stone locks together better than round stone.` },
      { q: `Where can I buy gravel in ${state}?`, a: `Local quarries and landscape supply companies typically offer the best bulk prices in ${state}. Home Depot and Lowe's carry bagged gravel. For large orders, get quotes from 2–3 suppliers — prices vary significantly by location.` },
    ],
    intro: (state) => `Gravel prices in ${state} vary by stone type, quantity, and your distance from local quarries. This guide covers current bulk and bagged gravel prices, what to order for common projects, and how to calculate your exact tonnage.`,
    breakdown: (state) => [
      { label: 'Pea gravel (per ton)', low: '$35', high: '$65' },
      { label: 'Crushed stone 3/4" (per ton)', low: '$25', high: '$50' },
      { label: 'Crushed limestone (per ton)', low: '$25', high: '$45' },
