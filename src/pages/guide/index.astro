<BaseLayout
  title="Material Guides — How Much Do I Need, Costs & How-To | HomeMaterialCalc"
  description="Free guides for US homeowners: how much mulch, gravel, concrete, topsoil, paint, flooring, and tile you need. Includes cost guides, comparisons, and step-by-step how-to articles."
>
  <div class="max-w-5xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-1">›</span>
      <span class="text-gray-700">Guides</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-3">Material Guides</h1>
    <p class="text-lg text-gray-600 mb-10">How-much, cost, and how-to guides for every home material project — mulch, gravel, concrete, paint, flooring, tile, and more.</p>

    <div class="space-y-10">
      {categories.map(cat => (
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200">{cat.title}</h2>
          <ul class="grid sm:grid-cols-2 gap-2">
            {cat.guides.map(g => (
              <li>
                <a href={g.href} class="text-brand-600 hover:underline text-sm">{g.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
