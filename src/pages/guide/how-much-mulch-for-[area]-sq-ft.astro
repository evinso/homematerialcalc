---
import GuideLayout from '../../layouts/GuideLayout.astro';

export function getStaticPaths() {
  const areas = [50, 150, 200, 250, 300, 400, 500, 600, 750, 1000, 1500, 2000];
  return areas.map(area => ({ params: { area: String(area) } }));
}

const { area } = Astro.params;
const sqft = Number(area);

function calcMulch(sqft: number, depthIn: number, waste = 0.05) {
  const cuFt = sqft * depthIn / 12;
  const cuYd = cuFt / 27;
  const bags = Math.ceil((cuFt / 2) * (1 + waste));
  return {
    cuFt: Math.round(cuFt * 10) / 10,
    cuYd: Math.round(cuYd * 100) / 100,
    bags,
  };
}

const depths = [1, 2, 3, 4, 6];
const rows = depths.map(d => ({ depth: d, ...calcMulch(sqft, d) }));
const main = calcMulch(sqft, 3);

const VALID_AREAS = [50, 150, 200, 250, 300, 400, 500, 600, 750, 1000, 1500, 2000];
const nearby = VALID_AREAS
  .filter(a => a !== sqft)
  .sort((a, b) => Math.abs(a - sqft) - Math.abs(b - sqft))
  .slice(0, 5);

const faqs = [
  {
    q: `How many bags of mulch for ${sqft} square feet at 3 inches?`,
    a: `For ${sqft} sq ft at 3 inches deep, you need ${main.cuYd} cubic yards — that's ${main.bags} bags of 2 cu ft mulch (includes 5% waste). Round up if your beds have irregular edges.`,
  },
  {
    q: `How many cubic yards of mulch for ${sqft} square feet?`,
    a: `At 2 inches deep: ${calcMulch(sqft, 2).cuYd} cu yd. At 3 inches: ${main.cuYd} cu yd. At 4 inches: ${calcMulch(sqft, 4).cuYd} cu yd.`,
  },
  {
    q: `Should I buy bags or bulk mulch for ${sqft} square feet?`,
    a: main.cuYd < 2
      ? `At ${main.cuYd} cubic yards, bagged mulch is the convenient choice. Buying ${main.bags} bags is easier than ordering a partial yard of bulk.`
      : `At ${main.cuYd} cubic yards, bulk delivery is usually cheaper. Compare your local bulk price per yard vs. bag cost (13.5 bags = 1 cu yd).`,
  },
  {
    q: `How do I measure ${sqft} square feet for mulching?`,
    a: `Measure each bed's length and width in feet and multiply. Add up all beds. A 5–10% waste factor covers edges and settling.`,
  },
];

const related = [
  { href: '/calculator/mulch', label: 'Mulch Calculator' },
  { href: '/guide/how-much-mulch-do-i-need', label: 'How Much Mulch Do I Need?' },
  { href: '/guide/how-many-bags-of-mulch-in-a-cubic-yard', label: 'Bags per Cubic Yard' },
  { href: '/guide/how-much-does-mulch-cost', label: 'How Much Does Mulch Cost?' },
];

const title = `How Much Mulch for ${sqft} Square Feet? (Bags & Cubic Yards)`;
const description = `For ${sqft} sq ft at 3 inches deep, you need ${main.bags} bags or ${main.cuYd} cubic yards of mulch. Full table for all depths with 5% waste included.`;
---

<GuideLayout
  {title}
  {description}
  h1={`How Much Mulch for ${sqft} Square Feet?`}
  intro={`For ${sqft} square feet at 3 inches deep — the standard mulch depth — you need ${main.cuYd} cubic yards, which equals ${main.bags} bags of 2 cu ft mulch (with 5% waste).`}
  calculatorHref="/calculator/mulch"
  calculatorLabel="Mulch Calculator — enter any area and depth for an exact bag count"
  faqs={faqs}
  related={related}
  breadcrumbs={[{ label: 'Guides' }, { label: `Mulch for ${sqft} Sq Ft` }]}
>

<h2>Answer at a glance — {sqft} sq ft</h2>

<table>
  <thead>
    <tr><th>Depth</th><th>Cu ft</th><th>Cu yards</th><th>2 cu ft bags (with 5% waste)</th></tr>
  </thead>
  <tbody>
    {rows.map(r => (
      <tr>
        <td>{r.depth} {r.depth === 1 ? 'inch' : 'inches'}</td>
        <td>{r.cuFt}</td>
        <td>{r.cuYd}</td>
        <td><strong>{r.bags} bags</strong></td>
      </tr>
    ))}
  </tbody>
</table>

<h2>How we calculated it</h2>

<p>For {sqft} sq ft at 3 inches:</p>
<ol>
  <li>Volume = {sqft} × 3 ÷ 12 = <strong>{main.cuFt} cu ft</strong></li>
  <li>Cubic yards = {main.cuFt} ÷ 27 = <strong>{main.cuYd} cu yd</strong></li>
  <li>Bags (2 cu ft) = {main.cuYd} × 13.5 = {Math.round(main.cuYd * 13.5 * 10) / 10} → with 5% waste = <strong>{main.bags} bags</strong></li>
</ol>

<h2>Compare nearby sizes</h2>

<table>
  <thead>
    <tr><th>Area</th><th>At 2"</th><th>At 3"</th><th>At 4"</th></tr>
  </thead>
  <tbody>
    {nearby.map(a => {
      const m2 = calcMulch(a, 2);
      const m3 = calcMulch(a, 3);
      const m4 = calcMulch(a, 4);
      return (
        <tr>
          <td><a href={`/guide/how-much-mulch-for-${a}-sq-ft/`}>{a} sq ft</a></td>
          <td>{m2.bags} bags</td>
          <td><strong>{m3.bags} bags</strong></td>
          <td>{m4.bags} bags</td>
        </tr>
      );
    })}
  </tbody>
</table>

<h2>Depth guide</h2>
<ul>
  <li><strong>1–2 inches</strong> — top-dressing existing mulch, lightweight coverage</li>
  <li><strong>3 inches</strong> — standard for flower beds, best weed suppression</li>
  <li><strong>4 inches</strong> — new beds or heavy clay soil where drainage is poor</li>
  <li><strong>6 inches</strong> — play areas, paths (not recommended for planted beds)</li>
</ul>

<h2>Bags vs. bulk</h2>
<p>
  {main.cuYd < 2
    ? `For ${sqft} sq ft you need ${main.cuYd} cubic yards — well under 2 yards. Buying ${main.bags} bags from a garden center is easier than ordering bulk mulch, which most suppliers require a 2-yard minimum for delivery.`
    : `For ${sqft} sq ft you need ${main.cuYd} cubic yards. If your local supplier charges less per yard in bulk than bags (≈13.5 bags per yard), bulk delivery saves money at this quantity.`
  }
</p>

<p>Use the <a href="/calculator/mulch">Mulch Calculator</a> to enter your exact dimensions and get a precise bag count with an optional price estimate.</p>

</GuideLayout>
