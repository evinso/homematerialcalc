---
import BaseLayout from '../layouts/BaseLayout.astro';

const calculators = [
  { slug: 'mulch',      label: 'Mulch Calculator',      h: 720 },
  { slug: 'gravel',     label: 'Gravel Calculator',     h: 720 },
  { slug: 'concrete',   label: 'Concrete Calculator',   h: 760 },
  { slug: 'topsoil',    label: 'Topsoil Calculator',    h: 680 },
  { slug: 'sand',       label: 'Sand Calculator',       h: 680 },
  { slug: 'sod',        label: 'Sod Calculator',        h: 660 },
  { slug: 'paint',      label: 'Paint Calculator',      h: 720 },
  { slug: 'paver',      label: 'Paver Calculator',      h: 700 },
  { slug: 'grass-seed', label: 'Grass Seed Calculator', h: 660 },
  { slug: 'fence',      label: 'Fence Calculator',      h: 640 },
  { slug: 'deck',       label: 'Deck Calculator',       h: 660 },
  { slug: 'asphalt',    label: 'Asphalt Calculator',    h: 640 },
  { slug: 'insulation', label: 'Insulation Calculator', h: 680 },
  { slug: 'project',    label: 'Project Calculator',    h: 760 },
];

const base = 'https://www.homematerialcalc.com';
---

<BaseLayout
  title="Embed a Free Calculator on Your Website | HomeMaterialCalc"
  description="Embed any of our free material calculators on your contractor, landscaping, or home improvement website. Free iframe embed code for mulch, gravel, concrete, and more."
>
<div class="max-w-4xl mx-auto px-4 py-10">

  <h1 class="text-3xl font-bold text-gray-900 mb-2">Embed a Calculator</h1>
  <p class="text-gray-600 mb-2">Add any HomeMaterialCalc calculator to your website for free. Just copy the iframe code and paste it into your page — no signup, no API key needed.</p>
  <p class="text-sm text-gray-500 mb-8">All we ask: please keep the attribution link inside the iframe intact.</p>

  <!-- Calculator selector -->
  <div class="calculator-card mb-8">
    <h2 class="font-semibold text-gray-900 mb-4">Choose a calculator</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
      {calculators.map((c, i) => (
        <button
          data-slug={c.slug}
          data-height={c.h}
          class={`embed-btn text-left px-3 py-2 rounded-lg border text-sm transition-colors ${
            i === 0
              ? 'border-brand-500 bg-brand-50 text-brand-800 font-medium'
              : 'border-gray-200 text-gray-700 hover:border-brand-300'
          }`}
        >
          {c.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Embed code output -->
  <div class="calculator-card mb-8">
    <h2 class="font-semibold text-gray-900 mb-3">Embed code</h2>
    <div class="bg-gray-900 rounded-lg p-4 relative">
      <pre id="embed-code" class="text-green-400 text-xs overflow-x-auto whitespace-pre-wrap font-mono leading-relaxed"></pre>
      <button id="copy-btn"
        class="absolute top-3 right-3 text-xs bg-gray-700 hover:bg-gray-600 text-gray-200 px-3 py-1.5 rounded-md transition-colors">
        Copy
      </button>
    </div>
    <p class="text-xs text-gray-500 mt-2">Width is responsive (100%). Adjust height to fit your design.</p>
  </div>

  <!-- Live preview -->
  <div class="calculator-card">
    <h2 class="font-semibold text-gray-900 mb-3">Live preview</h2>
    <div id="preview-wrap" class="border border-gray-200 rounded-xl overflow-hidden bg-gray-50">
      <iframe id="preview-frame"
        src={`${base}/calculator/mulch`}
        width="100%"
        height="720"
        frameborder="0"
        title="HomeMaterialCalc — Mulch Calculator"
        loading="lazy"
        class="block"
      ></iframe>
    </div>
  </div>

  <div class="mt-8 calculator-card bg-brand-50 border-brand-200">
    <h2 class="font-semibold text-brand-900 mb-2">Terms of use</h2>
    <ul class="text-sm text-brand-800 space-y-1">
      <li>✅ Free for any non-commercial or commercial website</li>
      <li>✅ No attribution required outside the iframe</li>
      <li>✅ Keep the "HomeMaterialCalc" link inside the iframe (it helps us keep the calculators free)</li>
      <li>❌ Do not scrape, re-host, or commercialize the calculator data itself</li>
    </ul>
  </div>

</div>
</BaseLayout>

<script define:vars={{ base, calculators }}>
  const buttons = document.querySelectorAll('.embed-btn');
  const codeEl  = document.getElementById('embed-code');
  const copyBtn = document.getElementById('copy-btn');
  const frame   = document.getElementById('preview-frame');

  function updateEmbed(slug, height, label) {
    const code = `<iframe\n  src="${base}/calculator/${slug}"\n  width="100%"\n  height="${height}"\n  frameborder="0"\n  title="HomeMaterialCalc — ${label}"\n  loading="lazy"\n></iframe>`;
    codeEl.textContent = code;
    frame.src = `${base}/calculator/${slug}`;
    frame.height = height;
    frame.title = `HomeMaterialCalc — ${label}`;
  }

  // Init with first
  updateEmbed(calculators[0].slug, calculators[0].h, calculators[0].label);

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('border-brand-500', 'bg-brand-50', 'text-brand-800', 'font-medium'));
      btn.classList.add('border-brand-500', 'bg-brand-50', 'text-brand-800', 'font-medium');
      updateEmbed(btn.dataset.slug, btn.dataset.height, btn.textContent.trim());
    });
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(codeEl.textContent).then(() => {
      copyBtn.textContent = 'Copied!';
      setTimeout(() => copyBtn.textContent = 'Copy', 2000);
    });
  });
</script>
