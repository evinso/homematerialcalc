---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/ui/AdSlot.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Methodology & Sources — HomeMaterialCalc.com',
  description: 'How HomeMaterialCalc.com calculates material quantities: every formula, constant, and source used in our calculators.',
  url: 'https://homematerialcalc.com/methodology',
};
---

<BaseLayout
  title="Methodology & Sources — How Our Calculators Work"
  description="Every formula and material constant used in HomeMaterialCalc.com's calculators — with citations. Transparent math you can verify yourself."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-brand-600">Home</a> › <span class="text-gray-700">Methodology</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-3">Methodology &amp; Sources</h1>
    <p class="text-gray-600 mb-8">
      Every result on HomeMaterialCalc.com comes from standard area and volume math combined with
      publicly known material constants. No black boxes — here is exactly how each calculator works
      and where the constants come from.
    </p>

    <AdSlot slot="header-banner" />

    <!-- Core formulas -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4 border-b pb-2">Core Calculation Pattern</h2>
      <p class="text-gray-700 mb-4">All calculators follow the same four-step pattern:</p>
      <ol class="space-y-4">
        {[
          ['Compute area', 'Rectangle: L × W · Circle: π × r² · Triangle: 0.5 × base × height · Irregular: sum of sub-areas'],
          ['Compute volume (bulk materials)', 'Volume (cu ft) = Area (sq ft) × Depth (in) ÷ 12 · Volume (cu yd) = Volume (cu ft) ÷ 27'],
          ['Apply material constant', 'Multiply volume by density (tons/cu yd) or divide by bag yield (cu ft/bag) to get purchasable units'],
          ['Apply waste factor', 'Adjusted quantity = Base quantity × (1 + waste%). Apply before rounding up. Default waste varies by material (see tables below).'],
        ].map(([step, detail], i) => (
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-7 h-7 bg-brand-600 text-white rounded-full flex items-center justify-center text-sm font-bold">{i+1}</span>
            <div>
              <p class="font-semibold text-gray-900">{step}</p>
              <p class="text-sm text-gray-600 mt-0.5">{detail}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="bg-gray-50 rounded-lg p-4 mt-4 text-sm font-mono text-gray-700 space-y-1">
        <p>1 cubic yard = 27 cubic feet <span class="text-gray-400">// exact mathematical identity</span></p>
        <p>Bags needed = ceil(Volume (cu ft) × waste ÷ bag yield) <span class="text-gray-400">// always round UP</span></p>
        <p>Cost = quantity × user-entered unit price</p>
      </div>
    </section>

    <!-- Material constants -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4 border-b pb-2">Material Constants &amp; Sources</h2>

      <div class="space-y-8">

        <!-- Mulch -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Mulch</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th>
              <th class="text-left p-2 border">Value</th>
              <th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Standard bag size','2 cubic feet','Industry standard — Home Depot, Lowe\'s, etc.'],
                ['Bags per cubic yard','13.5 bags','Mathematical: 27 cu ft ÷ 2 cu ft/bag = 13.5'],
                ['Default depth','3 inches','Landscaping industry best practice'],
                ['Default waste','5%','Standard overage for rectangular beds'],
                ['Coverage formula','324 ÷ depth (in) = sq ft/cu yd','Mathematical from volume identity'],
              ].map(([c,v,s]) => (
                <tr class="border-b">
                  <td class="p-2 border font-medium">{c}</td>
                  <td class="p-2 border">{v}</td>
                  <td class="p-2 border text-gray-500">{s}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Gravel -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Gravel &amp; Crushed Stone</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Stone type</th>
              <th class="text-left p-2 border">Density (tons/cu yd)</th>
              <th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Pea gravel','1.40','Aggregate industry supplier standard'],
                ['Crushed stone (3/4")','1.40','Aggregate industry supplier standard'],
                ['Crushed limestone','1.50','Aggregate industry supplier standard'],
                ['River rock (1–3")','1.35','Aggregate industry supplier standard'],
                ['Decomposed granite','1.35','Aggregate industry supplier standard'],
              ].map(([n,d,s]) => (
                <tr class="border-b">
                  <td class="p-2 border font-medium">{n}</td>
                  <td class="p-2 border">{d}</td>
                  <td class="p-2 border text-gray-500">{s}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Default depth: 2". Default waste: 10%.</p>
        </div>

        <!-- Topsoil -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Topsoil</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Density','1.10 tons/cu yd (2,200 lbs)','Soil supplier industry standard (dry)'],
                ['40 lb bag yield','~0.75 cu ft','Manufacturer average (Scotts, etc.)'],
                ['40 lb bags per cu yd','36 bags','Mathematical: 27 ÷ 0.75 = 36'],
                ['Default depth','4 inches','Garden bed standard'],
                ['Default waste','5%','Standard overage'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Sand -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Sand</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Sand type</th><th class="text-left p-2 border">Density (tons/cu yd)</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['All-purpose / fill','1.35','Landscape supply industry standard'],
                ['Paver / leveling','1.35','Landscape supply industry standard'],
                ['Play sand','1.30','Landscape supply industry standard'],
                ['Mason sand','1.30','Landscape supply industry standard'],
              ].map(([n,d,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{n}</td><td class="p-2 border">{d}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">50 lb bag yield: 0.50 cu ft · 54 bags/cu yd · Default waste: 10%.</p>
        </div>

        <!-- Sod -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Sod</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Piece size (standard US)','16" × 24" = 2.67 sq ft','US sod farm industry standard'],
                ['Pieces per pallet','~170 pieces','Common US sod farm standard'],
                ['Pallet coverage','~450 sq ft','170 × 2.67 ≈ 453 → standardized at 450'],
                ['Waste (straight edges)','5%','Sod industry trimming allowance'],
                ['Waste (curved/irregular)','10%','Sod industry trimming allowance'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Pallet coverage varies by supplier (450 sq ft is the US standard). Confirm with your local sod farm.</p>
        </div>

        <!-- Concrete -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Concrete (Bagged Pre-Mix)</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Bag size</th><th class="text-left p-2 border">Yield (cu ft)</th><th class="text-left p-2 border">Bags/cu yd</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['40 lb','0.30 cu ft','90','Quikrete product specifications'],
                ['50 lb','0.375 cu ft','72','Quikrete product specifications'],
                ['60 lb','0.45 cu ft','60','Quikrete product specifications'],
                ['80 lb','0.60 cu ft','45','Quikrete product specifications'],
              ].map(([b,y,bpy,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{b}</td><td class="p-2 border">{y}</td><td class="p-2 border">{bpy}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Default thickness: 4". Default waste: 10%. Post hole formula: π × r² × depth.</p>
        </div>

      </div>
    </section>

    <AdSlot slot="in-content" className="my-8" />

    <!-- Limitations -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-3 border-b pb-2">Important Limitations</h2>
      <ul class="space-y-2 text-sm text-gray-700">
        <li class="flex gap-2"><span class="text-brand-600 font-bold flex-shrink-0">·</span>All density values are <strong>industry averages for dry material</strong>. Actual weight varies with moisture content, compaction, and specific product.</li>
        <li class="flex gap-2"><span class="text-brand-600 font-bold flex-shrink-0">·</span>Bag yields are based on Quikrete specifications. Sakrete and other brands may differ slightly.</li>
        <li class="flex gap-2"><span class="text-brand-600 font-bold flex-shrink-0">·</span>Sod pallet coverage (450 sq ft) is a US industry standard. <strong>Confirm with your local sod farm</strong> before ordering.</li>
        <li class="flex gap-2"><span class="text-brand-600 font-bold flex-shrink-0">·</span>Results are estimates. <strong>For large or critical orders, confirm quantities with your local supplier</strong> who can account for site-specific conditions.</li>
        <li class="flex gap-2"><span class="text-brand-600 font-bold flex-shrink-0">·</span>The waste factor default is a starting point. Adjust it in each calculator based on your actual project complexity.</li>
      </ul>
    </section>

    <!-- Source references -->
    <section class="mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-3 border-b pb-2">Source References</h2>
      <ul class="text-sm text-gray-600 space-y-1.5">
        <li>Quikrete product data sheets (concrete bag yields) — quikrete.com</li>
        <li>Aggregate and landscape supplier industry standards (gravel, sand, topsoil densities)</li>
        <li>US sod-farm industry standards (piece size, pallet coverage)</li>
        <li>University extension service publications (mulch and soil depth recommendations)</li>
        <li>Volume identity: 1 cubic yard = 27 cubic feet (exact mathematical definition)</li>
      </ul>
    </section>

    <div class="bg-brand-50 border border-brand-200 rounded-xl p-5 text-sm text-gray-700">
      <p class="font-semibold text-brand-800 mb-1">Found an error?</p>
      <p>If you believe a constant or formula is incorrect, please <a href="/contact" class="text-brand-600 hover:underline">contact us</a> with a source and we will review it promptly. Accuracy is the whole product.</p>
    </div>
  </div>
</BaseLayout>
