---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/ui/AdSlot.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Methodology & Sources — HomeMaterialCalc.com',
  description: 'How HomeMaterialCalc.com calculates material quantities: every formula, constant, and source used in our calculators.',
  url: 'https://www.homematerialcalc.com/methodology/',
};
---

<BaseLayout
  title="Methodology & Sources — How Our Calculators Work"
  description="Every formula and material constant used in HomeMaterialCalc.com's calculators — with citations. Transparent math you can verify yourself."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-brand-600">Home</a> › <span class="text-gray-700">Methodology</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-3">Methodology &amp; Sources</h1>
    <p class="text-gray-600 mb-8">
      Every result on HomeMaterialCalc.com comes from standard area and volume math combined with
      publicly known material constants. No black boxes — here is exactly how each calculator works
      and where the constants come from.
    </p>

    <AdSlot slot="header-banner" />

    <!-- Core formulas -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4 border-b pb-2">Core Calculation Pattern</h2>
      <p class="text-gray-700 mb-4">All bulk material calculators follow the same four-step pattern:</p>
      <ol class="space-y-4">
        {[
          ['Compute area', 'Rectangle: L × W · Circle: π × r² · Triangle: 0.5 × base × height · Irregular: sum of sub-areas'],
          ['Compute volume (bulk materials)', 'Volume (cu ft) = Area (sq ft) × Depth (in) ÷ 12 · Volume (cu yd) = Volume (cu ft) ÷ 27'],
          ['Apply material constant', 'Multiply volume by density (tons/cu yd) or divide by bag yield (cu ft/bag) to get purchasable units'],
          ['Apply waste factor', 'Adjusted quantity = Base quantity × (1 + waste%). Apply before rounding up. Default waste varies by material (see tables below).'],
        ].map(([step, detail], i) => (
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-7 h-7 bg-brand-600 text-white rounded-full flex items-center justify-center text-sm font-bold">{i+1}</span>
            <div>
              <p class="font-semibold text-gray-900">{step}</p>
              <p class="text-sm text-gray-600 mt-0.5">{detail}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="bg-gray-50 rounded-lg p-4 mt-4 text-sm font-mono text-gray-700 space-y-1">
        <p>1 cubic yard = 27 cubic feet <span class="text-gray-400">// exact mathematical identity</span></p>
        <p>Bags needed = ceil(Volume (cu ft) × waste ÷ bag yield) <span class="text-gray-400">// always round UP</span></p>
        <p>Cost = quantity × user-entered unit price</p>
      </div>
    </section>

    <!-- Material constants -->
    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4 border-b pb-2">Material Constants &amp; Sources</h2>

      <div class="space-y-10">

        <!-- Mulch -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Mulch</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th>
              <th class="text-left p-2 border">Value</th>
              <th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Standard bag size','2 cubic feet','Industry standard — Home Depot, Lowe\'s, etc.'],
                ['Bags per cubic yard','13.5 bags','Mathematical: 27 cu ft ÷ 2 cu ft/bag = 13.5'],
                ['Default depth','3 inches','Landscaping industry best practice'],
                ['Default waste','5%','Standard overage for rectangular beds'],
                ['Coverage formula','324 ÷ depth (in) = sq ft/cu yd','Mathematical from volume identity'],
              ].map(([c,v,s]) => (
                <tr class="border-b">
                  <td class="p-2 border font-medium">{c}</td>
                  <td class="p-2 border">{v}</td>
                  <td class="p-2 border text-gray-500">{s}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Gravel -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Gravel &amp; Crushed Stone</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Stone type</th>
              <th class="text-left p-2 border">Density (tons/cu yd)</th>
              <th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Pea gravel','1.40','Aggregate industry supplier standard'],
                ['Crushed stone (3/4")','1.40','Aggregate industry supplier standard'],
                ['Crushed limestone','1.50','Aggregate industry supplier standard'],
                ['River rock (1–3")','1.35','Aggregate industry supplier standard'],
                ['Decomposed granite','1.35','Aggregate industry supplier standard'],
              ].map(([n,d,s]) => (
                <tr class="border-b">
                  <td class="p-2 border font-medium">{n}</td>
                  <td class="p-2 border">{d}</td>
                  <td class="p-2 border text-gray-500">{s}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Default depth: 2". Default waste: 10%.</p>
        </div>

        <!-- Topsoil -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Topsoil</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Density','1.10 tons/cu yd (2,200 lbs)','Soil supplier industry standard (dry)'],
                ['40 lb bag yield','~0.75 cu ft','Manufacturer average (Scotts, etc.)'],
                ['40 lb bags per cu yd','36 bags','Mathematical: 27 ÷ 0.75 = 36'],
                ['Default depth','4 inches','Garden bed standard'],
                ['Default waste','5%','Standard overage'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Sand -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Sand</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Sand type</th><th class="text-left p-2 border">Density (tons/cu yd)</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['All-purpose / fill','1.35','Landscape supply industry standard'],
                ['Paver / leveling','1.35','Landscape supply industry standard'],
                ['Play sand','1.30','Landscape supply industry standard'],
                ['Mason sand','1.30','Landscape supply industry standard'],
              ].map(([n,d,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{n}</td><td class="p-2 border">{d}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">50 lb bag yield: 0.50 cu ft · 54 bags/cu yd · Default waste: 10%.</p>
        </div>

        <!-- Sod -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Sod</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Piece size (standard US)','16" × 24" = 2.67 sq ft','US sod farm industry standard'],
                ['Pieces per pallet','~170 pieces','Common US sod farm standard'],
                ['Pallet coverage','~450 sq ft','170 × 2.67 ≈ 453 → standardized at 450'],
                ['Waste (straight edges)','5%','Sod industry trimming allowance'],
                ['Waste (curved/irregular)','10%','Sod industry trimming allowance'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Pallet coverage varies by supplier (450 sq ft is the US standard). Confirm with your local sod farm.</p>
        </div>

        <!-- Concrete -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Concrete (Bagged Pre-Mix)</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Bag size</th><th class="text-left p-2 border">Yield (cu ft)</th><th class="text-left p-2 border">Bags/cu yd</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['40 lb','0.30 cu ft','90','Quikrete product specifications'],
                ['50 lb','0.375 cu ft','72','Quikrete product specifications'],
                ['60 lb','0.45 cu ft','60','Quikrete product specifications'],
                ['80 lb','0.60 cu ft','45','Quikrete product specifications'],
              ].map(([b,y,bpy,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{b}</td><td class="p-2 border">{y}</td><td class="p-2 border">{bpy}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Default thickness: 4". Default waste: 10%. Post hole formula: π × r² × depth.</p>
        </div>

        <!-- Grass Seed -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Grass Seed</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Grass type</th>
              <th class="text-left p-2 border">New lawn (lbs/1,000 sq ft)</th>
              <th class="text-left p-2 border">Overseeding (lbs/1,000 sq ft)</th>
              <th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Tall Fescue','7','3.5','University extension service seeding guides'],
                ['Fine Fescue','4.5','2','University extension service seeding guides'],
                ['Kentucky Bluegrass','2.5','1.25','University extension service seeding guides'],
                ['Perennial Ryegrass','7','3.5','University extension service seeding guides'],
                ['Bermudagrass','1.5','0.75','University extension service seeding guides'],
                ['Zoysia','1.5','0.75','University extension service seeding guides'],
                ['Buffalograss','1.5','0.75','University extension service seeding guides'],
              ].map(([t,n,o,s]) => (
                <tr class="border-b">
                  <td class="p-2 border font-medium">{t}</td>
                  <td class="p-2 border">{n}</td>
                  <td class="p-2 border">{o}</td>
                  <td class="p-2 border text-gray-500">{s}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Default waste: 10%. Seeding rates assume good seed-to-soil contact. Confirm rates on your seed bag label.</p>
        </div>

        <!-- Paint -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Paint</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Standard paint coverage','350 sq ft/gallon/coat','Sherwin-Williams / Benjamin Moore manufacturer average'],
                ['Premium paint coverage','400 sq ft/gallon/coat','Manufacturer specification (high-hide formulas)'],
                ['Primer coverage','250 sq ft/gallon/coat','Manufacturer average (higher absorption)'],
                ['Textured surface coverage','275 sq ft/gallon/coat','Industry allowance for added surface area'],
                ['Default coats','2','Standard industry recommendation for full coverage'],
                ['Default waste','10%','Accounts for cut-in, roller waste, touch-ups'],
                ['Door area deduction','21 sq ft','Standard 3 × 7 ft interior door'],
                ['Window area deduction','15 sq ft','Standard 3 × 5 ft window'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Flooring -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Flooring</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Default box coverage','20 sq ft/box','Industry average for laminate/LVP; adjust per product label'],
                ['Waste — straight lay','10%','NWFA (National Wood Flooring Association) guidelines'],
                ['Waste — diagonal / complex','15%','NWFA guidelines for angled cuts'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Always confirm actual box coverage from the product label — it varies by manufacturer and product line.</p>
        </div>

        <!-- Tile -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Tile</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Tile size</th><th class="text-left p-2 border">Sq ft per tile</th><th class="text-left p-2 border">Notes</th>
            </tr></thead>
            <tbody>
              {[
                ['4" × 4"','0.111 sq ft',''],
                ['6" × 6"','0.250 sq ft',''],
                ['12" × 12"','1.000 sq ft','Most common'],
                ['18" × 18"','2.250 sq ft',''],
                ['24" × 24"','4.000 sq ft','Large format'],
                ['3" × 6" (subway)','0.125 sq ft',''],
                ['4" × 16" (subway)','0.444 sq ft',''],
              ].map(([s,f,n]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{s}</td><td class="p-2 border">{f}</td><td class="p-2 border text-gray-500">{n}</td></tr>
              ))}
            </tbody>
          </table>
          <div class="mt-2 text-xs text-gray-500 space-y-0.5">
            <p>Waste — straight lay: 10% · Diagonal: 15% (TCNA Handbook)</p>
            <p>Thinset: 1 bag (50 lb) covers ~40 sq ft at 3/8" notched trowel (manufacturer average)</p>
            <p>Grout: 1 bag (10 lb) covers ~50 sq ft, sanded, 1/8" joint, 12×12 tile</p>
          </div>
        </div>

        <!-- Drywall -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Drywall</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['4×8 sheet area','32 sq ft','Standard sheet dimensions'],
                ['4×12 sheet area','48 sq ft','Standard sheet dimensions'],
                ['4×16 sheet area','64 sq ft','Standard sheet dimensions'],
                ['Default waste','12%','GA-216 drywall installation standard allowance'],
                ['Joint compound (3 coats)','1 gal per 100 sq ft','USG product specification average'],
                ['Tape','1 roll (75 ft) per ~3 sheets','Industry standard'],
                ['Door area deduction','21 sq ft','Standard 3×7 ft door'],
                ['Window area deduction','15 sq ft','Standard 3×5 ft window'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Lumber -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Lumber</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Nominal size</th><th class="text-left p-2 border">Actual size</th><th class="text-left p-2 border">Board feet / 8-ft piece</th>
            </tr></thead>
            <tbody>
              {[
                ['2×4','1.5" × 3.5"','5.3 bf'],
                ['2×6','1.5" × 5.5"','8.0 bf'],
                ['2×8','1.5" × 7.25"','10.7 bf'],
                ['2×10','1.5" × 9.25"','13.3 bf'],
                ['2×12','1.5" × 11.25"','16.0 bf'],
                ['1×4','0.75" × 3.5"','2.7 bf'],
                ['1×6','0.75" × 5.5"','4.0 bf'],
                ['4×4','3.5" × 3.5"','10.7 bf'],
              ].map(([n,a,bf]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{n}</td><td class="p-2 border">{a}</td><td class="p-2 border">{bf}</td></tr>
              ))}
            </tbody>
          </table>
          <div class="mt-2 text-xs text-gray-500 space-y-0.5">
            <p>Board feet formula: (Thickness" × Width" × Length ft) ÷ 12</p>
            <p>Default waste: 10% · Stud spacing: 16" OC · Default wall height: 8 ft</p>
          </div>
        </div>

        <!-- Insulation -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Insulation</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Type</th>
              <th class="text-left p-2 border">R-value per inch</th>
              <th class="text-left p-2 border">Coverage per unit</th>
              <th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Fiberglass batts','R-3.2/in','40 sq ft per roll (R-13)','DOE / manufacturer specs'],
                ['Mineral wool (Rockwool)','R-3.8/in','40 sq ft per package','DOE / manufacturer specs'],
                ['Blown-in fiberglass','R-2.7/in','25 sq ft per 25 lb bag','DOE / manufacturer specs'],
                ['Blown-in cellulose','R-3.6/in','30 sq ft per 30 lb bag','DOE / manufacturer specs'],
                ['Spray foam (closed-cell)','R-6.5/in','Pro install — by board-ft','ASHRAE / DOE'],
              ].map(([t,r,c,s]) => (
                <tr class="border-b">
                  <td class="p-2 border font-medium">{t}</td>
                  <td class="p-2 border">{r}</td>
                  <td class="p-2 border">{c}</td>
                  <td class="p-2 border text-gray-500">{s}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="mt-2 text-xs text-gray-500 space-y-0.5">
            <p>Recommended R-values (ENERGY STAR): Attic R-49 · Wall R-21 · Crawlspace R-19 · Basement R-15</p>
            <p>Default waste buffer: 10%</p>
          </div>
        </div>

        <!-- Paver -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Pavers</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Paver size</th><th class="text-left p-2 border">Sq ft per paver</th><th class="text-left p-2 border">Pavers per 100 sq ft</th>
            </tr></thead>
            <tbody>
              {[
                ['4" × 8" (brick)','0.222','450'],
                ['6" × 6"','0.250','400'],
                ['6" × 9"','0.375','267'],
                ['12" × 12"','1.000','100'],
                ['16" × 16"','1.778','56'],
                ['12" × 24"','2.000','50'],
                ['24" × 24"','4.000','25'],
              ].map(([s,sf,p]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{s}</td><td class="p-2 border">{sf}</td><td class="p-2 border">{p}</td></tr>
              ))}
            </tbody>
          </table>
          <div class="mt-2 text-xs text-gray-500 space-y-0.5">
            <p>Default waste: 10% · Sand bedding: 1" depth · Gravel base: 4" depth</p>
            <p>Sand base formula: Area (sq ft) × 1/12 ÷ 27 = cubic yards</p>
          </div>
        </div>

        <!-- Fence -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Fence</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Post spacing','8 ft on-center','Standard residential fence spacing'],
                ['Posts','Linear ft ÷ 8 + 1 (+ 1 per gate)','Mathematical from spacing'],
                ['Concrete per post','2 bags (50 lb)','Standard for 4×4 post, 10–12" hole'],
                ['Rails (6 ft fence)','2 rails per section','Standard'],
                ['Rails (8 ft fence)','3 rails per section','Standard'],
                ['Pickets (6" wide wood)','Linear ft × 1.6 × 1.05 waste','Mathematical + 5% waste'],
                ['Chain link rolls','Linear ft ÷ 50 ft/roll','Standard roll length'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Deck -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Deck</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
              {[
                ['Decking waste','10%','Standard contractor allowance (NWFA)'],
                ['Joist spacing','16" OC','IRC standard residential framing'],
                ['Beam spacing','8 ft OC','Standard residential deck framing'],
                ['Footings per beam span','1 per 8 ft of beam','Standard'],
                ['Concrete bags per footing','1 bag (80 lb)','For standard 12" tube form'],
                ['Screws per board×joist','2','Standard face-screw pattern'],
              ].map(([c,v,s]) => (
                <tr class="border-b"><td class="p-2 border font-medium">{c}</td><td class="p-2 border">{v}</td><td class="p-2 border text-gray-500">{s}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-1">Check local building codes for footing depth (must go below frost line) and joist span tables before ordering materials.</p>
        </div>

        <!-- Asphalt -->
        <div>
          <h3 class="font-bold text-gray-900 mb-2">Asphalt</h3>
          <table class="w-full text-sm text-gray-700 border-collapse">
            <thead class="bg-gray-50"><tr>
              <th class="text-left p-2 border">Constant</th><th class="text-left p-2 border">Value</th><th class="text-left p-2 border">Source</th>
            </tr></thead>
            <tbody>
