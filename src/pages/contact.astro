---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — HomeMaterialCalc.com"
  description="Get in touch with HomeMaterialCalc.com. Report a calculation error, suggest a new material calculator, or ask a question."
>
  <div class="max-w-2xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-brand-600">Home</a> › <span class="text-gray-700">Contact</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-3">Contact Us</h1>
    <p class="text-gray-600 mb-8">
      Found a calculation error? Have a suggestion for a new material or feature?
      We read every message and respond to most within 1–2 business days.
    </p>

    <form id="contact-form" class="space-y-5">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
        <input type="text" id="name" name="name" required class="input-field" placeholder="Your name" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" id="email" name="email" required class="input-field" placeholder="you@example.com" />
      </div>
      <div>
        <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
        <select id="subject" name="subject" class="input-field">
          <option value="calculation-error">Calculation error or incorrect constant</option>
          <option value="suggestion">Suggestion or feature request</option>
          <option value="new-material">Request a new material calculator</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
        <textarea id="message" name="message" rows="5" required class="input-field resize-none"
          placeholder="Please describe the issue or suggestion in detail. For calculation errors, include the material, dimensions, and what result you expected."></textarea>
      </div>
      <button type="submit" id="contact-btn" class="btn-primary w-full">Send Message</button>
    </form>

    <div id="contact-success" class="hidden bg-green-50 border border-green-200 rounded-xl p-6 text-center">
      <div class="text-2xl mb-2">✅</div>
      <p class="font-semibold text-green-800">Message sent!</p>
      <p class="text-sm text-green-700 mt-1">We'll get back to you within 1–2 business days.</p>
    </div>

    <script>
      document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('contact-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Sending…';
        const fd = new FormData(e.target as HTMLFormElement);
        const data = {
          type: 'contact',
          name: fd.get('name'),
          email: fd.get('email'),
          subject: fd.get('subject'),
          message: fd.get('message'),
        };
        await fetch('/api/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        document.getElementById('contact-form')?.classList.add('hidden');
        document.getElementById('contact-success')?.classList.remove('hidden');
      });
    </script>

    <div class="mt-8 text-sm text-gray-500 space-y-1">
      <p><strong>Calculation errors:</strong> Please include the material, your dimensions, and the result you believe is incorrect.</p>
      <p><strong>New material requests:</strong> We're working on expanding the calculator library. Let us know what you need.</p>
    </div>
  </div>
</BaseLayout>
