---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MulchCalculator from '../../components/calculators/MulchCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';

const faqs = [
  { q: 'How much does mulch cost?', a: 'Bagged mulch typically costs $4–$8 per 2 cu ft bag at garden centers. Bulk mulch delivered runs $25–$55 per cubic yard depending on type and region.' },
  { q: 'Is bulk mulch cheaper than bagged?', a: 'Yes — for projects over 1.5 cubic yards (about 20 bags), bulk delivery is almost always cheaper. At $6/bag that\'s ~$81/cu yd vs. $35/cu yd in bulk — roughly half the cost.' },
  { q: 'How much does it cost to mulch 1,000 square feet?', a: 'At 3 inches deep you need about 9.3 cubic yards. At $6/bag (bagged): ~$750. At $40/cu yd bulk: ~$370. Prices vary by region and mulch type.' },
  { q: 'Does mulch cost include delivery?', a: 'Bulk mulch delivery typically adds $50–$150 per load depending on distance. Some suppliers offer free delivery above a minimum order (usually 3–5 yards). Enter your delivery fee in the calculator.' },
];
---

<BaseLayout
  title="Mulch Cost Calculator — Estimate Total Price | Free"
  description="Calculate your total mulch cost by entering bed size, depth, and local price per bag or cubic yard. Includes bulk vs. bag comparison and 2026 US price ranges."
>
  <Fragment slot="head">
    <CalcSchema
      name="Mulch Cost Calculator"
      description="Free mulch cost calculator — estimate bags, cubic yards, and total price"
      url="/calculator/mulch-cost"
      crumbs={[{ label: 'Landscaping Calculators', href: '/landscaping-calculators/' }, { label: 'Mulch Cost Calculator' }]}
      faqs={faqs}
    />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4 flex flex-wrap gap-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a><span>›</span>
      <a href="/landscaping-calculators/" class="hover:text-brand-600">Landscaping</a><span>›</span>
      <span class="text-gray-700">Mulch Cost Calculator</span>
    </nav>

    <div class="grid lg:grid-cols-[1fr_360px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Mulch Cost Calculator</h1>
        <p class="text-gray-600 mb-6">Enter your bed size, depth, and local price per bag or cubic yard to get your total cost estimate. Delivery fee optional.</p>

        <MulchCalculator client:load />
        <AdSlot slot="after-result" className="mt-6" />

        <!-- Cost breakdown -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How the cost is calculated</h2>
          <ol class="space-y-2 text-sm text-gray-700">
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">1.</span><span>Enter your bed dimensions and depth → the calculator outputs cubic yards and bags needed.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">2.</span><span>Enter your local price per bag <em>or</em> per cubic yard → material cost = quantity × unit price.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">3.</span><span>Add an optional delivery fee → total cost = material cost + delivery.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">4.</span><span>Cost per square foot = total cost ÷ area (useful for comparing quotes).</span></li>
          </ol>
        </div>

        <!-- Price reference -->
        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-3">2026 US mulch price ranges</h2>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-2 font-semibold">Product</th><th class="text-right pb-2 font-semibold">Typical price</th></tr></thead>
            <tbody class="divide-y">
              {[
                ['2 cu ft bag (store)','$4–$8'],
                ['Bulk delivery (per cu yd)','$25–$55'],
                ['Premium dyed mulch (bag)','$6–$10'],
                ['Cedar mulch (bag)','$7–$12'],
                ['Delivery fee','$50–$150'],
              ].map(([p,v]) => (
                <tr><td class="py-1.5">{p}</td><td class="py-1.5 text-right font-medium">{v}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Prices vary by region and season. Enter your actual price for an accurate estimate.</p>
        </div>

        <!-- FAQ -->
        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map(f => (
              <div>
                <h3 class="font-semibold text-gray-900 text-sm mb-1">{f.q}</h3>
                <p class="text-sm text-gray-700">{f.a}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          Just need the quantity? → <a href="/calculator/mulch/" class="text-brand-600 hover:underline">Mulch Calculator</a> ·
          <a href="/guide/how-much-mulch-do-i-need/" class="text-brand-600 hover:underline">How Much Mulch Do I Need?</a> ·
          <a href="/guide/how-much-does-mulch-cost/" class="text-brand-600 hover:underline">Mulch Cost Guide</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Bags vs. bulk</h3>
          <p class="text-sm text-gray-700">For projects over 1.5 cubic yards (~20 bags), bulk delivery is almost always cheaper. At $6/bag that's $81/cu yd vs. $35/cu yd bulk.</p>
        </div>
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/calculator/mulch/" class="text-brand-600 hover:underline">Mulch Calculator (quantity only)</a></li>
            <li><a href="/calculator/topsoil-cost/" class="text-brand-600 hover:underline">Topsoil Cost Calculator</a></li>
            <li><a href="/calculator/gravel-cost/" class="text-brand-600 hover:underline">Gravel Cost Calculator</a></li>
            <li><a href="/calculator/sand-cost/" class="text-brand-600 hover:underline">Sand Cost Calculator</a></li>
          </ul>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
