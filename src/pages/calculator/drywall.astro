---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DrywallCalculator from '../../components/calculators/DrywallCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
const related = [
  { href: '/calculator/paint',    label: 'Paint Calculator' },
  { href: '/calculator/tile',     label: 'Tile Calculator' },
  { href: '/guide/how-much-drywall-do-i-need', label: 'How Much Drywall Do I Need?' },
];
---
<BaseLayout
  title="Drywall Calculator — Sheets, Joint Compound &amp; Tape"
  description="Free drywall calculator: enter room dimensions or wall area to get sheet count, joint compound gallons, and tape rolls. Supports 4×8, 4×12, and 4×16 sheets."
>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Drywall Calculator</h1>
        <p class="text-gray-600 mb-6">Calculate drywall sheets, joint compound, and tape needed for any room — with door and window deductions.</p>
        <DrywallCalculator client:load />
        <AdSlot slot="after-result" className="mt-6" />
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How to measure for drywall</h2>
          <ol class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">1.</span>
              <span><strong>Measure all walls:</strong> For each wall, measure length × height. Add them all together for total wall area.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">2.</span>
              <span><strong>Add the ceiling:</strong> If drywalling the ceiling too, add length × width of the room to your wall area.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">3.</span>
              <span><strong>Count openings:</strong> Subtract standard doors (21 sq ft) and windows (15 sq ft). Don't over-deduct — you'll use the cutoffs for other spots.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">4.</span>
              <span><strong>Sheet size tip:</strong> 4×12 sheets mean fewer seams and a smoother finish, but are heavier and harder to maneuver alone.</span></li>
          </ol>
        </div>
        <AdSlot slot="in-content" className="mt-6" />
        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Sheets = ceil(net area × 1.12 ÷ sheet sq ft). Joint compound: 1 gal/100 sq ft (3 coats, USG avg).
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a>.</p>
        </div>
      </div>
      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Sheet sizes</h3>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Sheet</th><th class="text-right pb-1">Sq ft</th></tr></thead>
            <tbody class="divide-y">
              {[['4 × 8 ft','32'],['4 × 12 ft','48'],['4 × 16 ft','64']].map(([s,f]) => (
                <tr><td class="py-1">{s}</td><td class="py-1 text-right">{f}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Default waste: 12%</p>
        </div>
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (<li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>))}
          </ul>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
