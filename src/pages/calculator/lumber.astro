---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LumberCalculator from '../../components/calculators/LumberCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';

const related = [
  { href: '/calculator/lumber-cost/', label: '💰 Lumber Cost' },

  { href: '/guide/how-much-lumber-do-i-need/',   label: 'How Much Lumber Do I Need?' },
  { href: '/guide/linear-feet-to-square-feet/',   label: 'Linear Feet to Square Feet' },
  { href: '/calculator/concrete/',                label: 'Concrete Calculator' },
  { href: '/calculator/drywall/',                 label: 'Drywall Calculator' },
  { href: '/calculator/paint/',                   label: 'Paint Calculator' },
];
---

<BaseLayout
  title="Lumber Calculator — Board Feet & Cost Estimator | Free"
  description="Free lumber calculator: enter piece count, nominal size, and length to get total board feet and cost estimate. Works for framing, decking, and all carpentry projects."
>

  <Fragment slot="head">
    <CalcSchema name="Lumber Calculator" crumbs={[{ label: "Interior Calculators", href: "/interior-calculators" }, { label: "Lumber Calculator" }]} description="Free lumber calculator for board feet and cost" url="/calculator/lumber" />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How do I calculate board feet of lumber?", "acceptedAnswer": {"@type": "Answer", "text": "Board feet = (Thickness in inches \u00d7 Width in inches \u00d7 Length in feet) \u00f7 12. For example, a 2\u00d76 that is 8 feet long = (2 \u00d7 6 \u00d7 8) \u00f7 12 = 8 board feet."}}, {"@type": "Question", "name": "How much lumber do I need to frame a wall?", "acceptedAnswer": {"@type": "Answer", "text": "For a 10 ft wall at 16-inch stud spacing: about 8 studs + 30 linear feet of plate lumber (2 bottom plates + 1 top plate). Add 10\u201315% waste for corners and openings."}}, {"@type": "Question", "name": "What is the actual size of a 2\u00d74?", "acceptedAnswer": {"@type": "Answer", "text": "A nominal 2\u00d74 is actually 1.5 inches \u00d7 3.5 inches. The nominal size is the rough-cut size; the actual size is smaller after drying and planing. Always use actual dimensions for coverage calculations."}}, {"@type": "Question", "name": "How many board feet do I need for a deck?", "acceptedAnswer": {"@type": "Answer", "text": "For a 12\u00d716 ft deck (192 sq ft), plan for 400\u2013600 board feet of decking boards plus framing lumber. Add 10\u201315% for waste and spacing gaps between boards."}}]})} />
    <CalcBreadcrumbs crumbs={[{ label: "Interior Calculators", href: "/interior-calculators" }, { label: "Lumber Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">

      <!-- Left: calculator -->
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Lumber Calculator</h1>
        <p class="text-gray-600 mb-6">Enter the number of pieces, nominal size (2×4, 2×6, etc.), and length to calculate total board feet and your project cost.</p>

        <LumberCalculator client:load />

        <AdSlot slot="after-result" className="mt-6" />

        <!-- How board feet work -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How board feet are calculated</h2>
          <p class="text-sm text-gray-700 mb-3">
            <strong>Board feet = (Thickness × Width × Length) ÷ 12</strong><br/>
            All dimensions in inches × inches × feet.
          </p>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Size</th><th class="text-right pb-1">bf per 8-ft piece</th><th class="text-right pb-1">bf per 12-ft piece</th></tr></thead>
            <tbody class="divide-y">
              {[
                { size: '2×4', bf8: '5.3', bf12: '8.0' },
                { size: '2×6', bf8: '8.0', bf12: '12.0' },
                { size: '2×8', bf8: '10.7', bf12: '16.0' },
                { size: '2×10', bf8: '13.3', bf12: '20.0' },
                { size: '1×6', bf8: '4.0', bf12: '6.0' },
              ].map(r => (
                <tr>
                  <td class="py-1">{r.size}</td>
                  <td class="py-1 text-right">{r.bf8}</td>
                  <td class="py-1 text-right">{r.bf12}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- FAQ -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-1">Frequently Asked Questions</h2>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How do I calculate board feet of lumber?</h3>
          <p class="text-sm text-gray-700">Board feet = (Thickness in inches × Width in inches × Length in feet) ÷ 12. For example, a 2×6 that is 8 feet long = (2 × 6 × 8) ÷ 12 = 8 board feet.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How much lumber do I need to frame a wall?</h3>
          <p class="text-sm text-gray-700">For a 10 ft wall at 16-inch stud spacing: about 8 studs + 30 linear feet of plate lumber (2 bottom plates + 1 top plate). Add 10–15% waste for corners and openings.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">What is the actual size of a 2×4?</h3>
          <p class="text-sm text-gray-700">A nominal 2×4 is actually 1.5 inches × 3.5 inches. The nominal size is the rough-cut size; the actual size is smaller after drying and planing. Always use actual dimensions for coverage calculations.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many board feet do I need for a deck?</h3>
          <p class="text-sm text-gray-700">For a 12×16 ft deck (192 sq ft), plan for 400–600 board feet of decking boards plus framing lumber. Add 10–15% for waste and spacing gaps between boards.</p>
        </div>
        </div>
        <AdSlot slot="in-content" className="mt-6" />

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Formula: <em>Board feet = (Thickness" × Width" × Length ft) ÷ 12. Waste applied to total board feet.</em>
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a> for all constants.</p>
        </div>
      </div>

      <!-- Right: sidebar -->
      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Nominal vs. actual size</h3>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Nominal</th><th class="text-right pb-1">Actual</th></tr></thead>
            <tbody class="divide-y">
              {[
                { nom: '2×4', act: '1.5" × 3.5"' },
                { nom: '2×6', act: '1.5" × 5.5"' },
                { nom: '2×8', act: '1.5" × 7.25"' },
                { nom: '1×6', act: '0.75" × 5.5"' },
                { nom: '4×4', act: '3.5" × 3.5"' },
              ].map(r => (
                <tr><td class="py-1">{r.nom}</td><td class="py-1 text-right">{r.act}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (
              <li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>
            ))}
          </ul>
        </div>

        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
