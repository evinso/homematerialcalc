---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FenceCalculator from '../../components/calculators/FenceCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';

const faqs = [
  { q: 'How much does a fence cost?', a: 'Fence materials cost $10–$75 per linear foot depending on material: wood privacy fence $15–$35/ft, vinyl $20–$40/ft, aluminum $20–$35/ft, chain link $8–$20/ft. Installed with labor, add $10–$30/ft.' },
  { q: 'How much does a 6 ft privacy fence cost?', a: 'For 100 linear feet of 6 ft wood privacy fence, materials cost $1,500–$3,500. Professionally installed, expect $3,000–$7,000 total depending on region and post spacing.' },
  { q: 'What\'s the cheapest fence option?', a: 'Chain link is typically the cheapest at $8–$20/ft installed. Split rail wood fence is next at $10–$20/ft. Both are durable but offer less privacy than board-on-board or vinyl options.' },
  { q: 'Does fence cost include posts and hardware?', a: 'Our calculator includes post count, rails, pickets, and post caps. Concrete for post holes adds $2–$4 per post (2 bags of 60 lb Quikrete each). Gates cost $100–$400 each extra.' },
];
---

<BaseLayout
  title="Fence Cost Calculator — Posts, Boards & Total Price | Free"
  description="Calculate total fence cost by entering fence length and local price per linear foot or per material. 2026 US price ranges for wood, vinyl, and chain link fencing."
>
  <Fragment slot="head">
    <CalcSchema
      name="Fence Cost Calculator"
      description="Free fence cost calculator — estimate posts, boards, and total fencing price"
      url="/calculator/fence-cost"
      crumbs={[{ label: 'Calculators', href: '/' }, { label: 'Fence Cost Calculator' }]}
      faqs={faqs}
    />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4 flex flex-wrap gap-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a><span>›</span>
      <span class="text-gray-700">Fence Cost Calculator</span>
    </nav>

    <div class="grid lg:grid-cols-[1fr_360px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Fence Cost Calculator</h1>
        <p class="text-gray-600 mb-6">Enter your fence length and local material price to estimate total fence cost including posts, rails, and pickets.</p>

        <FenceCalculator client:load />
        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How the cost is calculated</h2>
          <ol class="space-y-2 text-sm text-gray-700">
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">1.</span><span>Enter fence length and style → calculator outputs posts, rails, and pickets needed.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">2.</span><span>Enter your price per linear foot or per material piece → material cost calculated.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">3.</span><span>Add concrete, hardware, and gate costs → total materials estimate.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">4.</span><span>Cost per linear foot = total ÷ fence length.</span></li>
          </ol>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-3">2026 US fence price ranges</h2>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-2 font-semibold">Fence type</th><th class="text-right pb-2 font-semibold">Per linear ft (installed)</th></tr></thead>
            <tbody class="divide-y">
              {[['Chain link (4 ft)','$8–$20'],['Wood privacy (6 ft)','$15–$40'],['Split rail (2 rail)','$10–$22'],['Vinyl privacy','$20–$45'],['Aluminum (4 ft)','$20–$35'],['Gate (per gate)','$100–$400']].map(([p,v]) => (
                <tr><td class="py-1.5">{p}</td><td class="py-1.5 text-right font-medium">{v}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Prices vary by region. Enter your actual price for an accurate estimate.</p>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map(f => (
              <div><h3 class="font-semibold text-gray-900 text-sm mb-1">{f.q}</h3><p class="text-sm text-gray-700">{f.a}</p></div>
            ))}
          </div>
        </div>

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          Just need the quantity? → <a href="/calculator/fence/" class="text-brand-600 hover:underline">Fence Calculator</a> ·
          <a href="/calculator/concrete-cost/" class="text-brand-600 hover:underline">Concrete Cost Calculator</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/calculator/fence/" class="text-brand-600 hover:underline">Fence Calculator (quantity only)</a></li>
            <li><a href="/calculator/deck-cost/" class="text-brand-600 hover:underline">Deck Cost Calculator</a></li>
            <li><a href="/calculator/concrete-cost/" class="text-brand-600 hover:underline">Concrete Cost Calculator</a></li>
          </ul>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
