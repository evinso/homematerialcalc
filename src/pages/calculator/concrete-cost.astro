---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConcreteCalculator from '../../components/calculators/ConcreteCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';
---

<BaseLayout
  title="Concrete Cost Calculator — Estimate Your Total Project Cost"
  description="Free concrete cost calculator: enter your slab size, thickness, and price per bag or cubic yard to estimate total concrete cost."
>
  <Fragment slot="head">
    <CalcSchema name="Concrete Cost Calculator" crumbs={[{ label: "Concrete Calculators", href: "/concrete-calculators" }, { label: "Concrete Cost Calculator" }]} description="Free concrete cost calculator: enter your slab size, thickness, and price per bag or cubic yard to estimate total concrete cost." url="/calculator/concrete-cost" />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4 flex gap-1">
      <a href="/" class="hover:text-brand-600">Home</a><span>›</span>
      <a href="/concrete-calculators" class="hover:text-brand-600">Concrete</a><span>›</span>
      <span class="text-gray-700">Concrete Cost Calculator</span>
    </nav>
    <CalcBreadcrumbs crumbs={[{ label: "Concrete Calculators", href: "/concrete-calculators" }, { label: "Concrete Cost Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_360px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Concrete Cost Calculator</h1>
        <p class="text-gray-600 mb-2">Enter your project dimensions and local price per bag to calculate your total concrete cost.</p>
        <p class="text-sm text-gray-500 mb-6" set:html="Enter your price in the <strong>"Price per bag"</strong> field to get a cost estimate."></p>

        <ConcreteCalculator client:load />
        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">Typical prices (US)</h2>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Product</th><th class="text-right pb-1">Typical price</th></tr></thead>
            <tbody class="divide-y">
              <tr><td class="py-1.5">80 lb bag (Quikrete)</td><td class="py-1.5 text-right font-medium">$5–$7</td></tr>
              <tr><td class="py-1.5">60 lb bag</td><td class="py-1.5 text-right font-medium">$4–$6</td></tr>
              <tr><td class="py-1.5">Ready-mix (per cu yd)</td><td class="py-1.5 text-right font-medium">$130–$175</td></tr>
              <tr><td class="py-1.5">Fiber additive (bag)</td><td class="py-1.5 text-right font-medium">$8–$15</td></tr>
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Prices vary by region. Enter your actual local price above for an accurate estimate.</p>
        </div>

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          Quantity-only? Use the <a href="/calculator/concrete" class="text-brand-600 hover:underline">Concrete Calculator</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/calculator/concrete" class="text-brand-600 hover:underline">Concrete Calculator (quantity only)</a></li>
            <li><a href="/guide/how-much-concrete-do-i-need" class="text-brand-600 hover:underline">How Much Concrete Do I Need?</a></li>
            <li><a href="/guide/how-thick-should-concrete-slab-be" class="text-brand-600 hover:underline">How Thick Should Concrete Be?</a></li>
            <li><a href="/guide/concrete-mix-ratios" class="text-brand-600 hover:underline">Concrete Mix Ratios</a></li>
          </ul>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
