---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConcreteCalculator from '../../components/calculators/ConcreteCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';

const faqs = [
  { q: 'How much does concrete cost?', a: 'Bagged concrete costs $4–$7 per 80 lb bag. Ready-mix concrete runs $120–$160 per cubic yard delivered. A 10×10 ft slab at 4 inches needs about 1.2 cu yd — roughly $150–$190 in ready-mix.' },
  { q: 'Is ready-mix cheaper than bags?', a: 'For projects over 1 cubic yard (≈ 45 bags of 80 lb), ready-mix is almost always cheaper. At $6/bag that\'s $270/cu yd vs. $120–$160/cu yd ready-mix.' },
  { q: 'How much does a concrete slab cost installed?', a: 'Professional concrete installation (including labor) runs $4–$8 per sq ft for a standard 4-inch slab, or $6–$12/sq ft for colored or stamped concrete.' },
  { q: 'Does concrete cost include delivery?', a: 'Ready-mix concrete includes delivery within a local radius, but suppliers charge a short-load fee ($100–$300) for orders under 3–4 cubic yards. Factor this in for small projects.' },
];
---

<BaseLayout
  title="Concrete Cost Calculator — Bags & Ready-Mix Estimate | Free"
  description="Calculate total concrete cost by entering slab dimensions, thickness, and local price per bag or cubic yard. Includes 2026 US price ranges and bags vs. ready-mix comparison."
>
  <Fragment slot="head">
    <CalcSchema
      name="Concrete Cost Calculator"
      description="Free concrete cost calculator — estimate bags, cubic yards, and total price"
      url="/calculator/concrete-cost"
      crumbs={[{ label: 'Concrete Calculators', href: '/concrete-calculators/' }, { label: 'Concrete Cost Calculator' }]}
      faqs={faqs}
    />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4 flex flex-wrap gap-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a><span>›</span>
      <a href="/concrete-calculators/" class="hover:text-brand-600">Concrete</a><span>›</span>
      <span class="text-gray-700">Concrete Cost Calculator</span>
    </nav>

    <div class="grid lg:grid-cols-[1fr_360px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Concrete Cost Calculator</h1>
        <p class="text-gray-600 mb-6">Enter your slab dimensions, thickness, and local price per bag or per cubic yard to estimate your total concrete cost.</p>

        <ConcreteCalculator client:load />
        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How the cost is calculated</h2>
          <ol class="space-y-2 text-sm text-gray-700">
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">1.</span><span>Enter dimensions and thickness → calculator outputs cubic yards and bags needed.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">2.</span><span>Enter your price per bag or per cubic yard → material cost = quantity × price.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">3.</span><span>Add optional delivery or short-load fee → total = material + fees.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">4.</span><span>Cost per square foot = total ÷ area (compare to contractor quotes).</span></li>
          </ol>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-3">2026 US concrete price ranges</h2>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-2 font-semibold">Product</th><th class="text-right pb-2 font-semibold">Typical price</th></tr></thead>
            <tbody class="divide-y">
              {[['80 lb bag','$4–$7'],['60 lb bag','$3.50–$6'],['40 lb bag','$2.50–$5'],['Ready-mix (per cu yd)','$120–$160'],['Short-load fee','$100–$300'],['Installed (per sq ft)','$4–$8']].map(([p,v]) => (
                <tr><td class="py-1.5">{p}</td><td class="py-1.5 text-right font-medium">{v}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Prices vary by region. Enter your actual price for an accurate estimate.</p>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map(f => (
              <div><h3 class="font-semibold text-gray-900 text-sm mb-1">{f.q}</h3><p class="text-sm text-gray-700">{f.a}</p></div>
            ))}
          </div>
        </div>

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          Just need the quantity? → <a href="/calculator/concrete/" class="text-brand-600 hover:underline">Concrete Calculator</a> ·
          <a href="/guide/how-much-concrete-do-i-need/" class="text-brand-600 hover:underline">How Much Concrete Do I Need?</a> ·
          <a href="/guide/how-much-does-concrete-cost/" class="text-brand-600 hover:underline">Concrete Cost Guide</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/calculator/concrete/" class="text-brand-600 hover:underline">Concrete Calculator (quantity only)</a></li>
            <li><a href="/calculator/fence/" class="text-brand-600 hover:underline">Fence Calculator</a></li>
            <li><a href="/calculator/deck/" class="text-brand-600 hover:underline">Deck Calculator</a></li>
            <li><a href="/guide/how-thick-should-concrete-slab-be/" class="text-brand-600 hover:underline">How Thick Should a Slab Be?</a></li>
          </ul>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
