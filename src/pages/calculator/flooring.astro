---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlooringCalculator from '../../components/calculators/FlooringCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import WhereToBuy from '../../components/ui/WhereToBuy.astro';
import ResultActions from '../../components/ui/ResultActions.astro';
import UsageStats from '../../components/ui/UsageStats.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';
const related = [
  { href: '/calculator/flooring-cost/', label: '💰 Flooring Cost' },

  { href: '/calculator/tile/',    label: 'Tile Calculator' },
  { href: '/calculator/paint/',   label: 'Paint Calculator' },
  { href: '/calculator/drywall/', label: 'Drywall Calculator' },
  { href: '/guide/how-much-flooring-do-i-need/', label: 'How Much Flooring Do I Need?' },
];
---
<BaseLayout
  title="Flooring Calculator — Boxes of Laminate, LVP or Hardwood | Free"
  description="Free flooring calculator: enter room size, box coverage, and lay pattern to get exact box count with waste factor. Works for laminate, vinyl plank, and hardwood."
>

  <Fragment slot="head">
    <CalcSchema name="Flooring Calculator" crumbs={[{ label: "Interior Calculators", href: "/interior-calculators" }, { label: "Flooring Calculator" }]} description="Free flooring calculator for square feet, boxes and cost" url="/calculator/flooring" />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How many boxes of flooring do I need for a 12\u00d712 room?", "acceptedAnswer": {"@type": "Answer", "text": "A 12\u00d712 ft room (144 sq ft) with 10% waste needs 158 sq ft of flooring. If each box covers 20 sq ft, you need 8 boxes. If 25 sq ft per box: 7 boxes."}}, {"@type": "Question", "name": "How much extra flooring should I buy for waste?", "acceptedAnswer": {"@type": "Answer", "text": "Buy 10% extra for straight-lay patterns and 15% extra for diagonal patterns. Always buy from the same dye lot to ensure color consistency."}}, {"@type": "Question", "name": "How do I calculate flooring for a room?", "acceptedAnswer": {"@type": "Answer", "text": "Measure length \u00d7 width in feet to get square footage. Add 10% for waste. Divide by box coverage (found on the box label) and round up to whole boxes."}}, {"@type": "Question", "name": "What is the waste factor for diagonal flooring?", "acceptedAnswer": {"@type": "Answer", "text": "Diagonal (45\u00b0) flooring patterns require 15% extra material for cuts. Straight-lay and running-bond patterns need 10% extra. Always round up to full boxes."}}]})} />
    <CalcBreadcrumbs crumbs={[{ label: "Interior Calculators", href: "/interior-calculators" }, { label: "Flooring Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Flooring Calculator</h1>
        <UsageStats material="flooring" />
        <p class="text-gray-600 mb-6">Enter your room dimensions and the square footage per box to find out how many boxes of flooring to buy, with the right waste factor for your lay pattern.</p>
        <FlooringCalculator client:load />
        <ResultActions />
        <AdSlot slot="after-result" className="mt-6" />
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How to measure for flooring</h2>
          <ol class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">1.</span>
              <span><strong>Measure the room:</strong> Length × width in feet for rectangular rooms. Use the Irregular option for L-shaped or complex rooms.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">2.</span>
              <span><strong>Find box coverage:</strong> Check the box label or product page. This is listed as "covers X sq ft" or "sq ft per carton."</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">3.</span>
              <span><strong>Choose your pattern:</strong> Straight lay = 10% waste. Diagonal or complex rooms = 15%. The waste accounts for cuts at walls and obstacles.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">4.</span>
              <span><strong>Don't return leftovers:</strong> Most stores allow returns of unopened boxes. Keep 1 extra box for future repairs.</span></li>
          </ol>
        </div>
        <!-- FAQ -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-1">Frequently Asked Questions</h2>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many boxes of flooring do I need for a 12×12 room?</h3>
          <p class="text-sm text-gray-700">A 12×12 ft room (144 sq ft) with 10% waste needs 158 sq ft of flooring. If each box covers 20 sq ft, you need 8 boxes. If 25 sq ft per box: 7 boxes.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How much extra flooring should I buy for waste?</h3>
          <p class="text-sm text-gray-700">Buy 10% extra for straight-lay patterns and 15% extra for diagonal patterns. Always buy from the same dye lot to ensure color consistency.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How do I calculate flooring for a room?</h3>
          <p class="text-sm text-gray-700">Measure length × width in feet to get square footage. Add 10% for waste. Divide by box coverage (found on the box label) and round up to whole boxes.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">What is the waste factor for diagonal flooring?</h3>
          <p class="text-sm text-gray-700">Diagonal (45°) flooring patterns require 15% extra material for cuts. Straight-lay and running-bond patterns need 10% extra. Always round up to full boxes.</p>
        </div>
        </div>
        <AdSlot slot="in-content" className="mt-6" />
        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Formula: <em>Boxes = ceil(Area × (1 + waste%) ÷ box coverage).</em>
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a>.</p>
        </div>
      </div>
      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Common box coverages</h3>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Product type</th><th class="text-right pb-1">Typical coverage</th></tr></thead>
            <tbody class="divide-y">
              {[['Vinyl plank (LVP)','20–23 sq ft'],['Laminate','20–25 sq ft'],['Engineered hardwood','15–25 sq ft'],].map(([t,c]) => (
                <tr><td class="py-1">{t}</td><td class="py-1 text-right">{c}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Always use the number on your specific product label.</p>
        </div>
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (<li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>))}
          </ul>
        </div>
        <WhereToBuy material="flooring" />
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
