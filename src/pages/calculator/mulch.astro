---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MulchCalculator from '../../components/calculators/MulchCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import WhereToBuy from '../../components/ui/WhereToBuy.astro';
import ResultActions from '../../components/ui/ResultActions.astro';
import UsageStats from '../../components/ui/UsageStats.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';

const related = [
  { href: '/calculator/mulch-cost/', label: '💰 Mulch Cost' },

  { href: '/calculator/topsoil/',  label: 'Topsoil Calculator' },
  { href: '/calculator/gravel/',   label: 'Gravel Calculator' },
  { href: '/calculator/sod/',      label: 'Sod Calculator' },
  { href: '/guide/how-much-mulch-do-i-need/', label: 'How Much Mulch Do I Need?' },
  { href: '/guide/how-many-bags-of-mulch-in-a-cubic-yard/', label: 'Bags of Mulch per Cubic Yard' },
];
---

<BaseLayout
  title="Mulch Calculator — Bags, Cubic Yards & Cost | Free"
  description="Free mulch calculator: enter bed size and depth to get exact bag count, cubic yards, and cost estimate. Covers 2 cu ft bags, bulk yards, and all depths."
>

  <Fragment slot="head">
    <CalcSchema name="Mulch Calculator" crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Mulch Calculator" }]} description="Free mulch calculator for bags, cubic yards and cost" url="/calculator/mulch" lastUpdated="2026-06-09" />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How many bags of mulch do I need for 100 square feet?", "acceptedAnswer": {"@type": "Answer", "text": "At 3 inches deep, 100 sq ft needs 0.93 cubic yards \u2014 about 13 bags of 2 cu ft mulch. Round up to 14. At 2 inches: 9 bags. The Mulch Calculator computes this instantly for any size."}}, {"@type": "Question", "name": "How deep should I apply mulch?", "acceptedAnswer": {"@type": "Answer", "text": "Apply 2\u20133 inches for existing beds, 3\u20134 inches for new beds or heavy weed suppression. Never pile mulch more than 4 inches deep or against plant stems."}}, {"@type": "Question", "name": "How many bags of mulch are in a cubic yard?", "acceptedAnswer": {"@type": "Answer", "text": "There are 13.5 standard 2-cubic-foot bags in one cubic yard. If you need more than 2\u20133 yards, bulk delivery is usually cheaper than buying bags."}}, {"@type": "Question", "name": "How much does a cubic yard of mulch cover?", "acceptedAnswer": {"@type": "Answer", "text": "At 3 inches deep, 1 cubic yard covers 108 sq ft. At 2 inches: 162 sq ft. At 1 inch: 324 sq ft."}}]})} />
    <CalcBreadcrumbs crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Mulch Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">

      <!-- Left: calculator -->
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Mulch Calculator</h1>
        <UsageStats material="mulch" />

        <p class="text-xs text-gray-400 mb-4">Last updated: <time datetime="2026-06-09">June 2026</time> · Prices verified</p>
        <p class="text-gray-600 mb-6">Enter your garden bed dimensions and depth to find out how many bags or cubic yards of mulch to buy.</p>

        <MulchCalculator client:load />

        <ResultActions />
        <AdSlot slot="after-result" className="mt-6" />

        <!-- How to measure -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How to measure your space</h2>
          <ol class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">1.</span>
              <span><strong>Rectangle beds:</strong> Walk the length and width with a tape measure. Record in feet and inches.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">2.</span>
              <span><strong>Curved or odd-shaped beds:</strong> Break the area into rough rectangles, measure each, and use the "Irregular" shape option to add them together.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">3.</span>
              <span><strong>Depth:</strong> Use a ruler to check existing mulch depth. For a new bed, 2–3" is standard; for heavy weed suppression, use 3–4".</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">4.</span>
              <span><strong>Subtract obstacles:</strong> Deduct space taken by large plants, stones, or hardscape — or just leave the small ones in and let the 5% waste factor cover it.</span>
            </li>
          </ol>
        </div>

        <!-- FAQ -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-1">Frequently Asked Questions</h2>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many bags of mulch do I need for 100 square feet?</h3>
          <p class="text-sm text-gray-700">At 3 inches deep, 100 sq ft needs 0.93 cubic yards — about 13 bags of 2 cu ft mulch. Round up to 14. At 2 inches: 9 bags. The Mulch Calculator computes this instantly for any size.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How deep should I apply mulch?</h3>
          <p class="text-sm text-gray-700">Apply 2–3 inches for existing beds, 3–4 inches for new beds or heavy weed suppression. Never pile mulch more than 4 inches deep or against plant stems.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many bags of mulch are in a cubic yard?</h3>
          <p class="text-sm text-gray-700">There are 13.5 standard 2-cubic-foot bags in one cubic yard. If you need more than 2–3 yards, bulk delivery is usually cheaper than buying bags.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How much does a cubic yard of mulch cover?</h3>
          <p class="text-sm text-gray-700">At 3 inches deep, 1 cubic yard covers 108 sq ft. At 2 inches: 162 sq ft. At 1 inch: 324 sq ft.</p>
        </div>
        </div>
        <AdSlot slot="in-content" className="mt-6" />

        <!-- Methodology note -->
        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Formula: <em>Volume (cu ft) = Area (sq ft) × Depth (in) ÷ 12. Bags = Volume (cu yd) × 13.5, rounded up.</em>
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a> for all constants and sources.</p>
        </div>
      </div>

      <!-- Right: sidebar -->
      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Quick reference</h3>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Depth</th><th class="text-right pb-1">Coverage / cu yd</th></tr></thead>
            <tbody class="divide-y">
              {[{d:'1"',c:'324 sq ft'},{d:'2"',c:'162 sq ft'},{d:'3"',c:'108 sq ft'},{d:'4"',c:'81 sq ft'},{d:'6"',c:'54 sq ft'}].map(r => (
                <tr><td class="py-1">{r.d}</td><td class="py-1 text-right">{r.c}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">1 cu yd = 13.5 bags of 2 cu ft mulch</p>
        </div>

        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (
              <li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>
            ))}
          </ul>
        </div>

        <WhereToBuy material="mulch" />
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
