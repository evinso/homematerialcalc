---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaverCalculator from '../../components/calculators/PaverCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import WhereToBuy from '../../components/ui/WhereToBuy.astro';
import ResultActions from '../../components/ui/ResultActions.astro';
import UsageStats from '../../components/ui/UsageStats.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';

const related = [
  { href: '/calculator/paver-cost/', label: '💰 Paver Cost' },

  { href: '/guide/how-many-pavers-do-i-need/',     label: 'How Many Pavers Do I Need?' },
  { href: '/guide/how-much-sand-for-paver-base/',   label: 'How Much Sand for a Paver Base?' },
  { href: '/calculator/sand/',                      label: 'Sand Calculator' },
  { href: '/calculator/gravel/',                    label: 'Gravel Calculator' },
  { href: '/guide/gravel-vs-crushed-stone/',        label: 'Gravel vs Crushed Stone' },
];
---

<BaseLayout
  title="Paver Calculator — Count, Sand Base & Gravel Base | Free"
  description="Free paver calculator: enter patio or walkway dimensions and paver size to get exact paver count, sand bedding, and gravel base quantities."
>

  <Fragment slot="head">
    <CalcSchema name="Paver Calculator" crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Paver Calculator" }]} description="Free paver calculator for patio paver count and cost" url="/calculator/paver" lastUpdated="2026-06-09" />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How many pavers do I need for a 10\u00d710 patio?", "acceptedAnswer": {"@type": "Answer", "text": "A 10\u00d710 ft patio (100 sq ft) with 10% waste needs: about 110 pieces of 12\u00d712 pavers, 495 pieces of 4\u00d78 brick pavers, or 62 pieces of 16\u00d716 pavers."}}, {"@type": "Question", "name": "How much sand do I need under pavers?", "acceptedAnswer": {"@type": "Answer", "text": "Use a 1-inch sand bedding layer. For 100 sq ft of patio: 0.31 cubic yards or about 17 bags of 50 lb sand. The Paver Calculator shows this automatically alongside the paver count."}}, {"@type": "Question", "name": "How deep should the gravel base be under pavers?", "acceptedAnswer": {"@type": "Answer", "text": "4 inches of compacted gravel for a patio or walkway, 6\u20138 inches for a driveway. Compact in 2-inch lifts with a plate compactor before adding the sand bedding layer."}}, {"@type": "Question", "name": "What is the best paver size for a patio?", "acceptedAnswer": {"@type": "Answer", "text": "12\u00d724 inch pavers are the most popular for modern patios \u2014 fewer grout lines and a sleek look. 12\u00d712 inch pavers are classic and forgiving to lay. 4\u00d78 brick pavers create a traditional look."}}]})} />
    <CalcBreadcrumbs crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Paver Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">

      <!-- Left: calculator -->
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Paver Calculator</h1>
        <UsageStats material="paver" />

        <p class="text-xs text-gray-400 mb-4">Last updated: <time datetime="2026-06-09">June 2026</time> · Prices verified</p>
        <p class="text-gray-600 mb-6">Enter your patio or walkway dimensions and paver size to get the exact paver count, sand bedding layer, and compacted gravel base needed.</p>

        <PaverCalculator client:load />

        <ResultActions />
        <AdSlot slot="after-result" className="mt-6" />

        <!-- Installation guide -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">Patio installation layers</h2>
          <ol class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">1.</span>
              <span><strong>Excavate 8–10 inches</strong> — allows for gravel base + sand bed + paver thickness.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">2.</span>
              <span><strong>Compact subgrade</strong> — use a plate compactor on native soil.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">3.</span>
              <span><strong>Add 4" compacted gravel</strong> — use ¾" crusher run or #57 stone. Compact in 2" lifts.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">4.</span>
              <span><strong>Spread 1" coarse sand</strong> — screed to a level, even bed. Do not compact.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">5.</span>
              <span><strong>Lay pavers</strong> — place with ⅛"–¼" joint spacing. Use a mallet and level.</span>
            </li>
            <li class="flex gap-3">
              <span class="font-bold text-brand-600 flex-shrink-0">6.</span>
              <span><strong>Polymeric sand joints</strong> — sweep in, mist with water to activate the binder.</span>
            </li>
          </ol>
        </div>

        <!-- FAQ -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-1">Frequently Asked Questions</h2>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many pavers do I need for a 10×10 patio?</h3>
          <p class="text-sm text-gray-700">A 10×10 ft patio (100 sq ft) with 10% waste needs: about 110 pieces of 12×12 pavers, 495 pieces of 4×8 brick pavers, or 62 pieces of 16×16 pavers.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How much sand do I need under pavers?</h3>
          <p class="text-sm text-gray-700">Use a 1-inch sand bedding layer. For 100 sq ft of patio: 0.31 cubic yards or about 17 bags of 50 lb sand. The Paver Calculator shows this automatically alongside the paver count.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How deep should the gravel base be under pavers?</h3>
          <p class="text-sm text-gray-700">4 inches of compacted gravel for a patio or walkway, 6–8 inches for a driveway. Compact in 2-inch lifts with a plate compactor before adding the sand bedding layer.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">What is the best paver size for a patio?</h3>
          <p class="text-sm text-gray-700">12×24 inch pavers are the most popular for modern patios — fewer grout lines and a sleek look. 12×12 inch pavers are classic and forgiving to lay. 4×8 brick pavers create a traditional look.</p>
        </div>
        </div>
        <AdSlot slot="in-content" className="mt-6" />

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Formula: <em>Pavers = Area (sq in) ÷ Paver area (sq in) × waste factor. Sand = area × 1" depth; Gravel = area × 4" depth.</em>
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a> for all constants.</p>
        </div>
      </div>

      <!-- Right: sidebar -->
      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Pavers per sq ft by size</h3>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Size</th><th class="text-right pb-1">Per sq ft</th></tr></thead>
            <tbody class="divide-y">
              {[
                { size: '4"×8" brick', qty: '4.5' },
                { size: '6"×6"', qty: '4.0' },
                { size: '12"×12"', qty: '1.0' },
                { size: '16"×16"', qty: '0.56' },
                { size: '12"×24"', qty: '0.50' },
                { size: '24"×24"', qty: '0.25' },
              ].map(r => (
                <tr><td class="py-1">{r.size}</td><td class="py-1 text-right">{r.qty}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Includes 10% waste factor</p>
        </div>

        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (
              <li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>
            ))}
          </ul>
        </div>

        <WhereToBuy material="paver" />
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
