---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SodCalculator from '../../components/calculators/SodCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';

const related = [
  { href: '/calculator/topsoil', label: 'Topsoil Calculator' },
  { href: '/calculator/mulch',   label: 'Mulch Calculator' },
  { href: '/guide/how-much-sod-do-i-need',                          label: 'How Much Sod Do I Need?' },
  { href: '/guide/how-many-square-feet-does-a-pallet-of-sod-cover', label: 'How Many Sq Ft Does a Pallet of Sod Cover?' },
];
---

<BaseLayout
  title="Sod Calculator — Pallets, Pieces & Square Feet | Free"
  description="Free sod calculator: enter lawn dimensions to get pieces, pallets, and square footage with waste factor for straight or curved edges."
>

  <Fragment slot="head">
    <CalcSchema name="Sod Calculator" crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Sod Calculator" }]} description="Free sod calculator for pieces, pallets and cost" url="/calculator/sod" />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How many square feet does a pallet of sod cover?", "acceptedAnswer": {"@type": "Answer", "text": "A standard pallet covers approximately 450 square feet (about 170 pieces at 16\u00d724 inches each). Coverage varies by supplier \u2014 confirm with your local sod farm."}}, {"@type": "Question", "name": "How do I calculate how much sod I need?", "acceptedAnswer": {"@type": "Answer", "text": "Measure your lawn area in square feet (length \u00d7 width for rectangular sections). Add areas together for odd shapes. Add 5% waste for straight edges, 10% for curves."}}, {"@type": "Question", "name": "How many pieces of sod are in a pallet?", "acceptedAnswer": {"@type": "Answer", "text": "Most pallets hold approximately 170 pieces (2.67 sq ft each), totaling about 450 sq ft. Some suppliers sell 500 sq ft pallets \u2014 check the product listing."}}, {"@type": "Question", "name": "What is the best time to lay sod?", "acceptedAnswer": {"@type": "Answer", "text": "Spring and early fall are ideal for most US regions \u2014 moderate temperatures help sod root before summer heat or winter frost. Avoid laying during extreme heat or drought."}}]})} />
    <CalcBreadcrumbs crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Sod Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Sod Calculator</h1>
        <p class="text-gray-600 mb-6">Enter your lawn area to find out how many pieces and pallets of sod to buy, with the correct waste factor for your lawn's shape.</p>

        <SodCalculator client:load />

        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How to measure your lawn</h2>
          <ol class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">1.</span>
              <span><strong>Measure the full area:</strong> Walk the perimeter and record length × width in feet for rectangular lawns.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">2.</span>
              <span><strong>Irregular lawns:</strong> Break the lawn into rectangles, measure each, and add with the Irregular shape option.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">3.</span>
              <span><strong>Subtract hardscape:</strong> Don't include driveways, patios, walkways, or garden beds in your area measurement.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">4.</span>
              <span><strong>Waste factor:</strong> Check "Curved or irregular edges" for lawns with lots of curves — it applies a 10% waste factor instead of 5% to account for trimming.</span></li>
          </ol>
        </div>

        <!-- FAQ -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-1">Frequently Asked Questions</h2>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many square feet does a pallet of sod cover?</h3>
          <p class="text-sm text-gray-700">A standard pallet covers approximately 450 square feet (about 170 pieces at 16×24 inches each). Coverage varies by supplier — confirm with your local sod farm.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How do I calculate how much sod I need?</h3>
          <p class="text-sm text-gray-700">Measure your lawn area in square feet (length × width for rectangular sections). Add areas together for odd shapes. Add 5% waste for straight edges, 10% for curves.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many pieces of sod are in a pallet?</h3>
          <p class="text-sm text-gray-700">Most pallets hold approximately 170 pieces (2.67 sq ft each), totaling about 450 sq ft. Some suppliers sell 500 sq ft pallets — check the product listing.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">What is the best time to lay sod?</h3>
          <p class="text-sm text-gray-700">Spring and early fall are ideal for most US regions — moderate temperatures help sod root before summer heat or winter frost. Avoid laying during extreme heat or drought.</p>
        </div>
        </div>
        <AdSlot slot="in-content" className="mt-6" />

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Formula: <em>Pallets = Area × (1 + waste) ÷ 450 sq ft/pallet, rounded up. Pieces = Area × (1 + waste) ÷ 2.67 sq ft/piece.</em>
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a>.</p>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Sod quick facts</h3>
          <ul class="text-sm text-gray-700 space-y-2">
            <li>1 pallet covers ~<strong>450 sq ft</strong></li>
            <li>1 pallet ≈ <strong>170 pieces</strong></li>
            <li>1 piece = 16" × 24" = <strong>2.67 sq ft</strong></li>
            <li>Straight edges: <strong>5% waste</strong></li>
            <li>Curved/irregular: <strong>10% waste</strong></li>
          </ul>
        </div>

        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (
              <li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>
            ))}
          </ul>
        </div>

        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
