---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GravelCalculator from '../../components/calculators/GravelCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import WhereToBuy from '../../components/ui/WhereToBuy.astro';
import ResultActions from '../../components/ui/ResultActions.astro';
import UsageStats from '../../components/ui/UsageStats.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';

const related = [
  { href: '/calculator/gravel-cost/', label: '💰 Gravel Cost' },

  { href: '/calculator/sand/',    label: 'Sand Calculator' },
  { href: '/calculator/topsoil/', label: 'Topsoil Calculator' },
  { href: '/calculator/concrete/',label: 'Concrete Calculator' },
  { href: '/guide/how-much-gravel-do-i-need/', label: 'How Much Gravel Do I Need?' },
  { href: '/guide/how-much-does-a-yard-of-gravel-weigh/', label: 'How Much Does a Yard of Gravel Weigh?' },
  { href: '/guide/cubic-yards-to-tons/', label: 'Cubic Yards to Tons Converter' },
];
---

<BaseLayout
  title="Gravel Calculator — Cubic Yards, Tons & Cost | Free"
  description="Free gravel calculator: enter area, depth, and stone type to get cubic yards, tons, and cost. Covers pea gravel, crushed stone, limestone, and river rock."
>

  <Fragment slot="head">
    <CalcSchema name="Gravel Calculator" crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Gravel Calculator" }]} description="Free gravel calculator for cubic yards, tons and cost" url="/calculator/gravel" />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How many cubic yards of gravel do I need?", "acceptedAnswer": {"@type": "Answer", "text": "Cubic yards = Length (ft) \u00d7 Width (ft) \u00d7 Depth (in) \u00f7 324. For a 20\u00d720 ft driveway at 3 inches: 3.7 cubic yards. Add 10% for waste."}}, {"@type": "Question", "name": "How much does a cubic yard of gravel weigh?", "acceptedAnswer": {"@type": "Answer", "text": "Pea gravel and 3/4-inch crushed stone weigh about 2,800 lbs (1.40 tons) per cubic yard. Crushed limestone is about 3,000 lbs (1.50 tons)."}}, {"@type": "Question", "name": "How deep should I put gravel for a driveway?", "acceptedAnswer": {"@type": "Answer", "text": "A residential driveway needs 4\u20136 inches of compacted base plus 2\u20133 inches of surface gravel, totaling 6\u20139 inches. For a path or landscaping bed, 2\u20133 inches is enough."}}, {"@type": "Question", "name": "How many tons of gravel do I need?", "acceptedAnswer": {"@type": "Answer", "text": "Tons = Cubic yards \u00d7 material density. For 3/4-inch crushed stone: tons = cubic yards \u00d7 1.40. The Gravel Calculator converts automatically when you select your stone type."}}]})} />
    <CalcBreadcrumbs crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Gravel Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Gravel & Crushed Stone Calculator</h1>
        <UsageStats material="gravel" />
        <p class="text-gray-600 mb-6">Enter your project area, depth, and stone type to calculate how many cubic yards or tons of gravel you need.</p>

        <GravelCalculator client:load />

        <ResultActions />
        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How to measure your space</h2>
          <ol class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">1.</span>
              <span><strong>Rectangular areas:</strong> Measure length × width in feet. For driveways, measure the total length and average width.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">2.</span>
              <span><strong>Paths and curved areas:</strong> Break into sections and use the Irregular shape option to add them.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">3.</span>
              <span><strong>Depth:</strong> 2" for decorative ground cover; 3–4" for driveways and high-traffic walkways.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">4.</span>
              <span><strong>Stone type:</strong> Density varies — crushed limestone is heavier than river rock. Select the right type for accurate tonnage.</span></li>
          </ol>
        </div>

        <!-- FAQ -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-1">Frequently Asked Questions</h2>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many cubic yards of gravel do I need?</h3>
          <p class="text-sm text-gray-700">Cubic yards = Length (ft) × Width (ft) × Depth (in) ÷ 324. For a 20×20 ft driveway at 3 inches: 3.7 cubic yards. Add 10% for waste.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How much does a cubic yard of gravel weigh?</h3>
          <p class="text-sm text-gray-700">Pea gravel and 3/4-inch crushed stone weigh about 2,800 lbs (1.40 tons) per cubic yard. Crushed limestone is about 3,000 lbs (1.50 tons).</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How deep should I put gravel for a driveway?</h3>
          <p class="text-sm text-gray-700">A residential driveway needs 4–6 inches of compacted base plus 2–3 inches of surface gravel, totaling 6–9 inches. For a path or landscaping bed, 2–3 inches is enough.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many tons of gravel do I need?</h3>
          <p class="text-sm text-gray-700">Tons = Cubic yards × material density. For 3/4-inch crushed stone: tons = cubic yards × 1.40. The Gravel Calculator converts automatically when you select your stone type.</p>
        </div>
        </div>
        <AdSlot slot="in-content" className="mt-6" />

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Formula: <em>Volume (cu yd) = Area × Depth ÷ 324. Tons = Volume × density (tons/cu yd).</em>
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a> for all constants.</p>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Stone densities</h3>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-1">Stone type</th><th class="text-right pb-1">tons/cu yd</th></tr></thead>
            <tbody class="divide-y">
              {[
                ['Pea gravel','1.40'],['Crushed stone (3/4")','1.40'],
                ['Crushed limestone','1.50'],['River rock','1.35'],['Decomposed granite','1.35'],
              ].map(([n,d]) => (
                <tr><td class="py-1">{n}</td><td class="py-1 text-right">{d}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (
              <li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>
            ))}
          </ul>
        </div>

        <WhereToBuy material="gravel" />
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
