---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopsoilCalculator from '../../components/calculators/TopsoilCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import WhereToBuy from '../../components/ui/WhereToBuy.astro';
import ResultActions from '../../components/ui/ResultActions.astro';
import UsageStats from '../../components/ui/UsageStats.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';
import CalcBreadcrumbs from '../../components/ui/CalcBreadcrumbs.astro';

const related = [
  { href: '/calculator/topsoil-cost/', label: '💰 Topsoil Cost' },

  { href: '/calculator/mulch/',   label: 'Mulch Calculator' },
  { href: '/calculator/sand/',    label: 'Sand Calculator' },
  { href: '/calculator/sod/',     label: 'Sod Calculator' },
  { href: '/guide/how-much-topsoil-do-i-need/',          label: 'How Much Topsoil Do I Need?' },
  { href: '/guide/how-much-does-a-yard-of-topsoil-weigh/', label: 'How Much Does a Yard of Topsoil Weigh?' },
];
---

<BaseLayout
  title="Topsoil Calculator — Cubic Yards & 40 lb Bags | Free"
  description="Free topsoil calculator: enter area and depth to get cubic yards, tons, and 40 lb bag count. Covers lawn seeding, raised beds, and garden projects."
>

  <Fragment slot="head">
    <CalcSchema name="Topsoil Calculator" crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Topsoil Calculator" }]} description="Free topsoil calculator for cubic yards, bags and cost" url="/calculator/topsoil" />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How many cubic yards of topsoil do I need?", "acceptedAnswer": {"@type": "Answer", "text": "Volume (cu yd) = Length (ft) \u00d7 Width (ft) \u00d7 Depth (in) \u00f7 324. For a 20\u00d720 ft area at 4 inches deep: 4.9 cubic yards. Use the Topsoil Calculator for any size."}}, {"@type": "Question", "name": "How much does a cubic yard of topsoil weigh?", "acceptedAnswer": {"@type": "Answer", "text": "A cubic yard of topsoil weighs approximately 2,200 lbs (1.10 tons). Moist or clay-heavy topsoil can weigh up to 2,700 lbs per cubic yard."}}, {"@type": "Question", "name": "How deep should topsoil be for a lawn?", "acceptedAnswer": {"@type": "Answer", "text": "For overseeding an existing lawn: 1\u20132 inches. For a new lawn from scratch: 4\u20136 inches. For raised garden beds: 8\u201312 inches."}}, {"@type": "Question", "name": "How many 40 lb bags of topsoil per cubic yard?", "acceptedAnswer": {"@type": "Answer", "text": "There are 36 bags of 40 lb topsoil in one cubic yard (27 cu ft \u00f7 0.75 cu ft per bag = 36 bags). For large areas, bulk delivery is much cheaper."}}]})} />
    <CalcBreadcrumbs crumbs={[{ label: "Landscaping Calculators", href: "/landscaping-calculators" }, { label: "Topsoil Calculator" }]} />
    <div class="grid lg:grid-cols-[1fr_380px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Topsoil Calculator</h1>
        <UsageStats material="topsoil" />
        <p class="text-gray-600 mb-6">Enter your lawn or garden dimensions and desired depth to find out how many cubic yards or 40 lb bags of topsoil to buy.</p>

        <TopsoilCalculator client:load />

        <ResultActions />
        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How to measure your space</h2>
          <ol class="space-y-3 text-sm text-gray-700">
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">1.</span>
              <span><strong>Lawn areas:</strong> Measure length × width in feet. For irregular lawns, break into rectangles and add them with the Irregular option.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">2.</span>
              <span><strong>Garden beds and raised beds:</strong> Measure interior dimensions. For raised beds being filled from scratch, measure internal length × width × planned depth.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">3.</span>
              <span><strong>Depth guidance:</strong> 2" to top-dress a lawn · 4–6" for new garden beds · 8–12" for raised beds filled from scratch.</span></li>
            <li class="flex gap-3"><span class="font-bold text-brand-600 flex-shrink-0">4.</span>
              <span><strong>Bulk vs. bags:</strong> Bulk delivery is cheaper per cubic yard for orders over 1–2 yards. Bags are convenient for small areas.</span></li>
          </ol>
        </div>

        <!-- FAQ -->
        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-1">Frequently Asked Questions</h2>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many cubic yards of topsoil do I need?</h3>
          <p class="text-sm text-gray-700">Volume (cu yd) = Length (ft) × Width (ft) × Depth (in) ÷ 324. For a 20×20 ft area at 4 inches deep: 4.9 cubic yards. Use the Topsoil Calculator for any size.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How much does a cubic yard of topsoil weigh?</h3>
          <p class="text-sm text-gray-700">A cubic yard of topsoil weighs approximately 2,200 lbs (1.10 tons). Moist or clay-heavy topsoil can weigh up to 2,700 lbs per cubic yard.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How deep should topsoil be for a lawn?</h3>
          <p class="text-sm text-gray-700">For overseeding an existing lawn: 1–2 inches. For a new lawn from scratch: 4–6 inches. For raised garden beds: 8–12 inches.</p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 mt-4">
          <h3 class="font-semibold text-gray-900 mb-1 text-sm">How many 40 lb bags of topsoil per cubic yard?</h3>
          <p class="text-sm text-gray-700">There are 36 bags of 40 lb topsoil in one cubic yard (27 cu ft ÷ 0.75 cu ft per bag = 36 bags). For large areas, bulk delivery is much cheaper.</p>
        </div>
        </div>
        <AdSlot slot="in-content" className="mt-6" />

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          <p>Formula: <em>Volume (cu yd) = Area × Depth ÷ 324. 40 lb bags = Volume (cu ft) ÷ 0.75, rounded up.</em>
          See our <a href="/methodology" class="text-brand-600 hover:underline">methodology page</a>.</p>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Topsoil quick facts</h3>
          <ul class="text-sm text-gray-700 space-y-2">
            <li>1 cubic yard = <strong>36 bags</strong> (40 lb)</li>
            <li>1 cubic yard weighs ~<strong>2,200 lbs (1.1 tons)</strong></li>
            <li>40 lb bag covers ~<strong>0.75 cu ft</strong></li>
            <li>Standard lawn top-dress: <strong>2"</strong></li>
            <li>New garden bed: <strong>4–6"</strong></li>
          </ul>
        </div>

        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators &amp; guides</h3>
          <ul class="space-y-2">
            {related.map(r => (
              <li><a href={r.href} class="text-sm text-brand-600 hover:underline">{r.label}</a></li>
            ))}
          </ul>
        </div>

        <WhereToBuy material="topsoil" />
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
