---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DrywallCalculator from '../../components/calculators/DrywallCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';

const faqs = [
  { q: 'How much does drywall cost?', a: 'Standard 1/2" drywall (4×8 sheet) costs $13–$20 per sheet at home improvement stores. That\'s $0.40–$0.65/sq ft. 5/8" fire-rated drywall runs $18–$28/sheet. Moisture-resistant (green board): $15–$25/sheet.' },
  { q: 'How much does it cost to drywall a room?', a: 'A 12×12 ft room with 8 ft ceilings has about 580 sq ft of wall and ceiling area. At $15/sheet (32 sq ft/sheet) you need ~18 sheets = $270. Add joint compound ($20), tape ($10), and screws ($15) = ~$315 total materials.' },
  { q: 'Does drywall cost include mud and tape?', a: 'Our calculator covers drywall sheets only. Joint compound (mud) costs $15–$25 per 4.5-gallon bucket. Tape is $5–$10 per roll. Screws run $10–$20 per box. Plan for $30–$60 extra in finishing materials per room.' },
  { q: 'Is it cheaper to install drywall yourself?', a: 'DIY drywall saves $1–$2/sq ft in labor. For a 12×12 room that\'s $600–$1,200 in savings. Hanging is manageable for most DIYers; finishing (taping, mudding, sanding) requires more skill.' },
];
---

<BaseLayout
  title="Drywall Cost Calculator — Sheets & Total Price Estimate | Free"
  description="Calculate total drywall cost by entering room dimensions and price per sheet. 2026 US price ranges for standard, moisture-resistant, and fire-rated drywall."
>
  <Fragment slot="head">
    <CalcSchema
      name="Drywall Cost Calculator"
      description="Free drywall cost calculator — estimate sheets and total installation price"
      url="/calculator/drywall-cost"
      crumbs={[{ label: 'Interior Calculators', href: '/interior-calculators/' }, { label: 'Drywall Cost Calculator' }]}
      faqs={faqs}
    />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4 flex flex-wrap gap-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a><span>›</span>
      <a href="/interior-calculators/" class="hover:text-brand-600">Interior</a><span>›</span>
      <span class="text-gray-700">Drywall Cost Calculator</span>
    </nav>

    <div class="grid lg:grid-cols-[1fr_360px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Drywall Cost Calculator</h1>
        <p class="text-gray-600 mb-6">Enter your room dimensions and local sheet price to estimate total drywall cost for walls and ceiling.</p>

        <DrywallCalculator client:load />
        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How the cost is calculated</h2>
          <ol class="space-y-2 text-sm text-gray-700">
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">1.</span><span>Enter room dimensions → calculator outputs sheets needed for walls and ceiling (with 10% waste).</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">2.</span><span>Enter your price per sheet → material cost = sheets × price.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">3.</span><span>Add mud, tape, and screws → total materials estimate.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">4.</span><span>Cost per sq ft = total ÷ area.</span></li>
          </ol>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-3">2026 US drywall price ranges</h2>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-2 font-semibold">Product</th><th class="text-right pb-2 font-semibold">Per 4×8 sheet</th></tr></thead>
            <tbody class="divide-y">
              {[['Standard 1/2" drywall','$13–$20'],['5/8" fire-rated','$18–$28'],['Moisture-resistant (green board)','$15–$25'],['Soundproof drywall','$40–$70'],['Joint compound (4.5 gal)','$15–$25'],['Paper tape (500 ft roll)','$5–$10']].map(([p,v]) => (
                <tr><td class="py-1.5">{p}</td><td class="py-1.5 text-right font-medium">{v}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Prices vary by brand and region. Enter your actual price for an accurate estimate.</p>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map(f => (
              <div><h3 class="font-semibold text-gray-900 text-sm mb-1">{f.q}</h3><p class="text-sm text-gray-700">{f.a}</p></div>
            ))}
          </div>
        </div>

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          Just need the quantity? → <a href="/calculator/drywall/" class="text-brand-600 hover:underline">Drywall Calculator</a> ·
          <a href="/guide/how-much-drywall-do-i-need/" class="text-brand-600 hover:underline">How Much Drywall Do I Need?</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/calculator/drywall/" class="text-brand-600 hover:underline">Drywall Calculator (quantity only)</a></li>
            <li><a href="/calculator/paint-cost/" class="text-brand-600 hover:underline">Paint Cost Calculator</a></li>
            <li><a href="/calculator/lumber-cost/" class="text-brand-600 hover:underline">Lumber Cost Calculator</a></li>
          </ul>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
