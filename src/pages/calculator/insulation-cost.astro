---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsulationCalculator from '../../components/calculators/InsulationCalculator';
import AdSlot from '../../components/ui/AdSlot.astro';
import CalcSchema from '../../components/ui/CalcSchema.astro';

const faqs = [
  { q: 'How much does insulation cost?', a: 'Fiberglass batts: $0.30–$0.60/sq ft for R-13 (2×4 wall), $0.50–$0.90/sq ft for R-19 (2×6 wall). Blown-in attic insulation: $1.50–$3/sq ft installed. Spray foam: $1.50–$3/sq ft (open cell) or $3–$6/sq ft (closed cell).' },
  { q: 'How much does it cost to insulate an attic?', a: 'A 1,000 sq ft attic to R-38 (12") in blown fiberglass costs $600–$1,500 DIY in materials. Professionally blown-in: $1,500–$3,000 for materials and labor.' },
  { q: 'What R-value do I need?', a: 'R-value requirements depend on your climate zone. Attics: R-38 to R-60. Walls: R-13 to R-21. Crawlspaces: R-19 to R-30. Check ENERGY STAR recommendations for your zip code.' },
  { q: 'Is blown-in or batt insulation cheaper?', a: 'Batt insulation is usually cheaper for walls ($0.30–$0.90/sq ft) since it\'s a DIY-friendly install. Blown-in is faster for attics and achieves better coverage around obstacles — professionals often blow it in for $1.50–$3/sq ft.' },
];
---

<BaseLayout
  title="Insulation Cost Calculator — Bags, Rolls & Total Price | Free"
  description="Calculate total insulation cost by entering area, R-value, and local price per bag or roll. 2026 US price ranges for fiberglass batts, blown-in, and spray foam."
>
  <Fragment slot="head">
    <CalcSchema
      name="Insulation Cost Calculator"
      description="Free insulation cost calculator — estimate bags, rolls, and total installation price"
      url="/calculator/insulation-cost"
      crumbs={[{ label: 'Interior Calculators', href: '/interior-calculators' }, { label: 'Insulation Cost Calculator' }]}
      faqs={faqs}
    />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4 flex flex-wrap gap-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a><span>›</span>
      <a href="/interior-calculators/" class="hover:text-brand-600">Interior</a><span>›</span>
      <span class="text-gray-700">Insulation Cost Calculator</span>
    </nav>

    <div class="grid lg:grid-cols-[1fr_360px] gap-10">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Insulation Cost Calculator</h1>
        <p class="text-gray-600 mb-6">Enter your area, R-value, and local price per bag or roll to estimate total insulation cost.</p>

        <InsulationCalculator client:load />
        <AdSlot slot="after-result" className="mt-6" />

        <div class="calculator-card mt-8">
          <h2 class="font-bold text-gray-900 text-lg mb-3">How the cost is calculated</h2>
          <ol class="space-y-2 text-sm text-gray-700">
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">1.</span><span>Enter area and R-value → calculator outputs bags or rolls needed.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">2.</span><span>Enter your price per bag or roll → material cost = quantity × price.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">3.</span><span>Add optional vapor barrier or staples cost → total estimate.</span></li>
            <li class="flex gap-2"><span class="font-bold text-brand-600 flex-shrink-0">4.</span><span>Cost per sq ft = total ÷ area (compare contractor bids).</span></li>
          </ol>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-3">2026 US insulation price ranges</h2>
          <table class="w-full text-sm text-gray-700">
            <thead><tr class="border-b"><th class="text-left pb-2 font-semibold">Type</th><th class="text-right pb-2 font-semibold">Per sq ft (materials)</th></tr></thead>
            <tbody class="divide-y">
              {[['Fiberglass batts (R-13)','$0.30–$0.60'],['Fiberglass batts (R-19)','$0.50–$0.90'],['Blown-in fiberglass (R-38)','$0.80–$1.50'],['Blown-in cellulose','$0.70–$1.20'],['Open-cell spray foam','$1.50–$3.00'],['Closed-cell spray foam','$3.00–$6.00']].map(([p,v]) => (
                <tr><td class="py-1.5">{p}</td><td class="py-1.5 text-right font-medium">{v}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="text-xs text-gray-500 mt-2">Prices vary by region. Enter your actual price for an accurate estimate.</p>
        </div>

        <div class="calculator-card mt-4">
          <h2 class="font-bold text-gray-900 text-lg mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map(f => (
              <div><h3 class="font-semibold text-gray-900 text-sm mb-1">{f.q}</h3><p class="text-sm text-gray-700">{f.a}</p></div>
            ))}
          </div>
        </div>

        <div class="mt-6 text-sm text-gray-500 border-t pt-4">
          Just need the quantity? → <a href="/calculator/insulation/" class="text-brand-600 hover:underline">Insulation Calculator</a> ·
          <a href="/calculator/drywall-cost/" class="text-brand-600 hover:underline">Drywall Cost Calculator</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="calculator-card">
          <h3 class="font-semibold text-gray-900 mb-3">Related calculators</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/calculator/insulation/" class="text-brand-600 hover:underline">Insulation Calculator (quantity only)</a></li>
            <li><a href="/calculator/drywall-cost/" class="text-brand-600 hover:underline">Drywall Cost Calculator</a></li>
            <li><a href="/calculator/lumber-cost/" class="text-brand-600 hover:underline">Lumber Cost Calculator</a></li>
          </ul>
        </div>
        <AdSlot slot="sidebar" />
      </aside>
    </div>
  </div>
</BaseLayout>
