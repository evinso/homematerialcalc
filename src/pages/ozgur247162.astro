---
import schedule from '../../publish-schedule.json';

const pages = (schedule.pages as any[]).filter(p => p && p.url && p.status);

const published = pages.filter(p => p.status === 'published').sort((a,b) => b.publishedAt?.localeCompare(a.publishedAt ?? '') ?? 0);
const pending   = pages.filter(p => p.status === 'pending');

// Programmatic pages (dynamic routes — NOT in publish-schedule.json)
// area/slab: mulch×12 + gravel×5 + topsoil×7 + sand×5 + sod×7 + concrete-slabs×10 + paint×11 = 57
// state×material: 4 materials × 20 states = 80
// city×material: 4 materials × 42 cities = 168
const PROG_AREA  = 57;
const PROG_STATE = 80;
const PROG_CITY  = 168;
const PROGRAMMATIC_COUNT = PROG_AREA + PROG_STATE + PROG_CITY; // 305

const totalLive = published.length + PROGRAMMATIC_COUNT;
const total     = totalLive + pending.length;
const progressPct = total > 0 ? Math.round((totalLive / total) * 100) : 0;

const today      = new Date().toISOString().split('T')[0];
const lastRun    = (schedule as any).lastRun ?? '—';
const runsPerDay = 4;
const pagesPerRun = (schedule.cadence as any).pagesPerRun ?? 1;
const pagesPerDay = runsPerDay * pagesPerRun;

const runs = ((schedule as any).runs ?? []) as any[];
const recentRuns = runs.slice(0, 50);

function addDays(dateStr: string, n: number) {
  const d = new Date(dateStr + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().split('T')[0];
}

const baseDate = lastRun !== '—' ? lastRun : today;
const pendingWithETA = pending.map((p, i) => ({
  ...p,
  eta: addDays(baseDate, Math.ceil((i + 1) / pagesPerDay)),
}));

const emptyDate = pending.length > 0
  ? addDays(baseDate, Math.ceil(pending.length / pagesPerDay))
  : null;

// Type grouping
const byType = (list: any[], type: string) => list.filter(p => p.type === type);
const pubCalcs  = byType(published, 'calculator');
const pubGuides = byType(published, 'guide');
const pubRefs   = byType(published, 'reference');
const pubStatic = byType(published, 'static');
const pendCalcs = byType(pendingWithETA, 'calculator');
const pendGuides= byType(pendingWithETA, 'guide');
const pendRefs  = byType(pendingWithETA, 'reference');
const pendStatic= byType(pendingWithETA, 'static');

// Run stats
const totalPagesPublishedByRuns = runs.reduce((s, r) => s + (r.pagesPublished?.length ?? 0), 0);
const autoRuns   = runs.filter(r => r.trigger === 'scheduled').length;
const manualRuns = runs.filter(r => r.trigger !== 'scheduled').length;

function triggerLabel(t: string) {
  if (t === 'scheduled')       return '⏰ Otomatik';
  if (t === 'manual_dispatch') return '▶️ Manuel';
  return '💻 Local';
}
function typeLabel(type: string) {
  if (type === 'calculator') return 'calc';
  if (type === 'guide')      return 'guide';
  if (type === 'reference')  return 'ref';
  return 'static';
}

// SEO improvement log (manual — add entries as work is done)
const seoLog = [
  { date: '2026-06-09', tag: 'Yazar', items: ['3 author sayfası (/author/tom, /sarah, /dan)', 'Person schema + email + expertise', 'AuthorCard → /author/ link', 'GuideLayout Person schema enriched'] },
  { date: '2026-06-09', tag: 'Şehir', items: ['168 yeni şehir sayfası (4 materyal × 42 şehir)', 'Houston, Dallas, Miami, LA, Chicago, Atlanta…', 'Sitemap güncellendi: 305 programmatic'] },
  { date: '2026-06-09', tag: 'Hub', items: ['landscaping-calculators: 7 seksiyon → tam içerik haritası', 'interior-calculators: 6 seksiyon + BreadcrumbList', 'concrete-calculators: 5 seksiyon + BreadcrumbList'] },
  { date: '2026-06-09', tag: 'İçerik', items: ['4 yeni maliyet guide: flooring, drywall, lumber, tile', 'Table of Contents: tüm guide sayfalarına client-side TOC', 'FAQ genişletme: mulch/gravel/concrete cost sayfaları (9-10 FAQ)'] },
  { date: '2026-06-09', tag: 'Calculator', items: ['17 calculator sayfasına dateModified schema', '"Last updated: June 2026" badge eklendi', 'CalcSchema: creator.email alanı eklendi'] },
  { date: '2026-06-08', tag: 'Sitemap', items: ['3 katmanlı sitemap: live / upcoming / programmatic', 'sitemap-live.xml (57 yayında)', 'sitemap-upcoming.xml (pending sayfalar)', 'sitemap-programmatic.xml (305 dinamik)'] },
  { date: '2026-06-08', tag: 'İçerik', items: ['13 yeni guide: insulation kümesi (4), how-to (5), comparison (4)', 'Sod alan bazlı sayfalar (7 boyut)', 'publish-schedule: 13 sayfa eklendi'] },
  { date: '2026-06-07', tag: 'Teknik SEO', items: ['og:type="article" tüm guide sayfalarda', 'article:published_time + article:modified_time', '34 guide MDX dosyasına publishDate eklendi', 'BreadcrumbList item eksik hatası düzeltildi'] },
];

// Content inventory by hub
const contentMap = {
  landscaping: {
    calcs: ['mulch','gravel','topsoil','sand','sod','paver','grass-seed','asphalt'],
    guides: ['/guide/how-much-mulch-do-i-need','/guide/how-much-gravel-do-i-need','/guide/how-much-topsoil-do-i-need','/guide/how-much-sand-do-i-need','/guide/how-much-sod-do-i-need'],
    howto: ['/guide/how-to-build-a-patio','/guide/how-to-build-a-gravel-driveway','/guide/how-to-build-a-raised-garden-bed','/guide/how-to-lay-pavers','/guide/how-to-reseed-a-lawn'],
    compare: ['/guide/mulch-vs-rock-landscaping','/guide/sod-vs-seed','/guide/pea-gravel-vs-river-rock','/guide/artificial-grass-vs-sod'],
    cost: ['/guide/how-much-does-mulch-cost','/guide/how-much-does-gravel-cost'],
  },
  interior: {
    calcs: ['paint','flooring','tile','drywall','lumber','insulation'],
    guides: ['/guide/how-much-paint-do-i-need','/guide/how-much-insulation-do-i-need'],
    howto: ['/guide/how-to-paint-a-room','/guide/how-to-install-laminate-flooring','/guide/how-to-install-tile','/guide/how-to-hang-drywall','/guide/how-to-insulate-an-attic'],
    compare: ['/guide/laminate-vs-hardwood-flooring','/guide/tile-vs-vinyl-flooring','/guide/spray-foam-vs-fiberglass-insulation'],
    cost: ['/guide/how-much-does-flooring-cost','/guide/how-much-does-drywall-cost','/guide/how-much-does-lumber-cost','/guide/how-much-does-tile-cost','/guide/how-much-does-insulation-cost'],
  },
  concrete: {
    calcs: ['concrete','concrete-cost','fence','deck','asphalt','paver'],
    guides: ['/guide/how-much-concrete-do-i-need','/guide/how-much-concrete-for-a-slab'],
    howto: ['/guide/how-to-pour-a-concrete-slab','/guide/how-to-build-a-patio','/guide/how-to-lay-pavers'],
    compare: ['/guide/asphalt-vs-concrete-driveway','/guide/concrete-vs-pavers-patio','/guide/cedar-vs-pressure-treated-wood'],
    cost: ['/guide/how-much-does-concrete-cost'],
  },
};

const authors = [
  { slug: 'tom', name: 'Tom Harrington', title: 'Licensed General Contractor', avatar: 'TH', color: '#2563eb', expertise: 'Concrete, Decks, Fences, Lumber' },
  { slug: 'sarah', name: 'Sarah Mitchell', title: 'Certified Landscape Designer', avatar: 'SM', color: '#16a34a', expertise: 'Mulch, Gravel, Sod, Landscaping' },
  { slug: 'dan', name: 'Dan Kowalski', title: 'Flooring & Interior Specialist', avatar: 'DK', color: '#9333ea', expertise: 'Flooring, Tile, Drywall, Paint, Insulation' },
];
---

<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin — HomeMaterialCalc</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:      #0b1120;
      --surface: #131f35;
      --border:  #1e2d45;
      --muted:   #3d5470;
      --text:    #cdd8e8;
      --bright:  #f0f6ff;
      --blue:    #38bdf8;
      --green:   #4ade80;
      --yellow:  #fcd34d;
      --purple:  #a78bfa;
      --pink:    #f472b6;
      --teal:    #2dd4bf;
      --orange:  #fb923c;
    }
    body { font-family: system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text); min-height:100vh; padding: 2rem 1rem 4rem; font-size: 14px; }
    .wrap { max-width: 1100px; margin: 0 auto; }

    /* header */
    .header { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.25rem; }
    h1 { font-size: 1.4rem; font-weight: 800; color: var(--bright); }
    .sub { font-size: 0.78rem; color: var(--muted); margin-bottom: 2rem; }

    /* stat grid */
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px,1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
    .stat { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1rem 0.75rem; }
    .stat-n { font-size: 1.9rem; font-weight: 800; line-height: 1; color: var(--blue); }
    .stat-l { font-size: 0.68rem; color: var(--muted); margin-top: 0.3rem; text-transform: uppercase; letter-spacing: 0.04em; }

    /* progress bar */
    .progress-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; }
    .progress-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; }
    .progress-title { font-size: 0.78rem; font-weight: 600; color: var(--text); }
    .progress-pct { font-size: 1.1rem; font-weight: 800; color: var(--blue); }
    .bar-bg { background: var(--border); border-radius: 999px; height: 8px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #0ea5e9, #38bdf8); transition: width 0.3s; }
    .progress-meta { display: flex; gap: 1.5rem; margin-top: 0.6rem; flex-wrap: wrap; }
    .progress-meta span { font-size: 0.72rem; color: var(--muted); }
    .progress-meta strong { color: var(--text); }

    /* two-col / three-col */
    .two-col   { display: grid; grid-template-columns: 1fr 1fr;     gap: 1rem; margin-bottom: 1.5rem; }
    .three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
    @media (max-width: 700px) { .two-col, .three-col { grid-template-columns: 1fr; } }

    /* card */
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; }
    .card-title { font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.75rem; }
    .card-row { display: flex; justify-content: space-between; font-size: 0.78rem; padding: 0.25rem 0; border-bottom: 1px solid var(--border); }
    .card-row:last-child { border-bottom: none; }
    .card-row-label { color: var(--muted); }
    .card-row-val { color: var(--bright); font-weight: 600; }

    /* prog breakdown bars */
    .prog-bar-row { margin-bottom: 0.6rem; }
    .prog-bar-label { display: flex; justify-content: space-between; font-size: 0.72rem; margin-bottom: 0.25rem; }
    .prog-bar-label span:first-child { color: var(--text); }
    .prog-bar-label span:last-child { color: var(--muted); }
    .prog-mini-bg { background: var(--border); border-radius: 999px; height: 5px; overflow: hidden; }
    .prog-mini-fill { height: 100%; border-radius: 999px; }

    /* cron */
    .cron-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
    .cron-item { background: var(--border); border-radius: 8px; padding: 0.5rem; text-align: center; }
    .cron-tr { font-size: 1rem; font-weight: 800; color: var(--blue); }
    .cron-utc { font-size: 0.65rem; color: var(--muted); margin-top: 0.15rem; }

    /* quick links */
    .links-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px,1fr)); gap: 0.5rem; margin-bottom: 1.5rem; }
    .link-btn { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 0.6rem 0.8rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.76rem; color: var(--text); text-decoration: none; transition: border-color 0.15s, color 0.15s; }
    .link-btn:hover { border-color: var(--blue); color: var(--blue); }
    .link-btn .ico { font-size: 1rem; flex-shrink: 0; }

    /* section */
    .section { margin-bottom: 2rem; }
    .sec-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 0.75rem; }
    .sec-title { font-size: 0.8rem; font-weight: 700; color: var(--text); text-transform: uppercase; letter-spacing: 0.05em; }
    .sec-sub { font-size: 0.7rem; color: var(--muted); }

    /* SEO log */
    .seo-log { display: flex; flex-direction: column; gap: 0.75rem; }
    .seo-entry { display: grid; grid-template-columns: auto auto 1fr; gap: 0.5rem 0.75rem; align-items: start; }
    .seo-date { font-size: 0.68rem; color: var(--muted); font-family: monospace; white-space: nowrap; padding-top: 0.15rem; }
    .seo-tag { font-size: 0.62rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 999px; white-space: nowrap; background: #0c2240; color: var(--blue); }
    .seo-tag.yazar  { background: #1a1040; color: var(--purple); }
    .seo-tag.şehir  { background: #0c2214; color: var(--green); }
    .seo-tag.hub    { background: #2a2008; color: var(--yellow); }
    .seo-tag.içerik { background: #0f2010; color: #6ee7b7; }
    .seo-tag.calc   { background: #1f0b0b; color: var(--pink); }
    .seo-tag.sitemap{ background: #0c1a2e; color: var(--teal); }
    .seo-tag.teknik { background: #1a0f28; color: var(--orange); }
    .seo-items { display: flex; flex-direction: column; gap: 0.2rem; }
    .seo-item { font-size: 0.74rem; color: var(--text); }

    /* author cards */
    .author-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 0.75rem; margin-bottom: 1.5rem; }
    @media (max-width: 600px) { .author-cards { grid-template-columns: 1fr; } }
    .author-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1rem; display: flex; gap: 0.75rem; align-items: flex-start; }
    .author-avatar { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 800; color: white; flex-shrink: 0; }
    .author-info { min-width: 0; }
    .author-name { font-size: 0.82rem; font-weight: 700; color: var(--bright); }
    .author-title { font-size: 0.7rem; color: var(--muted); margin-top: 0.1rem; }
    .author-expertise { font-size: 0.68rem; color: var(--text); margin-top: 0.35rem; }
    .author-link { font-size: 0.68rem; color: var(--blue); text-decoration: none; margin-top: 0.35rem; display: block; }
    .author-link:hover { text-decoration: underline; }

    /* content hub table */
    .hub-table { width: 100%; border-collapse: collapse; font-size: 0.76rem; }
    .hub-table th { color: var(--muted); font-weight: 600; text-align: left; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--border); font-size: 0.68rem; text-transform: uppercase; }
    .hub-table td { padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--border); color: var(--text); }
    .hub-table tr:last-child td { border-bottom: none; }
    .hub-table td:first-child { color: var(--bright); font-weight: 600; }
    .hub-num { color: var(--blue); font-weight: 700; }

    /* next-up strip */
    .next-strip { background: linear-gradient(135deg, #0c1c2e, #0f2540); border: 1px solid #1a3a5c; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; }
    .next-label { font-size: 0.68rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; }
    .next-pages { display: flex; flex-direction: column; gap: 0.35rem; }
    .next-page-row { display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem; flex-wrap: wrap; }
    .next-slot { font-size: 0.65rem; color: var(--muted); min-width: 3rem; }
    .next-url { color: var(--blue); font-family: monospace; font-size: 0.77rem; }
    .next-lbl { color: var(--muted); font-size: 0.72rem; }

    /* run history */
    .run-card { background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--border); border-radius: 10px; padding: 0.85rem 1rem; margin-bottom: 0.6rem; }
    .run-card.auto   { border-left-color: var(--blue); }
    .run-card.manual { border-left-color: var(--purple); }
    .run-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
    .run-date { font-size: 0.82rem; font-weight: 700; color: var(--bright); }
    .run-meta-row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .run-pages-list { display: flex; flex-direction: column; gap: 0.25rem; }
    .run-page { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; }
    .run-page-url { color: var(--text); font-family: monospace; font-size: 0.75rem; }
    .run-page-lbl { color: var(--muted); font-size: 0.7rem; }

    /* pending tabs */
    .tab-row { display: flex; gap: 0.4rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
    .tab { font-size: 0.72rem; font-weight: 600; padding: 0.3rem 0.75rem; border-radius: 999px; cursor: pointer; border: 1px solid var(--border); background: var(--surface); color: var(--muted); transition: all 0.15s; }
    .tab.active { background: #0c2240; color: var(--blue); border-color: #1a3a5c; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* rows */
    .row { display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0.6rem; border-radius: 7px; }
    .row:hover { background: rgba(255,255,255,0.03); }
    .row-left { min-width: 0; }
    .row-url { color: var(--text); font-family: monospace; font-size: 0.76rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row-lbl { color: var(--muted); font-size: 0.69rem; margin-top: 0.1rem; }
    .row-right { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; margin-left: 0.75rem; }
    .row-eta { font-size: 0.69rem; color: var(--muted); white-space: nowrap; }

    /* type blocks */
    .type-block { margin-bottom: 1rem; }
    .type-lbl { font-size: 0.68rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; padding: 0 0.6rem; margin-bottom: 0.3rem; }

    /* badges */
    .badge { display: inline-block; padding: 0.1rem 0.45rem; border-radius: 999px; font-size: 0.65rem; font-weight: 700; white-space: nowrap; }
    .badge-calc   { background: #0c2240; color: #7dd3fc; }
    .badge-guide  { background: #0c2214; color: #86efac; }
    .badge-ref    { background: #2a2008; color: #fcd34d; }
    .badge-static { background: #1e293b; color: #94a3b8; }
    .badge-live   { background: #052e16; color: #4ade80; }
    .badge-pend   { background: #0c2240; color: #60a5fa; }
    .badge-auto   { background: #0c2240; color: var(--blue); }
    .badge-manual { background: #1a1040; color: var(--purple); }

    /* misc */
    a { color: var(--blue); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .empty { color: var(--muted); font-size: 0.78rem; padding: 0.75rem 0.6rem; }
    .checklist { display: flex; flex-direction: column; gap: 0.35rem; }
    .check-row { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.78rem; }
    .check-icon { font-size: 0.85rem; flex-shrink: 0; margin-top: 0.05rem; }
    .check-done { color: var(--text); }
    .check-todo { color: var(--muted); }
    .divider { border: none; border-top: 1px solid var(--border); margin: 1.5rem 0; }
    .pill { display: inline-block; font-size: 0.62rem; font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 999px; vertical-align: middle; }

    /* password gate */
    #gate { position:fixed; inset:0; z-index:9999; background:var(--bg); display:flex; align-items:center; justify-content:center; }
    .login-card { background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:2rem 2.5rem; width:100%; max-width:340px; }
    .login-title { font-size:1rem; font-weight:800; color:var(--bright); margin-bottom:0.25rem; text-align:center; }
    .login-sub { font-size:0.72rem; color:var(--muted); text-align:center; margin-bottom:1.5rem; }
    .login-input { width:100%; background:var(--bg); border:1px solid var(--border); border-radius:8px; color:var(--text); font-size:0.9rem; padding:0.65rem 0.85rem; outline:none; transition:border-color .15s; }
    .login-input:focus { border-color:var(--blue); }
    .login-btn { width:100%; margin-top:0.75rem; background:var(--blue); color:#000; font-weight:700; font-size:0.85rem; border:none; border-radius:8px; padding:0.7rem; cursor:pointer; }
    .login-err { color:#f87171; font-size:0.75rem; margin-top:0.6rem; text-align:center; display:none; }
    #content { display:none; }
  </style>
</head>
<body>

<div id="gate">
  <div class="login-card">
    <div class="login-title">HomeMaterialCalc · Admin</div>
    <div class="login-sub">Devam etmek için şifrenizi girin</div>
    <input class="login-input" type="password" id="pw" placeholder="Şifre" autocomplete="current-password" autofocus />
    <button class="login-btn" id="btn">Giriş</button>
    <p class="login-err" id="err">Hatalı şifre</p>
  </div>
</div>

<div id="content">
<div class="wrap">

  <div class="header">
    <h1>HomeMaterialCalc · Admin</h1>
    <span style="font-size:0.75rem;color:var(--muted)">Bugün: <strong style="color:var(--text)">{today}</strong> &nbsp;·&nbsp; Son yayın: <strong style="color:var(--text)">{lastRun}</strong></span>
  </div>
  <p class="sub">noindex · yayın takibi · SEO durumu · sadece sen görüyorsun</p>

