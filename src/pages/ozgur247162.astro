---
import schedule from '../../publish-schedule.json';

const pages = (schedule.pages as any[]).filter(p => p && p.url && p.status);

const published = pages.filter(p => p.status === 'published').sort((a,b) => b.publishedAt?.localeCompare(a.publishedAt ?? '') ?? 0);
const pending   = pages.filter(p => p.status === 'pending');
const future    = pages.filter(p => p.status === 'future');

const today = new Date().toISOString().split('T')[0];
const lastRun = schedule.lastRun ?? '—';
const pagesPerRun = (schedule.cadence as any).pagesPerRun ?? 1;

// Estimate publish dates for pending pages (1 per day starting tomorrow)
function addDays(dateStr: string, n: number) {
  const d = new Date(dateStr);
  d.setDate(d.getDate() + n);
  return d.toISOString().split('T')[0];
}

const baseDate = lastRun !== '—' ? lastRun : today;
const pendingWithETA = pending.map((p, i) => ({
  ...p,
  eta: addDays(baseDate, i + 1),
}));

// Group published by date
const byDate: Record<string, typeof published> = {};
for (const p of published) {
  const d = p.publishedAt ?? 'unknown';
  if (!byDate[d]) byDate[d] = [];
  byDate[d].push(p);
}
const sortedDates = Object.keys(byDate).sort((a,b) => b.localeCompare(a));

const calcs  = published.filter(p => p.url.startsWith('/calculator'));
const guides  = published.filter(p => p.url.startsWith('/guide'));
const static_ = published.filter(p => !p.url.startsWith('/calculator') && !p.url.startsWith('/guide'));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Dashboard — HomeMaterialCalc</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; padding: 2rem 1rem; }
    .wrap { max-width: 900px; margin: 0 auto; }
    h1 { font-size: 1.5rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.25rem; }
    .subtitle { font-size: 0.85rem; color: #64748b; margin-bottom: 2rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat { background: #1e293b; border-radius: 10px; padding: 1rem; }
    .stat-n { font-size: 2rem; font-weight: 800; color: #38bdf8; }
    .stat-l { font-size: 0.75rem; color: #94a3b8; margin-top: 0.25rem; }
    .section { margin-bottom: 2rem; }
    .section-title { font-size: 0.85rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; border-bottom: 1px solid #1e293b; padding-bottom: 0.5rem; }
    .row { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; border-radius: 6px; margin-bottom: 0.25rem; font-size: 0.85rem; }
    .row:hover { background: #1e293b; }
    .row-url { color: #cbd5e1; font-family: monospace; font-size: 0.8rem; }
    .row-label { color: #94a3b8; font-size: 0.75rem; }
    .row-date { color: #64748b; font-size: 0.75rem; white-space: nowrap; margin-left: 1rem; }
    .badge { display: inline-block; padding: 0.15rem 0.55rem; border-radius: 999px; font-size: 0.7rem; font-weight: 600; }
    .badge-pub  { background: #14532d; color: #4ade80; }
    .badge-pend { background: #1c3148; color: #38bdf8; }
    .badge-fut  { background: #1e1a2e; color: #818cf8; }
    .date-group { color: #475569; font-size: 0.75rem; padding: 0.5rem 0.75rem 0.25rem; font-weight: 600; }
    .info-bar { background: #1e293b; border-radius: 10px; padding: 1rem 1.25rem; display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.8rem; color: #94a3b8; margin-bottom: 2rem; }
    .info-bar strong { color: #e2e8f0; }
    a { color: #38bdf8; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .empty { color: #475569; font-size: 0.8rem; padding: 0.5rem 0.75rem; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>📊 HomeMaterialCalc — Admin Dashboard</h1>
    <p class="subtitle">Yayın durumu · Sadece sen görüyorsun (noindex)</p>

    <!-- Stats -->
    <div class="grid">
      <div class="stat">
        <div class="stat-n">{published.length}</div>
        <div class="stat-l">Yayında</div>
      </div>
      <div class="stat">
        <div class="stat-n">{pending.length}</div>
        <div class="stat-l">Sırada (pending)</div>
      </div>
      <div class="stat">
        <div class="stat-n">{future.length}</div>
        <div class="stat-l">Planlanmış (future)</div>
      </div>
      <div class="stat">
        <div class="stat-n">{calcs.length}</div>
        <div class="stat-l">Calculator sayfası</div>
      </div>
      <div class="stat">
        <div class="stat-n">{guides.length}</div>
        <div class="stat-l">Guide sayfası</div>
      </div>
      <div class="stat">
        <div class="stat-n">{pagesPerRun}/gün</div>
        <div class="stat-l">Yayın hızı</div>
      </div>
    </div>

    <!-- Info bar -->
    <div class="info-bar">
      <span>Son çalışma: <strong>{lastRun}</strong></span>
      <span>Bugün: <strong>{today}</strong></span>
      <span>GitHub Actions: <strong>Her gün 09:00 UTC</strong></span>
      <span>Canlı site: <a href="https://www.homematerialcalc.com" target="_blank">homematerialcalc.com</a></span>
      <span>Sitemap: <a href="https://www.homematerialcalc.com/sitemap.xml" target="_blank">sitemap.xml</a> ({published.filter(p => !['/privacy','/terms','/contact','/contact-success'].includes(p.url)).length} URL)</span>
    </div>

    <!-- Pending — sıradakiler -->
    <div class="section">
      <div class="section-title">⏳ Sırada — {pending.length} sayfa (tahmini tarihler)</div>
      {pendingWithETA.length === 0
        ? <p class="empty">Sırada sayfa yok.</p>
        : pendingWithETA.map(p => (
          <div class="row">
            <div>
              <div class="row-url">{p.url}</div>
              <div class="row-label">{p.label}</div>
            </div>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <span class="badge badge-pend">pending</span>
              <span class="row-date">~{p.eta}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Future -->
    {future.length > 0 && (
      <div class="section">
        <div class="section-title">🔮 Planlanmış — {future.length} sayfa (henüz yazılmamış)</div>
        {future.map(p => (
          <div class="row">
            <div>
              <div class="row-url">{p.url}</div>
              <div class="row-label">{p.label}</div>
            </div>
            <span class="badge badge-fut">future</span>
          </div>
        ))}
      </div>
    )}

    <!-- Published — tarihe göre gruplu -->
    <div class="section">
      <div class="section-title">✅ Yayında — {published.length} sayfa</div>
      {sortedDates.map(date => (
        <>
          <div class="date-group">{date}</div>
          {byDate[date].map(p => (
            <div class="row">
              <div>
                <div class="row-url">
                  <a href={`https://www.homematerialcalc.com${p.url}`} target="_blank">{p.url}</a>
                </div>
                <div class="row-label">{p.label}</div>
              </div>
              <span class="badge badge-pub">published</span>
            </div>
          ))}
        </>
      ))}
    </div>
  </div>
</body>
</html>
