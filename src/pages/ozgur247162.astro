---
import schedule from '../../publish-schedule.json';

const pages = (schedule.pages as any[]).filter(p => p && p.url && p.status);

const published = pages.filter(p => p.status === 'published').sort((a,b) => b.publishedAt?.localeCompare(a.publishedAt ?? '') ?? 0);
const pending   = pages.filter(p => p.status === 'pending');
const future    = pages.filter(p => p.status === 'future');

const today = new Date().toISOString().split('T')[0];
const lastRun = schedule.lastRun ?? '—';
const pagesPerRun = (schedule.cadence as any).pagesPerRun ?? 1;

// Run history — newest first, max 30 entries shown
const runs = ((schedule as any).runs ?? []) as any[];
const recentRuns = runs.slice(0, 30);

// Days until queue is empty
const daysLeft = pending.length;
const emptyDate = (() => {
  if (!daysLeft) return null;
  const base = lastRun !== '—' ? lastRun : today;
  const d = new Date(base);
  d.setDate(d.getDate() + daysLeft);
  return d.toISOString().split('T')[0];
})();

// Trigger label helper
function triggerLabel(t: string) {
  if (t === 'scheduled') return '⏰ Otomatik';
  if (t === 'manual_dispatch') return '▶️ Manuel (Actions)';
  return '💻 Local';
}

// Estimate publish dates for pending pages (1 per day starting tomorrow)
function addDays(dateStr: string, n: number) {
  const d = new Date(dateStr);
  d.setDate(d.getDate() + n);
  return d.toISOString().split('T')[0];
}

const baseDate = lastRun !== '—' ? lastRun : today;
const pendingWithETA = pending.map((p, i) => ({
  ...p,
  eta: addDays(baseDate, i + 1),
}));

// Group helpers
function byType(list: any[], type: string) {
  return list.filter(p => p.type === type);
}

// Published stats
const pubCalcs     = byType(published, 'calculator');
const pubGuides    = byType(published, 'guide');
const pubRefs      = byType(published, 'reference');
const pubStatic    = byType(published, 'static');

// Pending groups
const pendCalcs    = byType(pendingWithETA, 'calculator');
const pendGuides   = byType(pendingWithETA, 'guide');
const pendRefs     = byType(pendingWithETA, 'reference');

// Published grouped by date
const byDate: Record<string, typeof published> = {};
for (const p of published) {
  const d = p.publishedAt ?? 'unknown';
  if (!byDate[d]) byDate[d] = [];
  byDate[d].push(p);
}
const sortedDates = Object.keys(byDate).sort((a,b) => b.localeCompare(a));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Dashboard — HomeMaterialCalc</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; padding: 2rem 1rem; }
    .wrap { max-width: 960px; margin: 0 auto; }
    h1 { font-size: 1.5rem; font-weight: 700; color: #f8fafc; margin-bottom: 0.25rem; }
    .subtitle { font-size: 0.85rem; color: #64748b; margin-bottom: 2rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 2rem; }
    .stat { background: #1e293b; border-radius: 10px; padding: 1rem; }
    .stat-n { font-size: 1.75rem; font-weight: 800; color: #38bdf8; }
    .stat-l { font-size: 0.72rem; color: #94a3b8; margin-top: 0.25rem; }
    .section { margin-bottom: 2rem; }
    .section-header { font-size: 0.82rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; border-bottom: 1px solid #1e293b; padding-bottom: 0.4rem; display: flex; align-items: center; justify-content: space-between; }
    .type-block { margin-bottom: 1.25rem; }
    .type-label { font-size: 0.73rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4rem; padding: 0 0.5rem; }
    .row { display: flex; align-items: center; justify-content: space-between; padding: 0.45rem 0.75rem; border-radius: 6px; margin-bottom: 0.2rem; font-size: 0.82rem; }
    .row:hover { background: #1e293b; }
    .row-url { color: #cbd5e1; font-family: monospace; font-size: 0.78rem; }
    .row-label { color: #94a3b8; font-size: 0.72rem; }
    .row-date { color: #64748b; font-size: 0.72rem; white-space: nowrap; margin-left: 1rem; }
    .badge { display: inline-block; padding: 0.12rem 0.5rem; border-radius: 999px; font-size: 0.68rem; font-weight: 600; }
    .badge-pub  { background: #14532d; color: #4ade80; }
    .badge-pend { background: #1c3148; color: #38bdf8; }
    .badge-fut  { background: #1e1a2e; color: #818cf8; }
    .badge-type-calc { background: #1c2a3e; color: #7dd3fc; }
    .badge-type-guide { background: #1a2e1a; color: #86efac; }
    .badge-type-ref  { background: #2e2a1a; color: #fcd34d; }
    .date-group { color: #475569; font-size: 0.73rem; padding: 0.45rem 0.75rem 0.2rem; font-weight: 700; }
    .info-bar { background: #1e293b; border-radius: 10px; padding: 0.9rem 1.1rem; display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: 0.78rem; color: #94a3b8; margin-bottom: 2rem; }
    .info-bar strong { color: #e2e8f0; }
    a { color: #38bdf8; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .empty { color: #475569; font-size: 0.78rem; padding: 0.4rem 0.75rem; }
    .tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .tab { font-size: 0.75rem; font-weight: 600; padding: 0.3rem 0.75rem; border-radius: 999px; cursor: default; }
    .tab-calc  { background: #1c2a3e; color: #7dd3fc; }
    .tab-guide { background: #1a2e1a; color: #86efac; }
    .tab-ref   { background: #2e2a1a; color: #fcd34d; }
    .tab-static { background: #1e293b; color: #94a3b8; }
    .countdown { background: #1e293b; border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 2rem; }
    .next-label { font-size: 0.72rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
    .next-page { font-size: 0.88rem; color: #e2e8f0; font-family: monospace; }
    .next-date { font-size: 0.78rem; color: #38bdf8; margin-top: 0.2rem; }
    /* run history */
    .run-card { background: #1e293b; border-radius: 10px; padding: 1rem 1.2rem; margin-bottom: 0.75rem; border-left: 3px solid #334155; }
    .run-card.run-auto { border-left-color: #38bdf8; }
    .run-card.run-manual { border-left-color: #818cf8; }
    .run-card.run-local  { border-left-color: #64748b; }
    .run-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem; }
    .run-date { font-size: 0.85rem; font-weight: 700; color: #e2e8f0; }
    .run-meta { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .run-trigger { font-size: 0.7rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 999px; }
    .run-trigger-auto   { background: #1c3148; color: #38bdf8; }
    .run-trigger-manual { background: #1e1a2e; color: #818cf8; }
    .run-trigger-local  { background: #1e293b; color: #64748b; }
    .run-by { font-size: 0.7rem; color: #475569; }
    .run-ts { font-size: 0.68rem; color: #334155; font-family: monospace; }
    .run-pages { display: flex; flex-direction: column; gap: 0.3rem; }
    .run-page { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; }
    .run-page-url { color: #94a3b8; font-family: monospace; font-size: 0.77rem; }
    .run-page-label { color: #64748b; font-size: 0.72rem; }
    .run-stats { font-size: 0.72rem; color: #475569; margin-top: 0.4rem; border-top: 1px solid #0f172a; padding-top: 0.4rem; }
    .run-empty { color: #334155; font-size: 0.8rem; padding: 1rem; text-align: center; background: #1e293b; border-radius: 10px; margin-bottom: 2rem; }
    .queue-info { background: #1e293b; border-radius: 10px; padding: 0.8rem 1.1rem; display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.78rem; color: #94a3b8; margin-bottom: 2rem; }
    .queue-info strong { color: #e2e8f0; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>📊 HomeMaterialCalc — Admin Dashboard</h1>
    <p class="subtitle">Yayın durumu · Sadece sen görüyorsun (noindex)</p>

    <!-- Stats -->
    <div class="grid">
      <div class="stat">
        <div class="stat-n">{published.length}</div>
        <div class="stat-l">Toplam yayında</div>
      </div>
      <div class="stat">
        <div class="stat-n" style="color:#7dd3fc">{pubCalcs.length}</div>
        <div class="stat-l">Calculator canlı</div>
      </div>
      <div class="stat">
        <div class="stat-n" style="color:#86efac">{pubGuides.length}</div>
        <div class="stat-l">Guide canlı</div>
      </div>
      <div class="stat">
        <div class="stat-n" style="color:#fcd34d">{pubRefs.length}</div>
        <div class="stat-l">Reference canlı</div>
      </div>
      <div class="stat">
        <div class="stat-n" style="color:#f472b6">{pending.length}</div>
        <div class="stat-l">Sırada (pending)</div>
      </div>
      <div class="stat">
        <div class="stat-n">{pagesPerRun}/gün</div>
        <div class="stat-l">Yayın hızı</div>
      </div>
    </div>

    <!-- Info bar -->
    <div class="info-bar">
      <span>Son çalışma: <strong>{lastRun}</strong></span>
      <span>Bugün: <strong>{today}</strong></span>
      <span>GitHub Actions: <strong>Her gün 09:00 UTC</strong></span>
      <span>Canlı site: <a href="https://www.homematerialcalc.com" target="_blank">homematerialcalc.com</a></span>
      <span>Toplam URL: <strong>{published.filter(p => !['/privacy','/terms','/contact','/contact-success'].includes(p.url)).length}</strong></span>
    </div>

    <!-- Queue projection -->
    <div class="queue-info">
      <span>Sırada: <strong>{pending.length} sayfa</strong></span>
      <span>Tahmini bitiş: <strong>{emptyDate ?? '—'}</strong></span>
      <span>Toplam çalışma: <strong>{runs.length} kez</strong></span>
      <span>Son çalışma türü: <strong>{runs[0]?.trigger ? triggerLabel(runs[0].trigger) : '—'}</strong></span>
    </div>

    <!-- Next up -->
    {pendingWithETA.length > 0 && (
      <div class="countdown">
        <div class="next-label">Sonraki yayın</div>
        <div class="next-page">{pendingWithETA[0].url}</div>
        <div class="next-date">Tahmini tarih: {pendingWithETA[0].eta} — {pendingWithETA[0].label}</div>
      </div>
    )}

    <!-- ─── Run History ─────────────────────────────────────────────────── -->
    <div class="section">
      <div class="section-header">
        <span>🕐 Yayın Geçmişi — {runs.length} çalışma</span>
        <span style="font-size:0.7rem;font-weight:400;color:#475569">En yeni üstte · max 30 gösterilir</span>
      </div>

      {recentRuns.length === 0 && (
        <div class="run-empty">
          Henüz hiç otomatik yayın çalışmadı.<br/>
          GitHub Actions her gün 09:00 UTC'de çalışır ve burayı günceller.
        </div>
      )}

      {recentRuns.map((run: any) => {
        const triggerClass =
          run.trigger === 'scheduled' ? 'run-auto' :
          run.trigger === 'manual_dispatch' ? 'run-manual' : 'run-local';
        const triggerBadgeClass =
          run.trigger === 'scheduled' ? 'run-trigger-auto' :
          run.trigger === 'manual_dispatch' ? 'run-trigger-manual' : 'run-trigger-local';
        return (
          <div class={`run-card ${triggerClass}`}>
            <div class="run-header">
              <span class="run-date">{run.date}</span>
              <div class="run-meta">
                <span class={`run-trigger ${triggerBadgeClass}`}>{triggerLabel(run.trigger)}</span>
                {run.runBy && run.runBy !== 'local' && <span class="run-by">by {run.runBy}</span>}
                <span class="run-ts">{run.timestamp?.replace('T', ' ').replace(/\.\d{3}Z$/, ' UTC') ?? ''}</span>
              </div>
            </div>
            <div class="run-pages">
              {(run.pagesPublished ?? []).map((p: any) => (
                <div class="run-page">
                  <span class={`badge ${
                    p.type === 'calculator' ? 'badge-type-calc' :
                    p.type === 'guide' ? 'badge-type-guide' : 'badge-type-ref'
                  }`}>{p.type ?? '?'}</span>
                  <span class="run-page-url">
                    <a href={`https://www.homematerialcalc.com${p.url}`} target="_blank">{p.url}</a>
                  </span>
                  <span class="run-page-label">— {p.label}</span>
                </div>
              ))}
            </div>
            <div class="run-stats">
              Önce {run.pendingBefore} pending · Sonra {run.pendingAfter} pending
            </div>
          </div>
        );
      })}
    </div>

    <!-- Pending — grouped by type -->
    <div class="section">
      <div class="section-header">
        <span>⏳ Sırada — {pending.length} sayfa</span>
        <span style="font-size:0.7rem;font-weight:400;color:#475569">{pendCalcs.length} calc · {pendGuides.length} guide · {pendRefs.length} ref</span>
      </div>

      {pendCalcs.length > 0 && (
        <div class="type-block">
          <div class="type-label">🔧 Calculators ({pendCalcs.length})</div>
          {pendCalcs.map(p => (
            <div class="row">
              <div>
                <div class="row-url">{p.url}</div>
                <div class="row-label">{p.label}</div>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem;">
                <span class="badge badge-type-calc">calc</span>
                <span class="row-date">~{p.eta}</span>
              </div>
            </div>
          ))}
        </div>
      )}

      {pendGuides.length > 0 && (
        <div class="type-block">
          <div class="type-label">📖 Guides ({pendGuides.length})</div>
          {pendGuides.map(p => (
            <div class="row">
              <div>
                <div class="row-url">{p.url}</div>
                <div class="row-label">{p.label}</div>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem;">
                <span class="badge badge-type-guide">guide</span>
                <span class="row-date">~{p.eta}</span>
              </div>
            </div>
          ))}
        </div>
      )}

      {pendRefs.length > 0 && (
        <div class="type-block">
          <div class="type-label">📋 Reference ({pendRefs.length})</div>
          {pendRefs.map(p => (
            <div class="row">
              <div>
                <div class="row-url">{p.url}</div>
                <div class="row-label">{p.label}</div>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem;">
                <span class="badge badge-type-ref">ref</span>
                <span class="row-date">~{p.eta}</span>
              </div>
            </div>
          ))}
        </div>
      )}

      {pending.length === 0 && <p class="empty">Sırada sayfa yok.</p>}
    </div>

    <!-- Future -->
    {future.length > 0 && (
      <div class="section">
        <div class="section-header">🔮 Planlanmış — {future.length} sayfa (henüz yazılmamış)</div>
        {future.map(p => (
          <div class="row">
            <div>
              <div class="row-url">{p.url}</div>
              <div class="row-label">{p.label}</div>
            </div>
            <span class="badge badge-fut">future</span>
          </div>
        ))}
      </div>
    )}

    <!-- Published — grouped by type, then by date -->
    <div class="section">
      <div class="section-header">
        <span>✅ Yayında — {published.length} sayfa</span>
        <span style="font-size:0.7rem;font-weight:400;color:#475569">{pubCalcs.length} calc · {pubGuides.length} guide · {pubRefs.length} ref · {pubStatic.length} static</span>
      </div>

      <!-- Type legend -->
      <div class="tabs" style="margin-bottom:1rem;">
        <span class="tab tab-calc">🔧 Calculators ({pubCalcs.length})</span>
        <span class="tab tab-guide">📖 Guides ({pubGuides.length})</span>
        <span class="tab tab-ref">📋 Reference ({pubRefs.length})</span>
        <span class="tab tab-static">📄 Static ({pubStatic.length})</span>
      </div>

      <!-- Published Calculators -->
      {pubCalcs.length > 0 && (
        <div class="type-block">
          <div class="type-label">🔧 Calculators</div>
          {pubCalcs.map(p => (
            <div class="row">
              <div>
                <div class="row-url">
                  <a href={`https://www.homematerialcalc.com${p.url}`} target="_blank">{p.url}</a>
                </div>
                <div class="row-label">{p.label}</div>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem;">
                <span class="badge badge-type-calc">calc</span>
                <span class="badge badge-pub">live</span>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- Published Guides -->
      {pubGuides.length > 0 && (
        <div class="type-block">
          <div class="type-label">📖 Guides</div>
          {pubGuides.map(p => (
            <div class="row">
              <div>
                <div class="row-url">
                  <a href={`https://www.homematerialcalc.com${p.url}`} target="_blank">{p.url}</a>
                </div>
                <div class="row-label">{p.label}</div>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem;">
                <span class="badge badge-type-guide">guide</span>
                <span class="badge badge-pub">live</span>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- Published Reference -->
      {pubRefs.length > 0 && (
        <div class="type-block">
          <div class="type-label">📋 Reference</div>
          {pubRefs.map(p => (
            <div class="row">
              <div>
                <div class="row-url">
                  <a href={`https://www.homematerialcalc.com${p.url}`} target="_blank">{p.url}</a>
                </div>
                <div class="row-label">{p.label}</div>
              </div>
              <div style="display:flex;align-items:center;gap:0.6rem;">
                <span class="badge badge-type-ref">ref</span>
                <span class="badge badge-pub">live</span>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- Published Static pages -->
      {pubStatic.length > 0 && (
        <div class="type-block">
          <div class="type-label">📄 Static</div>
          {pubStatic.map(p => (
            <div class="row">
              <div>
                <div class="row-url">
                  <a href={`https://www.homematerialcalc.com${p.url}`} target="_blank">{p.url}</a>
                </div>
                <div class="row-label">{p.label}</div>
              </div>
              <span class="badge badge-pub">live</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</body>
</html>
