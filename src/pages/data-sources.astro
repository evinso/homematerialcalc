---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Data Sources & Material References — HomeMaterialCalc"
  description="Every formula and material constant used by HomeMaterialCalc, with its source. Concrete yields, gravel densities, sod coverage, paint coverage — all cited."
>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6 flex flex-wrap gap-1">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>›</span>
      <span class="text-gray-700">Data Sources</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-3">Data Sources & Material References</h1>
    <p class="text-gray-600 mb-8">Every constant used in our calculators is drawn from published manufacturer specs, industry standards, or exact mathematical identities. This page lists each value and its source so you can verify our calculations independently.</p>

    <div class="space-y-10 text-sm text-gray-700">

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Universal Conversions</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Conversion</th><th class="py-2 pr-4 font-semibold text-gray-900">Value</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">1 cubic yard → cubic feet</td><td class="py-2 pr-4 font-mono">27</td><td class="py-2">Exact mathematical identity</td></tr>
            <tr><td class="py-2 pr-4">1 ton (US short) → pounds</td><td class="py-2 pr-4 font-mono">2,000</td><td class="py-2">US customary standard</td></tr>
            <tr><td class="py-2 pr-4">1 square yard → square feet</td><td class="py-2 pr-4 font-mono">9</td><td class="py-2">Exact mathematical identity</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Mulch</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Constant</th><th class="py-2 pr-4 font-semibold text-gray-900">Value</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">Bag yield</td><td class="py-2 pr-4 font-mono">2 cu ft per bag</td><td class="py-2">Industry standard bag size (Scotts, Vigoro, etc.)</td></tr>
            <tr><td class="py-2 pr-4">Bags per cubic yard</td><td class="py-2 pr-4 font-mono">13.5</td><td class="py-2">27 ÷ 2 = 13.5 (exact)</td></tr>
            <tr><td class="py-2 pr-4">Default depth</td><td class="py-2 pr-4 font-mono">3 inches</td><td class="py-2">University extension service best practice for landscape beds</td></tr>
            <tr><td class="py-2 pr-4">Default waste factor</td><td class="py-2 pr-4 font-mono">5%</td><td class="py-2">Industry rule of thumb for regular-shaped beds</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Gravel / Crushed Stone</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Material</th><th class="py-2 pr-4 font-semibold text-gray-900">Tons/cu yd</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">Pea gravel</td><td class="py-2 pr-4 font-mono">1.40</td><td class="py-2">Aggregate industry standard (supplier averages)</td></tr>
            <tr><td class="py-2 pr-4">Crushed stone (3/4")</td><td class="py-2 pr-4 font-mono">1.40</td><td class="py-2">Aggregate industry standard</td></tr>
            <tr><td class="py-2 pr-4">Crushed limestone</td><td class="py-2 pr-4 font-mono">1.50</td><td class="py-2">Aggregate industry standard</td></tr>
            <tr><td class="py-2 pr-4">River rock (1–3")</td><td class="py-2 pr-4 font-mono">1.35</td><td class="py-2">Aggregate industry standard</td></tr>
            <tr><td class="py-2 pr-4">Decomposed granite</td><td class="py-2 pr-4 font-mono">1.35</td><td class="py-2">Aggregate industry standard</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Topsoil</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Constant</th><th class="py-2 pr-4 font-semibold text-gray-900">Value</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">Density</td><td class="py-2 pr-4 font-mono">1.10 tons/cu yd</td><td class="py-2">Soil supplier industry standard (dry topsoil)</td></tr>
            <tr><td class="py-2 pr-4">40 lb bag yield</td><td class="py-2 pr-4 font-mono">0.75 cu ft</td><td class="py-2">Manufacturer average (Scotts, Miracle-Gro)</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Sand</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Material</th><th class="py-2 pr-4 font-semibold text-gray-900">Tons/cu yd</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">All-purpose / paver sand</td><td class="py-2 pr-4 font-mono">1.35</td><td class="py-2">Supplier standard</td></tr>
            <tr><td class="py-2 pr-4">Play sand / mason sand</td><td class="py-2 pr-4 font-mono">1.30</td><td class="py-2">Supplier standard</td></tr>
            <tr><td class="py-2 pr-4">50 lb bag yield</td><td class="py-2 pr-4 font-mono">0.50 cu ft</td><td class="py-2">Manufacturer average</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Sod</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Constant</th><th class="py-2 pr-4 font-semibold text-gray-900">Value</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">Piece size</td><td class="py-2 pr-4 font-mono">16" × 24" = 2.67 sq ft</td><td class="py-2">US sod industry standard piece</td></tr>
            <tr><td class="py-2 pr-4">Pallet coverage</td><td class="py-2 pr-4 font-mono">~450 sq ft (170 pieces)</td><td class="py-2">US sod farm industry standard</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Concrete (bagged pre-mix)</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Bag size</th><th class="py-2 pr-4 font-semibold text-gray-900">Yield (cu ft)</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">40 lb</td><td class="py-2 pr-4 font-mono">0.30</td><td class="py-2">Quikrete published product specifications</td></tr>
            <tr><td class="py-2 pr-4">50 lb</td><td class="py-2 pr-4 font-mono">0.375</td><td class="py-2">Quikrete published product specifications</td></tr>
            <tr><td class="py-2 pr-4">60 lb</td><td class="py-2 pr-4 font-mono">0.45</td><td class="py-2">Quikrete / Sakrete published specifications</td></tr>
            <tr><td class="py-2 pr-4">80 lb</td><td class="py-2 pr-4 font-mono">0.60</td><td class="py-2">Quikrete / Sakrete published specifications</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Paint</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Surface type</th><th class="py-2 pr-4 font-semibold text-gray-900">Coverage (sq ft/gallon)</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">Standard wall paint</td><td class="py-2 pr-4 font-mono">350</td><td class="py-2">Sherwin-Williams / Benjamin Moore average</td></tr>
            <tr><td class="py-2 pr-4">Premium paint</td><td class="py-2 pr-4 font-mono">400</td><td class="py-2">High-coverage product average</td></tr>
            <tr><td class="py-2 pr-4">Primer</td><td class="py-2 pr-4 font-mono">250</td><td class="py-2">Primer manufacturer average</td></tr>
            <tr><td class="py-2 pr-4">Textured surface</td><td class="py-2 pr-4 font-mono">275</td><td class="py-2">Industry rule for textured/popcorn surfaces</td></tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-4">Flooring, Tile & Drywall</h2>
        <table class="w-full border-collapse">
          <thead><tr class="border-b-2 border-gray-200 text-left"><th class="py-2 pr-4 font-semibold text-gray-900">Constant</th><th class="py-2 pr-4 font-semibold text-gray-900">Value</th><th class="py-2 font-semibold text-gray-900">Source</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <tr><td class="py-2 pr-4">Flooring waste (straight)</td><td class="py-2 pr-4 font-mono">10%</td><td class="py-2">NWFA installation guidelines</td></tr>
            <tr><td class="py-2 pr-4">Flooring waste (diagonal)</td><td class="py-2 pr-4 font-mono">15%</td><td class="py-2">NWFA installation guidelines</td></tr>
            <tr><td class="py-2 pr-4">Tile waste (straight)</td><td class="py-2 pr-4 font-mono">10%</td><td class="py-2">TCNA Handbook for Ceramic, Glass and Stone Tile Installation</td></tr>
            <tr><td class="py-2 pr-4">Tile waste (diagonal)</td><td class="py-2 pr-4 font-mono">15%</td><td class="py-2">TCNA Handbook</td></tr>
            <tr><td class="py-2 pr-4">Thinset (50 lb bag)</td><td class="py-2 pr-4 font-mono">40 sq ft</td><td class="py-2">3/8" notched trowel, manufacturer average</td></tr>
            <tr><td class="py-2 pr-4">Drywall sheet (4×8)</td><td class="py-2 pr-4 font-mono">32 sq ft</td><td class="py-2">Exact: 4 × 8 = 32</td></tr>
            <tr><td class="py-2 pr-4">Joint compound (1 gal)</td><td class="py-2 pr-4 font-mono">100 sq ft</td><td class="py-2">USG / National Gypsum average for 3-coat finish</td></tr>
          </tbody>
        </table>
      </section>

      <section class="bg-gray-50 rounded-xl p-5 text-gray-600">
        <p><strong>Note:</strong> All density and yield values are approximate averages. Actual weights vary with moisture content, compaction, and product. We recommend confirming quantities with your local supplier before placing a large order. See our <a href="/calculation-assumptions" class="text-brand-600 hover:underline">Calculation Assumptions</a> page for default values and rounding rules.</p>
      </section>

    </div>

    <div class="mt-10 pt-6 border-t border-gray-200 flex flex-wrap gap-4 text-sm">
      <a href="/how-it-works" class="text-brand-600 hover:underline">How Our Calculators Work →</a>
      <a href="/calculation-assumptions" class="text-brand-600 hover:underline">Calculation Assumptions →</a>
      <a href="/methodology" class="text-brand-600 hover:underline">Methodology →</a>
    </div>
  </div>
</BaseLayout>
