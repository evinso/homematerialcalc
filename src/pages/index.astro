---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = 'https://www.homematerialcalc.com';

const outdoor = [
  { slug: 'mulch',      label: 'Mulch',      icon: '🌿', unit: 'bags / cu yd'    },
  { slug: 'gravel',     label: 'Gravel',     icon: '🪨', unit: 'cu yd / tons'    },
  { slug: 'topsoil',    label: 'Topsoil',    icon: '🌱', unit: 'cu yd / bags'    },
  { slug: 'sand',       label: 'Sand',       icon: '⏳', unit: 'cu yd / bags'    },
  { slug: 'sod',        label: 'Sod',        icon: '🌾', unit: 'pallets / pieces'},
  { slug: 'paver',      label: 'Pavers',     icon: '🧱', unit: 'pieces + base'   },
  { slug: 'grass-seed', label: 'Grass Seed', icon: '🌻', unit: 'lbs needed'      },
  { slug: 'asphalt',    label: 'Asphalt',    icon: '🛣️', unit: 'tons / cu yd'   },
];

const concrete = [
  { slug: 'concrete',      label: 'Concrete',       icon: '🏗️', unit: 'bags / cu yd'   },
  { slug: 'concrete-cost', label: 'Concrete Cost',  icon: '💰', unit: 'price estimate'  },
  { slug: 'fence',         label: 'Fence',          icon: '🚧', unit: 'posts + boards'  },
  { slug: 'deck',          label: 'Deck',           icon: '🏡', unit: 'boards + joists' },
  { slug: 'project',       label: 'Project Planner',icon: '📋', unit: 'full list'       },
];

const interior = [
  { slug: 'paint',      label: 'Paint',      icon: '🖌️', unit: 'gallons'         },
  { slug: 'flooring',   label: 'Flooring',   icon: '🪵', unit: 'boxes'           },
  { slug: 'tile',       label: 'Tile',       icon: '⬜', unit: 'tiles + thinset' },
  { slug: 'drywall',    label: 'Drywall',    icon: '🔲', unit: 'sheets'          },
  { slug: 'lumber',     label: 'Lumber',     icon: '🪚', unit: 'board feet'      },
  { slug: 'insulation', label: 'Insulation', icon: '🏠', unit: 'bags / rolls'    },
];

const outdoorHowTo = [
  { href: '/guide/how-to-build-a-patio',             label: 'Build a Paver Patio',    desc: 'Gravel base, sand & pavers — full materials list' },
  { href: '/guide/how-to-build-a-gravel-driveway',   label: 'Build a Gravel Driveway',desc: '3-layer system, tons & cost' },
  { href: '/guide/how-to-build-a-raised-garden-bed', label: 'Build a Raised Garden Bed', desc: 'Soil mix, lumber & quantities' },
  { href: '/guide/how-to-lay-pavers',                label: 'Lay Pavers',             desc: 'Sand base, pattern & joint sand' },
  { href: '/guide/how-to-reseed-a-lawn',             label: 'Reseed a Lawn',          desc: 'Seed rates, timing & soil prep' },
  { href: '/guide/how-to-pour-a-concrete-slab',      label: 'Pour a Concrete Slab',   desc: 'Formwork, rebar, bags vs ready-mix' },
];

const interiorHowTo = [
  { href: '/guide/how-to-paint-a-room',             label: 'Paint a Room',              desc: 'Prep, priming & rolling — gallons per room' },
  { href: '/guide/how-to-install-laminate-flooring',label: 'Install Laminate Flooring', desc: 'Click-lock, underlayment & expansion gap' },
  { href: '/guide/how-to-install-tile',             label: 'Install Tile',              desc: 'Substrate, thinset, grout & sealing' },
  { href: '/guide/how-to-hang-drywall',             label: 'Hang Drywall',              desc: 'Sheets, taping & finishing levels' },
  { href: '/guide/how-to-insulate-an-attic',        label: 'Insulate an Attic',         desc: 'R-value, bags & air sealing' },
  { href: '/guide/how-to-build-a-garden-path',      label: 'Build a Garden Path',       desc: 'Gravel, edging & fabric' },
];

const comparisons = [
  { href: '/guide/mulch-vs-rock-landscaping',        label: 'Mulch vs Rock',              icon: '🌿' },
  { href: '/guide/sod-vs-seed',                      label: 'Sod vs Seed',                icon: '🌾' },
  { href: '/guide/asphalt-vs-concrete-driveway',     label: 'Asphalt vs Concrete',        icon: '🛣️' },
  { href: '/guide/pea-gravel-vs-river-rock',         label: 'Pea Gravel vs River Rock',   icon: '🪨' },
  { href: '/guide/laminate-vs-hardwood-flooring',    label: 'Laminate vs Hardwood',       icon: '🪵' },
  { href: '/guide/vinyl-plank-vs-laminate-flooring', label: 'Vinyl Plank vs Laminate',    icon: '⬜' },
  { href: '/guide/tile-vs-vinyl-flooring',           label: 'Tile vs Vinyl Flooring',     icon: '🏠' },
  { href: '/guide/blown-in-vs-batt-insulation',      label: 'Blown-In vs Batt Insulation',icon: '🏠' },
  { href: '/guide/artificial-grass-vs-sod',          label: 'Artificial Grass vs Sod',    icon: '🌱' },
  { href: '/guide/spray-foam-vs-fiberglass-insulation', label: 'Spray Foam vs Fiberglass',icon: '🏠' },
  { href: '/guide/cedar-vs-pressure-treated-wood',   label: 'Cedar vs Pressure Treated',  icon: '🪵' },
  { href: '/guide/concrete-vs-pavers-patio',         label: 'Concrete vs Pavers',         icon: '🧱' },
];

const costGuides = [
  { href: '/guide/how-much-does-mulch-cost',    label: 'Mulch Cost Guide',    unit: '$25–$65/cu yd', icon: '🌿' },
  { href: '/guide/how-much-does-gravel-cost',   label: 'Gravel Cost Guide',   unit: '$15–$80/ton',   icon: '🪨' },
  { href: '/guide/how-much-does-concrete-cost', label: 'Concrete Cost Guide', unit: '$130–$200/cu yd',icon: '🏗️' },
  { href: '/guide/how-much-does-insulation-cost',label: 'Insulation Cost Guide',unit: '$0.30–$3.50/sq ft',icon: '🏠' },
  { href: '/guide/how-much-does-flooring-cost', label: 'Flooring Cost Guide', unit: '$1–$15/sq ft',  icon: '🪵' },
  { href: '/guide/how-much-does-drywall-cost',  label: 'Drywall Cost Guide',  unit: '$12–$22/sheet', icon: '🔲' },
  { href: '/guide/how-much-does-lumber-cost',   label: 'Lumber Cost Guide',   unit: '$0.80–$5/board ft',icon: '🪚' },
  { href: '/guide/how-much-does-tile-cost',     label: 'Tile Cost Guide',     unit: '$1–$30/sq ft',  icon: '⬜' },
];

const seasonal = [
  { href: '/guide/spring-lawn-and-garden-checklist', label: 'Spring Checklist', icon: '🌸', desc: 'Mulch, seed & fertilizer timing' },
  { href: '/guide/summer-lawn-care-guide',            label: 'Summer Care',     icon: '☀️', desc: 'Watering, mowing & heat tips' },
  { href: '/guide/fall-yard-prep-checklist',          label: 'Fall Prep',       icon: '🍂', desc: 'Overseed, winterize & mulch' },
  { href: '/guide/winter-landscaping-prep',           label: 'Winter Prep',     icon: '❄️', desc: 'Driveway, paths & plant protection' },
];

const faqs = [
  { q: 'How do I calculate how much mulch I need?', a: 'Multiply your bed length (ft) × width (ft) × depth (in) ÷ 324 to get cubic yards, then × 13.5 for 2 cu ft bags. The Mulch Calculator does this instantly for any shape.' },
  { q: 'How many bags of concrete for a 10×10 slab?', a: 'At 4 inches thick: 1.23 cubic yards = 56 bags of 80 lb concrete (with 10% waste). The Concrete Calculator covers any size, thickness, and bag weight.' },
  { q: 'How many gallons of paint for a room?', a: 'A 12×12 ft room with 8 ft ceilings needs about 2 gallons for 2 coats. The Paint Calculator subtracts doors and windows and handles multiple coats automatically.' },
  { q: 'What is the Project Calculator?', a: 'The Project Calculator gives you every material for a complete project — patio, driveway, raised bed, or garden path — in one place. Enter dimensions once and get the full shopping list: gravel, sand, pavers, soil, and cost estimates.' },
  { q: 'Are these calculators free?', a: 'Yes — all calculators are completely free with no signup required. Every result shows the step-by-step breakdown so you can verify the math yourself.' },
  { q: 'How accurate are the material estimates?', a: 'Formulas are based on manufacturer specifications (Quikrete, Scotts) and industry standards. All calculations include a recommended waste factor. See the Methodology page for full details and sources.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'HomeMaterialCalc',
  url: siteUrl,
  description: 'Free material calculators for US homeowners — mulch, gravel, concrete, paint, flooring, tile, drywall, lumber and more.',
};
---

<BaseLayout
  title="Material Calculator — Mulch, Gravel, Concrete, Paint & More | Free"
  description="Free material calculators for US homeowners. Calculate mulch, gravel, concrete, paint, flooring, tile & more — get exact bags, cubic yards, or gallons instantly."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  </Fragment>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-brand-100 text-brand-700 text-xs font-semibold px-3 py-1 rounded-full mb-4">
        20 free calculators · No signup · URL sharing
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight">
        How Much Material Do You Need?
      </h1>
      <p class="mt-4 text-lg text-gray-600 max-w-xl mx-auto">
        Enter your dimensions — get the <strong>exact quantity to buy</strong> in bags,
        cubic yards, gallons, or pallets. Built for US homeowners and DIYers.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/calculator/mulch"    class="bg-brand-600 text-white font-semibold px-5 py-3 rounded-xl hover:bg-brand-700 transition-colors text-sm">🌿 Mulch</a>
        <a href="/calculator/gravel"   class="bg-white border border-gray-300 text-gray-800 font-semibold px-5 py-3 rounded-xl hover:border-brand-400 hover:text-brand-700 transition-colors text-sm">🪨 Gravel</a>
        <a href="/calculator/concrete" class="bg-white border border-gray-300 text-gray-800 font-semibold px-5 py-3 rounded-xl hover:border-brand-400 hover:text-brand-700 transition-colors text-sm">🏗️ Concrete</a>
        <a href="/calculator/paint"    class="bg-white border border-gray-300 text-gray-800 font-semibold px-5 py-3 rounded-xl hover:border-brand-400 hover:text-brand-700 transition-colors text-sm">🖌️ Paint</a>
        <a href="/calculator/project"  class="bg-amber-500 text-white font-semibold px-5 py-3 rounded-xl hover:bg-amber-600 transition-colors text-sm">📋 Project Planner</a>
      </div>
    </div>
  </section>

  <!-- ── CALCULATORS ────────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 pt-12 pb-4">

    <!-- Outdoor & Landscaping -->
    <div class="mb-10">
      <div class="flex items-baseline gap-3 mb-1">
        <h2 class="text-xl font-bold text-gray-900">🌿 Outdoor & Landscaping</h2>
        <a href="/landscaping-calculators" class="text-xs text-brand-600 hover:underline">All landscaping →</a>
      </div>
      <p class="text-sm text-gray-500 mb-4">Mulch, gravel, topsoil, sand, sod, and pavers — in bags, cubic yards, or tons.</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
        {outdoor.map(({ slug, label, icon, unit }) => (
          <a href={`/calculator/${slug}`}
             class="bg-white border border-gray-200 rounded-xl p-3 hover:border-brand-400 hover:shadow-sm transition-all group text-center">
            <div class="text-2xl mb-1.5">{icon}</div>
            <p class="font-semibold text-gray-900 text-xs group-hover:text-brand-700">{label}</p>
            <p class="text-xs text-gray-400 mt-0.5 leading-tight">{unit}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Concrete & Construction -->
    <div class="mb-10">
      <div class="flex items-baseline gap-3 mb-1">
        <h2 class="text-xl font-bold text-gray-900">🏗️ Concrete & Construction</h2>
        <a href="/concrete-calculators" class="text-xs text-brand-600 hover:underline">All concrete →</a>
      </div>
      <p class="text-sm text-gray-500 mb-4">Concrete bags, fence posts, deck boards, and full project materials lists.</p>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        {concrete.map(({ slug, label, icon, unit }) => (
          <a href={`/calculator/${slug}`}
             class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 hover:shadow-sm transition-all group text-center">
            <div class="text-2xl mb-2">{icon}</div>
            <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
            <p class="text-xs text-gray-400 mt-1">{unit}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Interior -->
    <div class="mb-4">
      <div class="flex items-baseline gap-3 mb-1">
        <h2 class="text-xl font-bold text-gray-900">🏠 Interior</h2>
        <a href="/interior-calculators" class="text-xs text-brand-600 hover:underline">All interior →</a>
      </div>
      <p class="text-sm text-gray-500 mb-4">Paint gallons, flooring boxes, tile count, drywall sheets, lumber, and insulation.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {interior.map(({ slug, label, icon, unit }) => (
          <a href={`/calculator/${slug}`}
             class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 hover:shadow-sm transition-all group text-center">
            <div class="text-2xl mb-2">{icon}</div>
            <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
            <p class="text-xs text-gray-400 mt-1">{unit}</p>
          </a>
        ))}
      </div>
    </div>

  </section>

  <!-- ── HOW-TO GUIDES ──────────────────────────────────────────────────── -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-1">🔨 How-To Project Guides</h2>
      <p class="text-sm text-gray-500 mb-6">Step-by-step guides with materials lists, quantities, and cost breakdowns.</p>
      <div class="grid sm:grid-cols-2 gap-8">

        <!-- Outdoor -->
        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Outdoor & Landscaping</h3>
          <div class="space-y-2">
            {outdoorHowTo.map(({ href, label, desc }) => (
              <a href={href} class="flex items-start gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-brand-400 hover:shadow-sm transition-all group">
                <span class="text-brand-600 font-bold text-sm mt-0.5 flex-shrink-0">→</span>
                <div>
                  <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
                  <p class="text-xs text-gray-400 mt-0.5">{desc}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Interior -->
        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Interior & Home</h3>
          <div class="space-y-2">
            {interiorHowTo.map(({ href, label, desc }) => (
              <a href={href} class="flex items-start gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-brand-400 hover:shadow-sm transition-all group">
                <span class="text-brand-600 font-bold text-sm mt-0.5 flex-shrink-0">→</span>
                <div>
                  <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
                  <p class="text-xs text-gray-400 mt-0.5">{desc}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── COMPARE MATERIALS ───────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex items-baseline gap-3 mb-1">
      <h2 class="text-2xl font-bold text-gray-900">⚖️ Compare Materials</h2>
      <a href="/compare" class="text-xs text-brand-600 hover:underline">Comparison tool →</a>
    </div>
    <p class="text-sm text-gray-500 mb-6">Side-by-side cost, lifespan, and best-use comparisons for common material choices.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {comparisons.map(({ href, label, icon }) => (
        <a href={href}
           class="flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-700 hover:border-brand-400 hover:text-brand-700 transition-colors">
          <span class="text-lg flex-shrink-0">{icon}</span>
          <span class="font-medium">{label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── COST GUIDES ─────────────────────────────────────────────────────── -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-1">💵 2026 Cost Guides</h2>
      <p class="text-sm text-gray-500 mb-6">Current material prices — bags vs. bulk, DIY vs. pro, and regional ranges.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {costGuides.map(({ href, label, unit, icon }) => (
          <a href={href}
             class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 hover:shadow-sm transition-all group">
            <div class="text-2xl mb-2">{icon}</div>
            <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700 mb-1">{label}</p>
            <p class="text-xs text-gray-400">{unit}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TOOLS ───────────────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-1">🛠️ Tools & Resources</h2>
    <p class="text-sm text-gray-500 mb-6">Planning tools, price data, and comparisons — all free.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">

      <a href="/calculator/project"
         class="group bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-5 hover:border-amber-400 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">📋</div>
        <h3 class="font-bold text-gray-900 mb-1 group-hover:text-amber-700">Project Planner</h3>
        <p class="text-sm text-gray-600 mb-3">Enter dimensions once — get the full materials list for patios, driveways, raised beds, and garden paths.</p>
        <span class="text-xs font-semibold text-amber-700 bg-amber-100 px-2 py-1 rounded-full">4 project types</span>
      </a>

      <a href="/compare"
         class="group bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl p-5 hover:border-blue-400 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">⚖️</div>
        <h3 class="font-bold text-gray-900 mb-1 group-hover:text-blue-700">Compare Materials</h3>
        <p class="text-sm text-gray-600 mb-3">Mulch vs rock, sod vs seed, asphalt vs concrete — side-by-side tables on cost, lifespan, and best uses.</p>
        <span class="text-xs font-semibold text-blue-700 bg-blue-100 px-2 py-1 rounded-full">12 comparisons</span>
      </a>

      <a href="/prices"
         class="group bg-gradient-to-br from-green-50 to-emerald-50 border border-green-200 rounded-2xl p-5 hover:border-green-400 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">💵</div>
        <h3 class="font-bold text-gray-900 mb-1 group-hover:text-green-700">2026 Price Guide</h3>
        <p class="text-sm text-gray-600 mb-3">Current national average prices for mulch, gravel, concrete, topsoil, sod, sand, and paint with regional ranges.</p>
        <span class="text-xs font-semibold text-green-700 bg-green-100 px-2 py-1 rounded-full">Updated June 2026</span>
      </a>

      <a href="/embed"
         class="group bg-gradient-to-br from-purple-50 to-pink-50 border border-purple-200 rounded-2xl p-5 hover:border-purple-400 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">🔗</div>
        <h3 class="font-bold text-gray-900 mb-1 group-hover:text-purple-700">Embed a Calculator</h3>
        <p class="text-sm text-gray-600 mb-3">Add any calculator to your contractor or landscaping website. Free iframe code — no signup needed.</p>
        <span class="text-xs font-semibold text-purple-700 bg-purple-100 px-2 py-1 rounded-full">Free for everyone</span>
      </a>

    </div>
  </section>

  <!-- ── SEASONAL ────────────────────────────────────────────────────────── -->
  <section class="bg-gray-50 py-10 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-xl font-bold text-gray-900 mb-1">📅 Seasonal Guides</h2>
      <p class="text-sm text-gray-500 mb-5">Right task, right time — seasonal checklists for your lawn and garden.</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {seasonal.map(({ href, label, icon, desc }) => (
          <a href={href}
             class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 hover:shadow-sm transition-all group text-center">
            <div class="text-3xl mb-2">{icon}</div>
            <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
            <p class="text-xs text-gray-400 mt-1">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ────────────────────────────────────────────────────── -->
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">How it works — 3 steps</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      {[
        { n: '1', icon: '📏', title: 'Enter your dimensions', text: 'Length, width — and depth for bulk materials. Works for rectangles, circles, or irregular shapes.' },
        { n: '2', icon: '⚙️', title: 'We do the math',        text: 'Each calculator uses verified material constants — bag yields, densities, coverage rates. Your last values are saved automatically.' },
        { n: '3', icon: '🛒', title: 'Get your shopping list',text: 'See the exact quantity in bags, cubic yards, gallons, or pallets. Print or save as PDF to take to the store.' },
      ].map(({ n, icon, title, text }) => (
        <div class="bg-white border border-gray-200 rounded-xl p-6">
          <div class="w-8 h-8 bg-brand-600 text-white rounded-full flex items-center justify-center font-bold text-sm mb-3">{n}</div>
          <div class="text-2xl mb-2">{icon}</div>
          <h3 class="font-semibold text-gray-900 mb-2">{title}</h3>
          <p class="text-sm text-gray-600">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── TRUST STRIP ─────────────────────────────────────────────────────── -->
  <section class="bg-gray-50 py-10 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-center">
        {[
          ['✅', 'Verified formulas',    'Constants from Quikrete, Scotts, and industry standards — cited on the Data Sources page.'],
          ['🆓', '100% free',           'No signup, no subscription. Every calculator is free forever.'],
          ['💾', 'Remembers your inputs','Your last depth, material type, and price are saved between visits.'],
          ['🖨️', 'Print / save as PDF', 'Every guide page has a print button — take your materials list to the store.'],
        ].map(([icon, title, text]) => (
          <div class="bg-white border border-gray-200 rounded-xl px-4 py-5">
            <div class="text-2xl mb-2">{icon}</div>
            <p class="font-semibold text-gray-900 text-sm mb-1">{title}</p>
            <p class="text-xs text-gray-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ────────────────────────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
    <div class="space-y-3">
      {faqs.map(f => (
        <details class="group border border-gray-200 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 text-sm hover:bg-gray-50 list-none">
            {f.q}
            <span class="text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3">▾</span>
          </summary>
          <div class="px-5 pb-4 text-sm text-gray-700 border-t border-gray-100 pt-3">{f.a}</div>
        </details>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-4 text-sm">
      <a href="/landscaping-calculators" class="text-brand-600 hover:underline">All landscaping →</a>
      <a href="/interior-calculators"    class="text-brand-600 hover:underline">All interior →</a>
      <a href="/concrete-calculators"    class="text-brand-600 hover:underline">All concrete →</a>
      <a href="/methodology"             class="text-brand-600 hover:underline">Methodology →</a>
    </div>
  </section>

</BaseLayout>
