---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = 'https://www.homematerialcalc.com';

const outdoor = [
  { slug: 'mulch',    label: 'Mulch',    icon: '🌿', unit: 'bags / cu yd', example: '10×12 ft bed at 3" = 14 bags' },
  { slug: 'gravel',   label: 'Gravel',   icon: '🪨', unit: 'cu yd / tons',  example: '20×20 ft driveway at 3" = 3.7 cu yd' },
  { slug: 'topsoil',  label: 'Topsoil',  icon: '🌱', unit: 'cu yd / bags',  example: '10×10 ft at 4" = 1.2 cu yd' },
  { slug: 'sand',     label: 'Sand',     icon: '⏳', unit: 'cu yd / bags',  example: '12×12 paver base at 1" = 17 bags' },
  { slug: 'sod',      label: 'Sod',      icon: '🌾', unit: 'pieces / pallets', example: '500 sq ft = 1.1 pallets' },
  { slug: 'paver',    label: 'Pavers',   icon: '🧱', unit: 'pieces + base', example: '10×10 ft = 110 pieces (12×12")' },
];

const concrete = [
  { slug: 'concrete', label: 'Concrete', icon: '🏗️', unit: 'bags / cu yd', example: '10×10 slab at 4" = 56 bags (80 lb)' },
];

const interior = [
  { slug: 'paint',    label: 'Paint',    icon: '🖌️', unit: 'gallons',       example: '12×12 room, 2 coats = 2 gallons' },
  { slug: 'flooring', label: 'Flooring', icon: '🪵', unit: 'boxes',         example: '120 sq ft = 6–7 boxes (20 sq ft/box)' },
  { slug: 'tile',     label: 'Tile',     icon: '⬜', unit: 'tiles + thinset', example: '50 sq ft = 55 tiles (12×12")' },
  { slug: 'drywall',  label: 'Drywall',  icon: '🔲', unit: 'sheets',        example: '12×12 room = 17 sheets (4×8)' },
  { slug: 'lumber',   label: 'Lumber',   icon: '🪚', unit: 'board feet',    example: '20 studs 2×4×8 = 107 board feet' },
];

const guides = [
  { href: '/guide/how-much-mulch-do-i-need',       label: 'How much mulch do I need?',    icon: '🌿' },
  { href: '/guide/how-much-gravel-do-i-need',      label: 'How much gravel do I need?',   icon: '🪨' },
  { href: '/guide/how-much-concrete-do-i-need',    label: 'How much concrete do I need?', icon: '🏗️' },
  { href: '/guide/how-much-paint-do-i-need',       label: 'How much paint do I need?',    icon: '🖌️' },
  { href: '/guide/how-much-topsoil-do-i-need',     label: 'How much topsoil do I need?',  icon: '🌱' },
  { href: '/guide/cubic-yards-to-tons',             label: 'Cubic yards to tons',          icon: '⚖️' },
  { href: '/guide/types-of-mulch',                  label: 'Types of mulch explained',     icon: '🌿' },
  { href: '/guide/gravel-vs-crushed-stone',         label: 'Gravel vs crushed stone',      icon: '🪨' },
  { href: '/guide/how-to-calculate-square-footage', label: 'How to calculate square footage', icon: '📐' },
];

const faqs = [
  { q: 'How do I calculate how much mulch I need?', a: 'Multiply your bed length (ft) × width (ft) × depth (in) ÷ 324 to get cubic yards, then × 13.5 for 2 cu ft bags. The Mulch Calculator does this instantly for any shape.' },
  { q: 'How many bags of concrete for a 10×10 slab?', a: 'At 4 inches thick: 1.23 cubic yards = 56 bags of 80 lb concrete (with 10% waste). The Concrete Calculator covers any size, thickness, and bag weight.' },
  { q: 'How many gallons of paint for a room?', a: 'A 12×12 ft room with 8 ft ceilings needs about 2 gallons for 2 coats. The Paint Calculator subtracts doors and windows and handles multiple coats automatically.' },
  { q: 'How many cubic yards of gravel do I need?', a: 'cu yd = Length (ft) × Width (ft) × Depth (in) ÷ 324. A 20×20 ft area at 3" = 3.7 cu yd. Add 10% for waste. The Gravel Calculator also gives you tons and cost.' },
  { q: 'Are these calculators free?', a: 'Yes — all calculators are completely free with no signup. Every result shows the step-by-step breakdown so you can verify the math yourself.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'HomeMaterialCalc',
  url: siteUrl,
  description: 'Free material calculators for US homeowners — mulch, gravel, concrete, paint, flooring, tile, drywall, lumber and more.',
};
---

<BaseLayout
  title="Material Calculator — Mulch, Gravel, Concrete, Paint & More | Free"
  description="Free material calculators for US homeowners. Calculate mulch, gravel, concrete, paint, flooring, tile & more — get exact bags, cubic yards, or gallons instantly."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  </Fragment>

  <!-- ── HERO ───────────────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 bg-brand-100 text-brand-700 text-xs font-semibold px-3 py-1 rounded-full mb-4">
        12 free calculators · No signup required
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight">
        How Much Material Do You Need?
      </h1>
      <p class="mt-4 text-lg text-gray-600 max-w-xl mx-auto">
        Enter your project dimensions — get the <strong>exact quantity to buy</strong> in bags,
        cubic yards, gallons, or pallets. Built for US homeowners and DIYers.
      </p>

      <!-- Mini result preview -->
      <div class="mt-8 max-w-sm mx-auto bg-white border border-gray-200 rounded-2xl shadow-sm p-4 text-left">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Example — Mulch Calculator</p>
        <div class="space-y-1.5 text-sm text-gray-600 mb-4">
          <div class="flex justify-between"><span>Bed size</span><span class="font-medium text-gray-900">10 × 15 ft</span></div>
          <div class="flex justify-between"><span>Depth</span><span class="font-medium text-gray-900">3 inches</span></div>
        </div>
        <div class="bg-brand-50 rounded-xl p-3 flex items-center justify-between">
          <div>
            <p class="text-xs text-brand-600 font-semibold">You need</p>
            <p class="text-2xl font-black text-brand-800">21 bags</p>
            <p class="text-xs text-brand-600">or 1.6 cubic yards</p>
          </div>
          <a href="/calculator/mulch" class="bg-brand-600 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-brand-700 transition-colors">
            Try it →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── OUTDOOR & LANDSCAPING ──────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 pt-12 pb-4">
    <div class="flex items-baseline gap-3 mb-1">
      <h2 class="text-xl font-bold text-gray-900">🌿 Outdoor & Landscaping</h2>
      <a href="/landscaping-calculators" class="text-xs text-brand-600 hover:underline">All landscaping →</a>
    </div>
    <p class="text-sm text-gray-500 mb-5">Mulch, gravel, topsoil, sand, sod, and pavers — in bags, cubic yards, or tons.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {outdoor.map(({ slug, label, icon, unit, example }) => (
        <a href={`/calculator/${slug}`}
           class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 hover:shadow-sm transition-all group text-center">
          <div class="text-2xl mb-2">{icon}</div>
          <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
          <p class="text-xs text-gray-400 mt-1">{unit}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ── CONCRETE ──────────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 py-4">
    <div class="flex items-baseline gap-3 mb-1">
      <h2 class="text-xl font-bold text-gray-900">🏗️ Concrete</h2>
      <a href="/concrete-calculators" class="text-xs text-brand-600 hover:underline">All concrete →</a>
    </div>
    <p class="text-sm text-gray-500 mb-5">Bag count (40, 60, or 80 lb) for slabs, post holes, and footings.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {concrete.map(({ slug, label, icon, unit }) => (
        <a href={`/calculator/${slug}`}
           class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 hover:shadow-sm transition-all group text-center">
          <div class="text-2xl mb-2">{icon}</div>
          <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
          <p class="text-xs text-gray-400 mt-1">{unit}</p>
        </a>
      ))}
      <!-- Cost companions teaser -->
      <a href="/calculator/concrete-cost"
         class="bg-gray-50 border border-dashed border-gray-300 rounded-xl p-4 hover:border-brand-400 hover:bg-white transition-all group text-center">
        <div class="text-2xl mb-2">💰</div>
        <p class="font-semibold text-gray-600 text-sm group-hover:text-brand-700">Concrete Cost</p>
        <p class="text-xs text-gray-400 mt-1">price estimate</p>
      </a>
    </div>
  </section>

  <!-- ── INTERIOR ──────────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 pt-4 pb-12">
    <div class="flex items-baseline gap-3 mb-1">
      <h2 class="text-xl font-bold text-gray-900">🏠 Interior & Construction</h2>
      <a href="/interior-calculators" class="text-xs text-brand-600 hover:underline">All interior →</a>
    </div>
    <p class="text-sm text-gray-500 mb-5">Paint gallons, flooring boxes, tile count, drywall sheets, and lumber board feet.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {interior.map(({ slug, label, icon, unit }) => (
        <a href={`/calculator/${slug}`}
           class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 hover:shadow-sm transition-all group text-center">
          <div class="text-2xl mb-2">{icon}</div>
          <p class="font-semibold text-gray-900 text-sm group-hover:text-brand-700">{label}</p>
          <p class="text-xs text-gray-400 mt-1">{unit}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────────────── -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">How it works — 3 steps</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {[
          { n: '1', icon: '📏', title: 'Enter your dimensions', text: 'Length, width — and depth for bulk materials. Works for rectangles, circles, or irregular shapes.' },
          { n: '2', icon: '⚙️', title: 'We do the math', text: 'Each calculator uses verified material constants — bag yields, densities, coverage rates — automatically.' },
          { n: '3', icon: '🛒', title: 'Get your shopping list', text: 'See the exact quantity in the unit you buy: bags, cubic yards, gallons, boxes, or pallets. Add your price for cost.' },
        ].map(({ n, icon, title, text }) => (
          <div class="bg-white border border-gray-200 rounded-xl p-6">
            <div class="w-8 h-8 bg-brand-600 text-white rounded-full flex items-center justify-center font-bold text-sm mb-3">{n}</div>
            <div class="text-2xl mb-2">{icon}</div>
            <h3 class="font-semibold text-gray-900 mb-2">{title}</h3>
            <p class="text-sm text-gray-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TRUST STRIP ───────────────────────────────────────────────────── -->
  <section class="max-w-4xl mx-auto px-4 py-10">
    <div class="grid sm:grid-cols-3 gap-4 text-center">
      {[
        ['✅', 'Verified formulas', 'Constants from Quikrete, Scotts, industry standards — cited on the Data Sources page.'],
        ['🆓', '100% free', 'No signup, no subscription. Every calculator is free forever.'],
        ['📋', 'Step-by-step math', 'Every result shows the breakdown so you can check the calculation yourself.'],
      ].map(([icon, title, text]) => (
        <div class="bg-brand-50 rounded-xl px-5 py-6">
          <div class="text-2xl mb-2">{icon}</div>
          <p class="font-semibold text-gray-900 text-sm mb-1">{title}</p>
          <p class="text-xs text-gray-600">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── GUIDES ────────────────────────────────────────────────────────── -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Material Guides & Reference</h2>
      <p class="text-sm text-gray-500 mb-6">Answers to the most common home project material questions.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {guides.map(({ href, label, icon }) => (
          <a href={href}
             class="flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-700 hover:border-brand-400 hover:text-brand-700 transition-colors">
            <span class="text-lg flex-shrink-0">{icon}</span>
            <span>{label}</span>
          </a>
        ))}
      </div>
      <div class="mt-5 flex flex-wrap gap-4 text-sm">
        <a href="/landscaping-calculators" class="text-brand-600 hover:underline">All landscaping guides →</a>
        <a href="/interior-calculators"    class="text-brand-600 hover:underline">All interior guides →</a>
        <a href="/concrete-calculators"    class="text-brand-600 hover:underline">All concrete guides →</a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
    <div class="space-y-3">
      {faqs.map(f => (
        <details class="group border border-gray-200 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 text-sm hover:bg-gray-50 list-none">
            {f.q}
            <span class="text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-3">▾</span>
          </summary>
          <div class="px-5 pb-4 text-sm text-gray-700 border-t border-gray-100 pt-3">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
