---
import BaseLayout from '../layouts/BaseLayout.astro';

const calculators = [
  { slug: 'mulch',    label: 'Mulch',         icon: '🌿', desc: 'Cubic yards, bags, depth' },
  { slug: 'gravel',   label: 'Gravel & Stone', icon: '🪨', desc: 'Cubic yards, tons, stone type' },
  { slug: 'topsoil',  label: 'Topsoil',        icon: '🌱', desc: 'Cubic yards, 40 lb bags' },
  { slug: 'sand',     label: 'Sand',           icon: '⏳', desc: 'Cubic yards, tons, 50 lb bags' },
  { slug: 'sod',      label: 'Sod',            icon: '🌾', desc: 'Sq ft, pieces, pallets' },
  { slug: 'concrete', label: 'Concrete',       icon: '🏗️', desc: 'Bag count by size, slabs & post holes' },
];
---

<BaseLayout
  title="Home Material Calculator — How Much Do I Need?"
  description="Free material estimators for US homeowners. Calculate mulch, gravel, topsoil, sand, sod, and concrete in real purchasable units — bags, cubic yards, tons, and pallets."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight">
        How Much Material Do You Need?
      </h1>
      <p class="mt-4 text-lg text-gray-600 max-w-xl mx-auto">
        Enter your project dimensions and get an instant estimate in real purchasable units —
        bags, cubic yards, tons, or pallets. No guessing, no waste.
      </p>
    </div>
  </section>

  <!-- Calculator grid -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Material Calculators</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {calculators.map(({ slug, label, icon, desc }) => (
        <a
          href={`/calculator/${slug}`}
          class="calculator-card hover:border-brand-400 hover:shadow-md transition-all group"
        >
          <div class="text-3xl mb-3">{icon}</div>
          <h3 class="font-semibold text-gray-900 text-lg group-hover:text-brand-700 transition-colors">
            {label} Calculator
          </h3>
          <p class="text-sm text-gray-500 mt-1">{desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">How It Works</h2>
      <ol class="space-y-4">
        {[
          ['Measure your area', 'Enter the length and width of your project in feet, or use the circle/irregular shape options.'],
          ['Pick your material & depth', 'Select the material type and depth (for bulk materials like mulch or gravel).'],
          ['Get your quantity', 'The calculator instantly shows how many bags, cubic yards, tons, or pallets to buy — with an optional cost estimate.'],
        ].map(([step, detail], i) => (
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 bg-brand-600 text-white rounded-full flex items-center justify-center font-bold text-sm">
              {i + 1}
            </span>
            <div>
              <p class="font-semibold text-gray-900">{step}</p>
              <p class="text-sm text-gray-600 mt-0.5">{detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
