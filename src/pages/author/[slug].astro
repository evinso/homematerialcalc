---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { authors, getAuthor } from '../../data/authors';
import { getPublishedPages } from '../../lib/publishing';

export function getStaticPaths() {
  return Object.keys(authors).map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const author = getAuthor(slug);

const site = 'https://www.homematerialcalc.com';
const canonical = `${site}/author/${slug}/`;

// Find published guides written by this author
// We approximate by expertise — guides mentioning the author's topic area
const allPublished = getPublishedPages().filter(p => p.type === 'guide' || p.type === 'reference');

// Person structured data
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  jobTitle: author.title,
  description: author.bio,
  email: author.email,
  url: canonical,
  worksFor: {
    '@type': 'Organization',
    name: 'HomeMaterialCalc',
    url: site,
  },
  knowsAbout: author.expertise,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Authors', item: site + '/author/' },
    { '@type': 'ListItem', position: 3, name: author.name, item: canonical },
  ],
};

const slugMap: Record<string, string> = {
  'Concrete': '/calculator/concrete',
  'Framing': '/calculator/lumber',
  'Decks': '/calculator/deck',
  'Fences': '/calculator/fence',
  'Asphalt': '/calculator/asphalt',
  'Pavers': '/calculator/paver',
  'Lumber': '/calculator/lumber',
  'Mulch': '/calculator/mulch',
  'Gravel': '/calculator/gravel',
  'Topsoil': '/calculator/topsoil',
  'Sand': '/calculator/sand',
  'Sod': '/calculator/sod',
  'Grass Seed': '/calculator/grass-seed',
  'Flooring': '/calculator/flooring',
  'Tile': '/calculator/tile',
  'Drywall': '/calculator/drywall',
  'Paint': '/calculator/paint',
  'Insulation': '/calculator/insulation',
};

const SKIP_TOPICS = new Set(['Material Calculators', 'Home Improvement', 'DIY Projects', 'Landscaping']);
const calculatorLinks = author.expertise
  .filter(e => !SKIP_TOPICS.has(e) && slugMap[e])
  .map(e => ({ topic: e, href: slugMap[e] }));
---

<BaseLayout
  title={`${author.name} — ${author.title} | HomeMaterialCalc`}
  description={`${author.name} is a ${author.title} at HomeMaterialCalc. ${author.credentials}. ${author.bio.slice(0, 120)}…`}
  canonicalUrl={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 py-12">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-8 flex gap-1">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>›</span>
      <span class="text-gray-700">Authors</span>
      <span>›</span>
      <span class="text-gray-700">{author.name}</span>
    </nav>

    <!-- Author header -->
    <div class="flex items-start gap-6 mb-10">
      <div
        class="w-20 h-20 rounded-full flex items-center justify-center text-2xl font-bold text-white flex-shrink-0"
        style={`background-color: ${author.color}`}
        aria-hidden="true"
      >
        {author.avatar}
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900 mb-1">{author.name}</h1>
        <p class="text-brand-700 font-medium mb-1">{author.title}</p>
        <p class="text-sm text-gray-500 mb-3">{author.credentials}</p>
        <a
          href={`mailto:${author.email}`}
          class="inline-flex items-center gap-1.5 text-sm text-brand-600 hover:text-brand-800 hover:underline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {author.email}
        </a>
      </div>
    </div>

    <!-- Bio -->
    <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 mb-10">
      <h2 class="text-base font-semibold text-gray-900 mb-3">About {author.name.split(' ')[0]}</h2>
      <p class="text-gray-700 leading-relaxed">{author.bio}</p>
    </div>

    <!-- Expertise -->
    <div class="mb-10">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Areas of Expertise</h2>
      <div class="flex flex-wrap gap-2">
        {author.expertise.map(topic => (
          <span class="px-3 py-1.5 bg-brand-50 text-brand-700 text-sm rounded-full border border-brand-200 font-medium">
            {topic}
          </span>
        ))}
      </div>
    </div>

    <!-- Calculators by expertise -->
    <div class="mb-10">
      <h2 class="text-base font-semibold text-gray-900 mb-4">Related Calculators</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {calculatorLinks.map(({ topic, href }) => (
          <a href={href} class="flex items-center gap-2 p-3 bg-white border border-gray-200 rounded-lg hover:border-brand-400 hover:text-brand-700 transition-colors text-sm font-medium text-gray-700">
            <span>🧮</span> {topic} Calculator
          </a>
        ))}
      </div>
    </div>

    <!-- About HomeMaterialCalc -->
    <div class="border-t border-gray-100 pt-8 text-sm text-gray-500">
      <p>
        {author.name.split(' ')[0]} contributes to <a href="/" class="text-brand-600 hover:underline">HomeMaterialCalc.com</a> — a free resource helping US homeowners calculate materials for landscaping, construction, and interior projects.
        All guides are fact-checked and reviewed by licensed tradespeople.
      </p>
    </div>

  </div>
</BaseLayout>
